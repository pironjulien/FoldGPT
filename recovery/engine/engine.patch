+use super::*;
+use codex_exec_server::ExecBackend;
+use codex_exec_server::ExecOutputStream;
+use codex_exec_server::ExecParams;
+use codex_exec_server::ExecProcess;
+use codex_exec_server::ExecProcessEvent;
+use codex_exec_server::WriteStatus;
+use tokio::sync::broadcast;
+
+pub(crate) struct StartExecutorCommandParams {
+    pub(crate) outgoing: Arc<OutgoingMessageSender>,
+    pub(crate) request_id: ConnectionRequestId,
+    pub(crate) process_id: Option<String>,
+    pub(crate) backend: Arc<dyn ExecBackend>,
+    pub(crate) exec_params: ExecParams,
+    pub(crate) expiration: ExecExpiration,
+    pub(crate) started_network_proxy: Option<StartedNetworkProxy>,
+    pub(crate) stream_stdin: bool,
+    pub(crate) stream_stdout_stderr: bool,
+    pub(crate) output_bytes_cap: Option<usize>,
+    pub(crate) size: Option<TerminalSize>,
+}
+
+impl CommandExecManager {
+    pub(crate) async fn start_on_executor(
+        &self,
+        params: StartExecutorCommandParams,
+    ) -> Result<(), JSONRPCErrorError> {
+        if params.process_id.is_none()
+            && (params.exec_params.tty || params.stream_stdin || params.stream_stdout_stderr)
+        {
+            return Err(invalid_request(
+                "command/exec tty or streaming requires a client-supplied processId",
+            ));
+        }
+        if params.size.is_some() {
+            return Err(invalid_request(
+                "the selected executor does not support command/exec terminal size",
+            ));
+        }
+        let process_key = ConnectionProcessId {
+            connection_id: params.request_id.connection_id,
+            process_id: params.process_id.clone().map_or_else(
+                || {
+                    InternalProcessId::Generated(
+                        self.next_generated_process_id
+                            .fetch_add(1, Ordering::Relaxed),
+                    )
+                },
+                InternalProcessId::Client,
+            ),
+        };
+        let (control_tx, control_rx) = mpsc::channel(32);
+        {
+            let mut sessions = self.sessions.lock().await;
+            if sessions.contains_key(&process_key) {
+                return Err(invalid_request(format!(
+                    "duplicate active command/exec process id: {}",
+                    process_key.process_id.error_repr(),
+                )));
+            }
+            sessions.insert(
+                process_key.clone(),
+                CommandExecSession::Active { control_tx },
+            );
+        }
+        let sessions = Arc::clone(&self.sessions);
+        // The task owns startup even if the request or connection disappears. Dropping
+        // a backend start future could otherwise abandon an already-created process.
+        tokio::spawn(async move {
+            let outgoing = Arc::clone(&params.outgoing);
+            let request_id = params.request_id.clone();
+            let result = run_executor_command(params, control_rx).await;
+            sessions.lock().await.remove(&process_key);
+            match result {
+                Ok(response) => outgoing.send_response(request_id, response).await,
+                Err(error) => outgoing.send_error(request_id, error).await,
+            }
+        });
+        Ok(())
+    }
+}
+
+async fn run_executor_command(
+    params: StartExecutorCommandParams,
+    mut control_rx: mpsc::Receiver<CommandControlRequest>,
+) -> Result<CommandExecResponse, JSONRPCErrorError> {
+    let StartExecutorCommandParams {
+        outgoing,
+        request_id,
+        process_id,
+        backend,
+        exec_params,
+        expiration,
+        started_network_proxy: _started_network_proxy,
+        stream_stdin,
+        stream_stdout_stderr,
+        output_bytes_cap,
+        size: _,
+    } = params;
+    let expiration = expiration.wait_with_outcome();
+    tokio::pin!(expiration);
+    let start = backend.start(exec_params);
+    tokio::pin!(start);
+    let mut expiration_outcome = None;
+    let mut startup_termination = None;
+    let mut terminate_after_start = false;
+    let started = loop {
+        tokio::select! {
+            started = &mut start => break started,
+            outcome = &mut expiration => {
+                expiration_outcome = Some(outcome);
+                terminate_after_start = true;
+                break start.await;
+            }
+            control = control_rx.recv() => {
+                match control {
+                    Some(CommandControlRequest { control: CommandControl::Terminate, response_tx }) => {
+                        startup_termination = response_tx;
+                        terminate_after_start = true;
+                        break start.await;
+                    }
+                    Some(CommandControlRequest { response_tx, .. }) => {
+                        if let Some(response_tx) = response_tx {
+                            let _ = response_tx.send(Err(invalid_request("command/exec process is starting")));
+                        }
+                    }
+                    None => {
+                        terminate_after_start = true;
+                        break start.await;
+                    }
+                }
+            }
+        }
+    };
+    let process = match started {
+        Ok(started) => started.process,
+        Err(error) => {
+            let error = internal_error(format!(
+                "selected executor failed to start command: {error}"
+            ));
+            if let Some(response_tx) = startup_termination {
+                let _ = response_tx.send(Err(error.clone()));
+            }
+            return Err(error);
+        }
+    };
+    let mut events = process.subscribe_events();
+    if terminate_after_start {
+        let result = process
+            .terminate()
+            .await
+            .map_err(|error| internal_error(format!("executor termination failed: {error}")));
+        if let Some(response_tx) = startup_termination {
+            let _ = response_tx.send(result.clone());
+        }
+        result?;
+    }
+    let mut stdout = ExecutorOutput::default();
+    let mut stderr = ExecutorOutput::default();
+    let mut exit_code = None;
+    let mut last_seq = 0;
+    let mut control_open = true;
+    // A cleanup failure may be available through process/read without a Closed
+    // event. Poll status independently while consuming the lossless event stream.
+    let mut status_interval = tokio::time::interval(Duration::from_secs(1));
+    status_interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    let result = loop {
+        tokio::select! {
+            event = events.recv() => {
+                match event {
+                    Ok(ExecProcessEvent::Failed(error)) => break Err(internal_error(format!("executor process failed: {error}"))),
+                    Ok(event) => {
+                        let seq = match &event {
+                            ExecProcessEvent::Output(chunk) => chunk.seq,
+                            ExecProcessEvent::Exited { seq, .. } | ExecProcessEvent::Closed { seq } => *seq,
+                            ExecProcessEvent::Failed(_) => unreachable!(),
+                        };
+                        if seq <= last_seq {
+                            continue;
+                        }
+                        if seq != last_seq + 1 {
+                            break Err(internal_error("executor command output history is incomplete"));
+                        }
+                        last_seq = seq;
+                        match event {
+                            ExecProcessEvent::Output(chunk) => {
+                                let (output, stream) = match chunk.stream {
+                                    ExecOutputStream::Stdout | ExecOutputStream::Pty => (&mut stdout, CommandExecOutputStream::Stdout),
+                                    ExecOutputStream::Stderr => (&mut stderr, CommandExecOutputStream::Stderr),
+                                };
+                                if let Some((chunk, cap_reached)) = output.accept(&chunk.chunk.0, output_bytes_cap, stream_stdout_stderr)
+                                    && let Some(process_id) = &process_id
+                                {
+                                    outgoing.send_server_notification_to_connection_and_wait(
+                                        request_id.connection_id,
+                                        ServerNotification::CommandExecOutputDelta(CommandExecOutputDeltaNotification {
+                                            process_id: process_id.clone(), stream,
+                                            delta_base64: STANDARD.encode(chunk), cap_reached,
+                                        }),
+                                    ).await;
+                                }
+                            }
+                            ExecProcessEvent::Exited { exit_code: code, .. } => exit_code = Some(code),
+                            ExecProcessEvent::Closed { .. } => {
+                                break executor_status(process.as_ref()).await.and_then(|status| {
+                                    if !status.closed || !status.exited || status.exit_code != exit_code {
+                                        return Err(internal_error("executor cleanup and exit status are not confirmed"));
+                                    }
+                                    exit_code.ok_or_else(|| internal_error("executor closed without reporting an exit status"))
+                                });
+                            }
+                            ExecProcessEvent::Failed(_) => unreachable!(),
+                        }
+                    }
+                    Err(broadcast::error::RecvError::Lagged(_)) => break Err(internal_error("executor command output history is incomplete")),
+                    Err(broadcast::error::RecvError::Closed) => break Err(internal_error("executor command event stream closed before process cleanup")),
+                }
+            }
+            control = control_rx.recv(), if control_open => {
+                match control {
+                    Some(CommandControlRequest { control, response_tx }) => {
+                        let result = executor_control(process.as_ref(), control, stream_stdin).await;
+                        if let Some(response_tx) = response_tx {
+                            let _ = response_tx.send(result);
+                        } else if let Err(error) = result {
+                            break Err(error);
+                        }
+                    }
+                    None => {
+                        control_open = false;
+                        if let Err(error) = executor_control(process.as_ref(), CommandControl::Terminate, stream_stdin).await {
+                            break Err(error);
+                        }
+                    }
+                }
+            }
+            outcome = &mut expiration, if expiration_outcome.is_none() => {
+                expiration_outcome = Some(outcome);
+                if let Err(error) = executor_control(process.as_ref(), CommandControl::Terminate, stream_stdin).await {
+                    break Err(error);
+                }
+            }
+            _ = status_interval.tick() => {
+                if let Err(error) = executor_status(process.as_ref()).await {
+                    break Err(error);
+                }
+            }
+        }
+    };
+    let exit_code = match result {
+        Ok(code) => code,
+        Err(mut error) => {
+            if let Err(cleanup) = process.terminate().await {
+                error.message.push_str(&format!(
+                    "; executor cleanup could not be requested: {cleanup}"
+                ));
+            }
+            return Err(error);
+        }
+    };
+    Ok(CommandExecResponse {
+        exit_code: if expiration_outcome == Some(ExecExpirationOutcome::TimedOut) {
+            EXEC_TIMEOUT_EXIT_CODE
+        } else {
+            exit_code
+        },
+        stdout: bytes_to_string_smart(&stdout.buffer),
+        stderr: bytes_to_string_smart(&stderr.buffer),
+    })
+}
+
+async fn executor_status(
+    process: &dyn ExecProcess,
+) -> Result<codex_exec_server::ReadResponse, JSONRPCErrorError> {
+    let status = process
+        .read(Some(u64::MAX), Some(0), Some(0))
+        .await
+        .map_err(|error| internal_error(format!("executor process status failed: {error}")))?;
+    match &status.failure {
+        Some(error) => Err(internal_error(format!("executor process failed: {error}"))),
+        None => Ok(status),
+    }
+}
+
+async fn executor_control(
+    process: &dyn ExecProcess,
+    control: CommandControl,
+    stream_stdin: bool,
+) -> Result<(), JSONRPCErrorError> {
+    match control {
+        CommandControl::Terminate => process
+            .terminate()
+            .await
+            .map_err(|error| internal_error(format!("executor termination failed: {error}"))),
+        CommandControl::Resize { .. } => Err(invalid_request(
+            "the selected executor does not support command/exec/resize",
+        )),
+        CommandControl::Write { delta, close_stdin } => {
+            if !stream_stdin {
+                return Err(invalid_request(
+                    "stdin streaming is not enabled for this command/exec",
+                ));
+            }
+            if close_stdin {
+                return Err(invalid_request(
+                    "the selected executor does not support command/exec closeStdin",
+                ));
+            }
+            match process
+                .write(delta)
+                .await
+                .map_err(|error| internal_error(format!("executor stdin write failed: {error}")))?
+                .status
+            {
+                WriteStatus::Accepted => Ok(()),
+                WriteStatus::UnknownProcess => {
+                    Err(invalid_request("executor command no longer exists"))
+                }
+                WriteStatus::StdinClosed => Err(invalid_request("stdin is already closed")),
+                WriteStatus::Starting => Err(invalid_request("executor command is starting")),
+            }
+        }
+    }
+}
+
+#[derive(Default)]
+struct ExecutorOutput {
+    buffer: Vec<u8>,
+    observed: usize,
+    cap_reported: bool,
+}
+
+impl ExecutorOutput {
+    fn accept<'a>(
+        &mut self,
+        chunk: &'a [u8],
+        cap: Option<usize>,
+        stream: bool,
+    ) -> Option<(&'a [u8], bool)> {
+        let remaining = cap.map_or(chunk.len(), |cap| {
+            cap.saturating_sub(self.observed).min(chunk.len())
+        });
+        self.observed = self.observed.saturating_add(remaining);
+        let capped = &chunk[..remaining];
+        let cap_reached = cap == Some(self.observed);
+        if !stream {
+            self.buffer.extend_from_slice(capped);
+            return None;
+        }
+        if self.cap_reported {
+            return None;
+        }
+        self.cap_reported = cap_reached;
+        Some((capped, cap_reached))
+    }
+}
