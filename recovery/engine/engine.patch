+                filesystem.request(operation, &path, /*follow_symlinks*/ None),
+                async {
+                    server.receive(MAX_PACKET_BYTES).await?;
+                    server.send(&serde_json::to_vec(&frame)?).await
+                }
+            )
+        })
+        .await;
+        sent?;
+        assert_eq!(
+            result.err().unwrap().kind(),
+            io::ErrorKind::InvalidData,
+            "{frame:?}"
+        );
+        assert_closed(&filesystem, &server).await;
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn validated_authority_errors_preserve_kind_message_and_allow_next_request() -> io::Result<()>
+{
+    let (filesystem, server) = connected().await?;
+    let path = "file:///scope/file".parse().unwrap();
+    for (index, (code, kind)) in [
+        (-32004, io::ErrorKind::NotFound),
+        (-32000, io::ErrorKind::PermissionDenied),
+        (-32600, io::ErrorKind::PermissionDenied),
+        (-32603, io::ErrorKind::Other),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let (result, sent) = deadline(async {
+            tokio::join!(filesystem.bytes(&path), async {
+                let request: Value = serde_json::from_slice(&server.receive(MAX_PACKET_BYTES).await?)?;
+                assert_eq!(request, json!({"id":index + 1,"op":"readFile","path":path}));
+                server.send(&serde_json::to_vec(&json!({"type":"error","id":index + 1,"error":{"code":code,"message":"authority refusal"}}))?).await
+            })
+        }).await;
+        sent?;
+        let error = result.unwrap_err();
+        assert_eq!(
+            (error.kind(), error.to_string()),
