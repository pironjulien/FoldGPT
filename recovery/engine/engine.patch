new file mode 100644
index 0000000000000000000000000000000000000000..36577fa67c5f30b541ff025a2a43ce2511061eb7
--- /dev/null
+++ b/codex-rs/git-utils/src/trust_filesystem.rs
@@ -0,0 +1,118 @@
+use codex_file_system::ExecutorFileSystem;
+use codex_file_system::FileMetadata;
+use codex_file_system::FileSystemSandboxContext;
+use codex_file_system::FindUpErrorPolicy;
+use codex_file_system::GetMetadataOptions;
+use codex_file_system::ReadFileOptions;
+use codex_file_system::find_nearest_native_ancestor_with_markers;
+use codex_file_system::find_nearest_native_ancestor_with_markers_within;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+use std::io;
+
+#[derive(Clone, Copy)]
+pub(super) enum TrustFileSystem<'a> {
+    Unbounded(&'a dyn ExecutorFileSystem),
+    Within {
+        provider: &'a dyn ExecutorFileSystem,
+        discovery_root: &'a AbsolutePathBuf,
+    },
+}
+
+impl<'a> TrustFileSystem<'a> {
+    fn provider(self) -> &'a dyn ExecutorFileSystem {
+        match self {
+            Self::Unbounded(provider) | Self::Within { provider, .. } => provider,
+        }
+    }
+
+    pub(super) fn check_path(self, path: &PathUri) -> io::Result<()> {
+        if let Self::Within { discovery_root, .. } = self
+            && !path
+                .to_abs_path()?
+                .as_path()
+                .starts_with(discovery_root.as_path())
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                format!("Git trust metadata path is outside discovery root: {path}"),
+            ));
+        }
+        Ok(())
+    }
+
+    pub(super) fn parent(self, path: &AbsolutePathBuf) -> Option<AbsolutePathBuf> {
+        if let Self::Within { discovery_root, .. } = self
+            && path == discovery_root
+        {
+            return None;
+        }
+        path.parent()
+    }
+
+    pub(super) async fn find_git_root(
+        self,
+        start: &AbsolutePathBuf,
+        error_policy: FindUpErrorPolicy,
+    ) -> io::Result<Option<AbsolutePathBuf>> {
+        match self {
+            Self::Unbounded(provider) => {
+                find_nearest_native_ancestor_with_markers(
+                    provider,
+                    start,
+                    vec![".git".to_string()],
+                    error_policy,
+                    /*sandbox*/ None,
+                )
+                .await
+            }
+            Self::Within {
+                provider,
+                discovery_root,
+            } => {
+                find_nearest_native_ancestor_with_markers_within(
+                    provider,
+                    start,
+                    discovery_root,
+                    vec![".git".to_string()],
+                    /*sandbox*/ None,
+                )
+                .await
+            }
+        }
+    }
+
+    pub(super) async fn get_metadata(
+        self,
+        path: &PathUri,
+        options: GetMetadataOptions,
+        sandbox: Option<&FileSystemSandboxContext>,
+    ) -> io::Result<FileMetadata> {
+        self.check_path(path)?;
+        self.provider().get_metadata(path, options, sandbox).await
+    }
+
+    pub(super) async fn read_file(
+        self,
+        path: &PathUri,
+        options: ReadFileOptions,
+        sandbox: Option<&FileSystemSandboxContext>,
+    ) -> io::Result<Vec<u8>> {
+        self.check_path(path)?;
+        self.provider().read_file(path, options, sandbox).await
+    }
+
+    pub(super) async fn canonicalize(
+        self,
+        path: &PathUri,
+        sandbox: Option<&FileSystemSandboxContext>,
+    ) -> io::Result<PathUri> {
+        self.check_path(path)?;
+        let canonical = self.provider().canonicalize(path, sandbox).await?;
+        // A resolved alias outside the boundary must not become a new metadata
+        // target. The provider remains responsible for enforcing the resolution
+        // itself under its filesystem authority.
+        self.check_path(&canonical)?;
+        Ok(canonical)
+    }
+}
