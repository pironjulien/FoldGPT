+++ b/codex-rs/exec-server/src/runtime_acquisition_socket.rs
@@ -0,0 +1,243 @@
+//! Descriptor transfer from the native session owner, before any model RPC.
+
+use std::io;
+use std::mem;
+use std::os::fd::AsRawFd;
+use std::os::fd::FromRawFd;
+use std::os::fd::OwnedFd;
+use std::os::unix::ffi::OsStrExt;
+use std::path::Path;
+
+use tokio::io::Interest;
+use tokio::io::unix::AsyncFd;
+
+use crate::BootstrapPeer;
+
+pub(super) struct AcquisitionSocket {
+    socket: AsyncFd<OwnedFd>,
+    peer: BootstrapPeer,
+}
+
+impl AcquisitionSocket {
+    pub(super) fn connect(path: &Path, peer: BootstrapPeer) -> io::Result<Self> {
+        let path = path.as_os_str().as_bytes();
+        let mut address: libc::sockaddr_un = unsafe { mem::zeroed() };
+        if path.is_empty()
+            || path.len() >= address.sun_path.len()
+            || path.contains(&0)
+            || peer.pid == 0
+            || peer.pid > i32::MAX as u32
+        {
+            return Err(invalid("invalid native rendezvous address or peer"));
+        }
+        // SAFETY: socket returns a fresh descriptor or a negative error.
+        let descriptor = checked(unsafe {
+            libc::socket(
+                libc::AF_UNIX,
+                libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC | libc::SOCK_NONBLOCK,
+                0,
+            )
+        })?;
+        let descriptor = unsafe { OwnedFd::from_raw_fd(descriptor) };
+        let enabled: libc::c_int = 1;
+        // SAFETY: descriptor is owned and enabled is a correctly sized socket option.
+        checked(unsafe {
+            libc::setsockopt(
+                descriptor.as_raw_fd(),
+                libc::SOL_SOCKET,
+                libc::SO_PASSCRED,
+                (&raw const enabled).cast(),
+                mem::size_of_val(&enabled) as libc::socklen_t,
+            )
+        })?;
+        address.sun_family = libc::AF_UNIX as libc::sa_family_t;
+        for (target, byte) in address.sun_path.iter_mut().zip(path) {
+            *target = *byte as libc::c_char;
+        }
+        let length =
+            (mem::offset_of!(libc::sockaddr_un, sun_path) + path.len() + 1) as libc::socklen_t;
+        // AF_UNIX nonblocking connect either completes immediately or fails admission;
+        // a full listen queue must not create an implicit connection retry.
+        checked(unsafe {
+            libc::connect(descriptor.as_raw_fd(), (&raw const address).cast(), length)
+        })?;
+        verify_peer(&descriptor, peer, libc::SOCK_SEQPACKET)?;
+        Ok(Self {
+            socket: AsyncFd::new(descriptor)?,
+            peer,
+        })
+    }
+
+    pub(super) async fn send(&self, bytes: &[u8]) -> io::Result<()> {
+        self.socket
+            .async_io(Interest::WRITABLE, |descriptor| {
+                // Receiver enabled SO_PASSCRED before admission; kernel supplies actual credentials.
+                let count = unsafe {
+                    libc::send(
+                        descriptor.as_raw_fd(),
+                        bytes.as_ptr().cast(),
+                        bytes.len(),
+                        libc::MSG_NOSIGNAL,
+                    )
+                };
+                if count < 0 {
+                    return Err(io::Error::last_os_error());
+                }
+                if count as usize != bytes.len() {
+                    return Err(invalid("partial native acquisition packet"));
+                }
+                Ok(())
+            })
+            .await
+    }
+
+    pub(super) async fn receive(&self) -> io::Result<(Vec<u8>, Vec<OwnedFd>)> {
+        self.socket
+            .async_io(Interest::READABLE, |descriptor| {
+                receive(descriptor.as_raw_fd(), self.peer)
+            })
+            .await
+    }
+
+    pub(super) fn shutdown(&self) {
+        // SAFETY: this does not close or transfer the owned descriptor.
+        unsafe {
+            libc::shutdown(self.socket.get_ref().as_raw_fd(), libc::SHUT_RDWR);
+        }
+    }
+}
+
+pub(super) fn verify_peer(
+    descriptor: &OwnedFd,
+    peer: BootstrapPeer,
+    kind: libc::c_int,
+) -> io::Result<()> {
+    let fd = descriptor.as_raw_fd();
+    let mut credentials: libc::ucred = unsafe { mem::zeroed() };
+    let mut size = mem::size_of_val(&credentials) as libc::socklen_t;
+    checked(unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            (&raw mut credentials).cast(),
+            &raw mut size,
+        )
+    })?;
+    if size as usize != mem::size_of_val(&credentials)
+        || credentials.pid as u32 != peer.pid
+        || credentials.uid != peer.uid
+        || credentials.gid != peer.gid
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "native socket peer differs from its lifecycle owner",
+        ));
+    }
+    for (option, expected) in [(libc::SO_DOMAIN, libc::AF_UNIX), (libc::SO_TYPE, kind)] {
+        let mut value: libc::c_int = 0;
+        let mut length = mem::size_of_val(&value) as libc::socklen_t;
+        checked(unsafe {
+            libc::getsockopt(
+                fd,
+                libc::SOL_SOCKET,
+                option,
+                (&raw mut value).cast(),
+                &raw mut length,
+            )
+        })?;
+        if length as usize != mem::size_of_val(&value) || value != expected {
+            return Err(invalid("native descriptor has an unexpected socket type"));
+        }
+    }
+    Ok(())
+}
+
+fn receive(fd: libc::c_int, peer: BootstrapPeer) -> io::Result<(Vec<u8>, Vec<OwnedFd>)> {
+    let mut data = vec![0_u8; 4096];
+    // Aligned, bounded ancillary storage; all received rights are owned immediately.
+    let mut control = [0_usize; 64];
+    let mut vector = libc::iovec {
+        iov_base: data.as_mut_ptr().cast(),
+        iov_len: data.len(),
+    };
+    let mut message: libc::msghdr = unsafe { mem::zeroed() };
+    message.msg_iov = &raw mut vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.as_mut_ptr().cast();
+    message.msg_controllen = mem::size_of_val(&control);
+    let count = unsafe { libc::recvmsg(fd, &raw mut message, libc::MSG_CMSG_CLOEXEC) };
+    if count < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut descriptors = Vec::new();
+    let mut actual = None;
+    let mut rights_records = 0;
+    let mut rejected = false;
+    // SAFETY: the kernel initialized the bounded ancillary buffer; each received
+    // descriptor is transferred into one OwnedFd, including those later rejected.
+    unsafe {
+        let mut header = libc::CMSG_FIRSTHDR(&raw const message);
+        while !header.is_null() {
+            let length = (*header)
+                .cmsg_len
+                .saturating_sub(libc::CMSG_LEN(0) as usize);
+            if (*header).cmsg_level == libc::SOL_SOCKET && (*header).cmsg_type == libc::SCM_RIGHTS {
+                rights_records += 1;
+                rejected |= length % mem::size_of::<libc::c_int>() != 0 || rights_records > 1;
+                for index in 0..length / mem::size_of::<libc::c_int>() {
+                    let received = libc::CMSG_DATA(header)
+                        .cast::<libc::c_int>()
+                        .add(index)
+                        .read_unaligned();
+                    descriptors.push(OwnedFd::from_raw_fd(received));
+                }
+            } else if (*header).cmsg_level == libc::SOL_SOCKET
+                && (*header).cmsg_type == libc::SCM_CREDENTIALS
+                && length == mem::size_of::<libc::ucred>()
+                && actual.is_none()
+            {
+                let credentials = libc::CMSG_DATA(header)
+                    .cast::<libc::ucred>()
+                    .read_unaligned();
+                actual = Some(BootstrapPeer {
+                    pid: credentials.pid as u32,
+                    uid: credentials.uid,
+                    gid: credentials.gid,
+                });
+            } else {
+                rejected = true;
+            }
+            header = libc::CMSG_NXTHDR(&raw const message, header);
+        }
+    }
+    if count == 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::UnexpectedEof,
+            "native acquisition owner disconnected",
+        ));
+    }
+    if rejected
+        || actual != Some(peer)
+        || message.msg_flags & (libc::MSG_TRUNC | libc::MSG_CTRUNC) != 0
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "native acquisition credentials or ancillary data rejected",
+        ));
+    }
+    data.truncate(count as usize);
+    Ok((data, descriptors))
+}
+
+fn checked(value: libc::c_int) -> io::Result<libc::c_int> {
+    if value < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(value)
+    }
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
diff --git a/codex-rs/exec-server/src/runtime_startup.rs b/codex-rs/exec-server/src/runtime_startup.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fcb80707f7890a8238f4da12a4d656b2f385e2c7
--- /dev/null
+++ b/codex-rs/exec-server/src/runtime_startup.rs
@@ -0,0 +1,286 @@
+//! Private startup manifest and factual controller/native path identity.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::fs::OpenOptions;
+use std::io;
+use std::io::Read;
+use std::os::unix::fs::MetadataExt;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+
+use crate::BootstrapPeer;
+use crate::ExecutorFileSystem;
+use crate::HostFileSystem;
+use crate::WriteFileOptions;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+use serde::Deserialize;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeRuntimeStartup {
+    schema: String,
+    pub socket_path: String,
+    peer: NativePeer,
+    pub workspace_root: String,
+    shared_paths: Vec<SharedPathIdentity>,
+    controller_roots: Vec<String>,
+    parent_environment: HashMap<String, String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NativePeer {
+    pid: u32,
+    uid: u32,
+    gid: u32,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SharedPathIdentity {
+    path: String,
+    device: u64,
+    inode: u64,
+}
+
+impl NativeRuntimeStartup {
+    pub fn read(path: &Path) -> io::Result<Self> {
+        private_path(path, /*directory*/ false)?;
+        let mut input = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(path)?;
+        let meta = input.metadata()?;
+        if !meta.is_file()
+            || meta.len() > 65536
+            || meta.uid() != unsafe { libc::geteuid() }
+            || meta.mode() & 0o077 != 0
+        {
+            return Err(invalid(
+                "native startup manifest has an invalid size or type",
+            ));
+        }
+        let mut bytes = Vec::new();
+        input.by_ref().take(65537).read_to_end(&mut bytes)?;
+        if bytes.len() > 65536 {
+            return Err(invalid("native startup manifest grew beyond its bound"));
+        }
+        if !serde_json::from_slice::<serde_json::Value>(&bytes)
+            .map_err(io::Error::other)?
+            .is_object()
+        {
+            return Err(invalid("native startup manifest must be an object"));
+        }
+        let value: Self = serde_json::from_slice(&bytes).map_err(io::Error::other)?;
+        if value.schema != "foldgpt.native-startup.v1"
+            || value.peer.pid == 0
+            || value.peer.pid > i32::MAX as u32
+            || value.peer.uid == 0
+            || value.shared_paths.is_empty()
+            || value.shared_paths.len() > 128
+            || value.controller_roots.is_empty()
+            || value.controller_roots.len() > 128
+            || value.parent_environment.len() > 128
+        {
+            return Err(invalid(
+                "native startup manifest does not describe a bounded nonroot owner",
+            ));
+        }
+        if value.parent_environment.iter().any(|(name, value)| {
+            name.is_empty() || name.contains(['=', '\0']) || value.contains('\0')
+        }) {
+            return Err(invalid(
+                "native inheritance snapshot has an invalid variable",
+            ));
+        }
+        // PRoot maps libc UID and stat ownership together. Kernel socket credentials
+        // remain the real Android identity, obtained separately from procfs.
+        let status = std::fs::read_to_string("/proc/self/status")?;
+        let uid_line = status
+            .lines()
+            .find(|line| line.starts_with("Uid:"))
+            .ok_or_else(|| invalid("kernel process UID is unavailable"))?;
+        let uids = uid_line
+            .split_whitespace()
+            .skip(1)
+            .map(str::parse::<u32>)
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(io::Error::other)?;
+        if uids.len() != 4 || uids.iter().any(|uid| *uid != value.peer.uid) {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "native owner is not in this process's actual application UID",
+            ));
+        }
+        let root = value.workspace()?;
+        let root_path = root.to_abs_path()?;
+        if path.starts_with(root_path.as_path())
+            || Path::new(&value.socket_path).starts_with(root_path.as_path())
+        {
+            return Err(invalid(
+                "native bootstrap inputs must be outside the model workspace",
+            ));
+        }
+        private_path(Path::new(&value.socket_path), /*directory*/ false)?;
+        let socket_meta = std::fs::symlink_metadata(&value.socket_path)?;
+        if socket_meta.mode() & libc::S_IFMT != libc::S_IFSOCK {
+            return Err(invalid("native rendezvous is not a socket"));
+        }
+        let mut unique = HashSet::new();
+        for identity in &value.shared_paths {
+            let uri = canonical_uri(&identity.path)?;
+            if !unique.insert(uri) {
+                return Err(invalid("duplicate shared native path"));
+            }
+            identity.verify()?;
+        }
+        if !unique.contains(&root) {
+            return Err(invalid(
+                "workspace kernel identity is absent from native startup",
+            ));
+        }
+        for root in &value.controller_roots {
+            canonical_uri(root)?;
+        }
+        Ok(value)
+    }
+
+    pub fn peer(&self) -> BootstrapPeer {
+        BootstrapPeer {
+            pid: self.peer.pid,
+            uid: self.peer.uid,
+            gid: self.peer.gid,
+        }
+    }
+
+    pub fn parent_environment(&self) -> HashMap<String, String> {
+        self.parent_environment.clone()
+    }
+
+    pub fn workspace(&self) -> io::Result<PathUri> {
+        canonical_uri(&self.workspace_root)
+    }
+
+    pub fn controller_roots(&self) -> io::Result<Vec<PathUri>> {
+        self.controller_roots
+            .iter()
+            .map(|path| canonical_uri(path))
+            .collect()
+    }
+
+    pub fn covers(&self, path: &PathUri) -> io::Result<()> {
+        for identity in &self.shared_paths {
+            let root = canonical_uri(&identity.path)?;
+            if path.starts_with(&root) {
+                identity.verify()?;
+                return Ok(());
+            }
+        }
+        Err(invalid("runtime path is outside the measured shared roots"))
+    }
+}
+
+impl SharedPathIdentity {
+    fn verify(&self) -> io::Result<()> {
+        let path = canonical_uri(&self.path)?.to_abs_path()?;
+        if std::fs::canonicalize(&path)? != path.as_path() {
+            return Err(invalid("shared native path is an alias"));
+        }
+        let meta = std::fs::symlink_metadata(path)?;
+        if !(meta.is_dir() || meta.is_file())
+            || meta.dev() != self.device
+            || meta.ino() != self.inode
+        {
+            return Err(invalid("controller and native path device/inode differ"));
+        }
+        Ok(())
+    }
+}
+
+pub async fn verify_native_workspace_bytes(
+    root: &PathUri,
+    host: &HostFileSystem,
+) -> io::Result<()> {
+    let absolute = root.to_abs_path()?;
+    let path = absolute.join(format!(".foldgpt-startup-proof-{}", uuid::Uuid::new_v4()));
+    // Reserve our own fresh path before asking the actual native file authority
+    // to write it. Model turns have not been admitted during this startup phase.
+    let _created = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(&path)?;
+    let contents = uuid::Uuid::new_v4().into_bytes().to_vec();
+    let uri = PathUri::from_abs_path(&path);
+    host.write_file(
+        &uri,
+        contents.clone(),
+        WriteFileOptions::default(),
+        /*sandbox*/ None,
+    )
+    .await?;
+    let mut observed = Vec::new();
+    let mut input = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(&path)?;
+    input.by_ref().take(17).read_to_end(&mut observed)?;
+    if observed != contents {
+        return Err(invalid(
+            "controller cannot read the bytes actually written by the native backend",
+        ));
+    }
+    let opened = input.metadata()?;
+    let current = std::fs::symlink_metadata(&path)?;
+    if (opened.dev(), opened.ino()) != (current.dev(), current.ino()) {
+        return Err(invalid(
+            "native workspace proof path changed before removal",
+        ));
+    }
+    std::fs::remove_file(path)?;
+    Ok(())
+}
+
+fn private_path(path: &Path, directory: bool) -> io::Result<()> {
+    if !path.is_absolute() || std::fs::canonicalize(path)? != path {
+        return Err(invalid(
+            "native startup path must be canonical and absolute",
+        ));
+    }
+    let metadata = std::fs::symlink_metadata(path)?;
+    // PRoot's fake-id extension substitutes stat uid only for its own UID, using
+    // the same mapping as geteuid; SO_PEERCRED below verifies the kernel UID.
+    if metadata.uid() != unsafe { libc::geteuid() }
+        || metadata.mode() & 0o077 != 0
+        || directory && !metadata.is_dir()
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "native startup path is not private to its owner",
+        ));
+    }
+    if !directory {
+        private_path(
+            path.parent()
+                .ok_or_else(|| invalid("native startup parent missing"))?,
+            /*directory*/ true,
+        )?;
+    }
+    Ok(())
+}
+
+fn canonical_uri(value: &str) -> io::Result<PathUri> {
+    let uri: PathUri = value.parse().map_err(io::Error::other)?;
+    let path: AbsolutePathBuf = uri.to_abs_path()?;
+    if uri.to_string() != value || PathUri::from_abs_path(&path) != uri {
+        return Err(invalid("native startup requires a canonical file URI"));
+    }
+    Ok(uri)
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
