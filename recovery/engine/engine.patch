+
+#[path = "project_filesystem_fixture.rs"]
+mod fixture;
+use fixture::ProjectFiles;
+
+struct Fixture {
+    _temp: TempDir,
+    home: PathBuf,
+    project: AbsolutePathBuf,
+    provider: Arc<ProjectFiles>,
+    handle: ProjectConfigFileSystem,
+}
+
+impl Fixture {
+    fn new() -> anyhow::Result<Self> {
+        let temp = tempfile::tempdir()?;
+        let base = AbsolutePathBuf::from_absolute_path(temp.path())?.canonicalize()?;
+        let home = base.join("home").to_path_buf();
+        std::fs::create_dir(&home)?;
+        let project = base.join("project");
+        std::fs::create_dir_all(project.join(".codex"))?;
+        let provider = Arc::new(ProjectFiles::new(project.clone()));
+        let handle = ProjectConfigFileSystem::bounded(provider.clone(), project.clone());
+        let fixture = Self {
+            _temp: temp,
+            home,
+            project,
+            provider,
+            handle,
+        };
+        fixture.user("")?;
+        fixture.project_config("")?;
+        Ok(fixture)
+    }
+
+    fn user(&self, extra: &str) -> io::Result<()> {
+        let key = Value::String(self.project.to_string_lossy().into_owned());
+        std::fs::write(
+            self.home.join("config.toml"),
+            format!("{extra}\n[projects.{key}]\ntrust_level = 'trusted'\n"),
+        )
+    }
+
+    fn project_config(&self, contents: &str) -> io::Result<()> {
+        self.file(
+            ".codex/config.toml",
+            "model = 'wrong-controller-model'",
+            contents,
+        )
+        .map(|_| ())
+    }
+
+    fn file(&self, relative: &str, controller: &str, project: &str) -> io::Result<PathBuf> {
+        let path = self.project.join(relative).to_path_buf();
+        std::fs::create_dir_all(path.parent().unwrap())?;
+        std::fs::write(&path, controller)?;
+        self.provider
+            .contents
+            .lock()
+            .unwrap()
+            .insert(path.clone(), project.as_bytes().to_vec());
+        Ok(path)
+    }
+
+    fn builder(&self) -> ConfigBuilder {
+        ConfigBuilder::without_managed_config_for_tests()
+            .codex_home(self.home.clone())
+            .harness_overrides(ConfigOverrides {
+                cwd: Some(self.project.to_path_buf()),
+                ..Default::default()
+            })
+            .project_filesystem(self.handle.clone())
+    }
+
+    fn deny(&self, operation: &str, path: &Path, kind: io::ErrorKind) {
+        *self.provider.denied.lock().unwrap() = Some((operation.into(), path.to_path_buf(), kind));
+    }
+
+    fn assert_bounded(&self) {
+        assert!(
+            self.provider
+                .calls
+                .lock()
+                .unwrap()
+                .iter()
+                .all(|(_, path)| path.starts_with(self.project.as_path()))
+        );
+    }
+}
+
+fn quoted(path: &Path) -> Value {
+    Value::String(path.to_string_lossy().into_owned())
+}
