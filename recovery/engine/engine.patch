+//! Host connection routing supplied by bootstrap, never a model environment.
+use codex_exec_server::{ExecutorFileSystem, LOCAL_FS};
+use codex_utils_path_uri::PathUri;
+use std::io;
+use std::sync::Arc;
+
+#[derive(Clone)]
+pub(crate) struct HostFileSystemRoutes {
+    workspace_root: PathUri,
+    native: Arc<dyn ExecutorFileSystem>,
+    controller_roots: Vec<PathUri>,
+}
+
+impl HostFileSystemRoutes {
+    pub(crate) fn new(workspace_root: PathUri, native: Arc<dyn ExecutorFileSystem>, controller_roots: Vec<PathUri>) -> io::Result<Self> {
+        for path in std::iter::once(&workspace_root).chain(&controller_roots) {
+            if PathUri::from_abs_path(&path.to_abs_path()?) != *path {
+                return Err(io::Error::new(io::ErrorKind::InvalidInput, "host authority roots require native file URIs"));
+            }
+        }
+        for root in &controller_roots {
+            let path = root.to_abs_path()?;
+            if !std::fs::metadata(&path)?.is_dir()
+                || PathUri::from_host_native_path(std::fs::canonicalize(&path)?)? != *root {
+                return Err(io::Error::new(io::ErrorKind::InvalidInput, "controller authority roots must be existing canonical directories"));
+            }
+        }
+        // A recursive controller operation on an ancestor of W would cross the
+        // native owner's lease. Reject overlapping authority declarations.
+        if controller_roots.iter().any(|root| root.starts_with(&workspace_root) || workspace_root.starts_with(root)) {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "controller and native host file roots overlap"));
+        }
+        Ok(Self { workspace_root, native, controller_roots })
+    }
+
+    pub(crate) async fn select(&self, path: &PathUri) -> io::Result<Arc<dyn ExecutorFileSystem>> {
+        if path.starts_with(&self.workspace_root) { return Ok(Arc::clone(&self.native)); }
+        if !self.controller_roots.iter().any(|root| path.starts_with(root)) {
+            return Err(io::Error::new(io::ErrorKind::PermissionDenied, "path is outside the bootstrap-owned host file roots"));
+        }
+        // Resolve existing ancestors, including writes to new files, before
+        // choosing controller authority. Never reach W via a controller alias.
+        let mut existing = path.to_abs_path()?.to_path_buf();
+        let mut missing = Vec::new();
+        let resolved = loop {
+            match tokio::fs::canonicalize(&existing).await {
+                Ok(mut found) => {
+                    for part in missing.iter().rev() { found.push(part); }
+                    break PathUri::from_host_native_path(found)?;
+                }
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                    if tokio::fs::symlink_metadata(&existing).await.is_ok_and(|meta| meta.is_symlink()) {
+                        return Err(io::Error::new(io::ErrorKind::PermissionDenied, "unresolved controller symlink cannot select host authority"));
+                    }
+                    let name = existing.file_name().ok_or(error)?.to_os_string();
+                    missing.push(name);
+                    if !existing.pop() { return Err(io::Error::new(io::ErrorKind::NotFound, "controller path has no existing ancestor")); }
+                }
+                Err(error) => return Err(error),
+            }
+        };
+        if resolved.starts_with(&self.workspace_root)
+            || !self.controller_roots.iter().any(|root| resolved.starts_with(root)) {
+            return Err(io::Error::new(io::ErrorKind::PermissionDenied, "host path alias crosses file authorities"));
+        }
+        Ok(Arc::clone(&LOCAL_FS))
+    }
+}
