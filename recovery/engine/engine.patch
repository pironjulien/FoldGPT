+#[path = "injected_local_runtime_fixture.rs"]
+pub(super) mod fixture;
+
+const MODE_ENV: &str = "FOLDGPT_TEST_APP_BOOTSTRAP";
+const LISTEN_ENV: &str = "FOLDGPT_TEST_APP_LISTEN";
+const RPC_TIMEOUT: Duration = Duration::from_secs(30);
+
+// The subprocess receives isolated startup state. No test mutates its parent
+// process environment, and no test-only runtime selector enters production code.
+#[tokio::test]
+#[ignore = "bootstrap subprocess invoked only by injected_local_runtime integration cases"]
+async fn bootstrap_child() -> Result<()> {
+    let mode = std::env::var(MODE_ENV).context("missing isolated bootstrap mode")?;
+    let home = PathBuf::from(std::env::var_os("CODEX_HOME").context("missing test home")?);
+    let mut loader = LoaderOverrides::without_managed_config_for_tests();
+    loader.system_requirements_path = Some(home.join("requirements.toml"));
+    loader.ignore_user_config = mode == "ignore-config";
+    let options = AppServerRuntimeOptions {
+        plugin_startup_tasks: PluginStartupTasks::Skip,
+        remote_control_startup_mode: RemoteControlStartupMode::DisabledEphemeral,
+        install_shutdown_signal_handler: false,
+        ..Default::default()
+    };
+    let options = if mode == "official" {
+        options.into()
+    } else {
+        options.with_local_runtime(Arc::new(fixture::Runtime {
+            home: home.clone(),
+            path_access: if mode == "executor-only" {
+                ControllerPathAccess::ExecutorOnly
+            } else {
+                ControllerPathAccess::Shared
+            },
+            environment: Environment::default_for_tests(),
+        }))
+    };
+    let result = run_main_with_transport_options(
+        Arg0DispatchPaths {
+            codex_self_exe: Some(std::env::current_exe()?),
+            ..Default::default()
+        },
+        CliConfigOverrides::default(),
+        loader,
+        /*strict_config*/ true,
+        /*default_analytics_enabled*/ false,
+        AppServerTransport::from_listen_url(&std::env::var(LISTEN_ENV)?)?,
+        SessionSource::VSCode,
+        AppServerWebsocketAuthSettings::default(),
+        options,
+    )
+    .await;
+    if let Err(error) = result {
+        std::fs::write(home.join("startup-error"), error.to_string())?;
+    }
+    Ok(())
+}
+
+pub(super) async fn spawn(home: &Path, mode: &str) -> Result<(Child, std::net::SocketAddr)> {
+    let listener = TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    drop(listener);
+    std::fs::create_dir_all(home.join("runtime-home"))?;
+    std::fs::write(home.join("allowed.txt"), b"real runtime bytes\0\xff")?;
+    std::fs::write(home.join("denied.txt"), b"controller can read this")?;
+    let mut command = Command::new(std::env::current_exe()?);
+    command
+        .args([
+            "--ignored",
+            "--exact",
+            "suite::v2::injected_local_runtime::bootstrap_child",
+            "--nocapture",
+        ])
+        .env("CODEX_HOME", home)
+        .env(MODE_ENV, mode)
+        .env(LISTEN_ENV, format!("ws://{address}"))
+        .env_remove("CODEX_EXEC_SERVER_URL")
+        .env_remove("CODEX_EXEC_SERVER_NOISE_REGISTRY_URL")
+        .env_remove("CODEX_EXEC_SERVER_NOISE_ENVIRONMENT_ID")
+        .env_remove("CODEX_EXEC_SERVER_NOISE_AUTH_TOKEN")
+        .env_remove("CODEX_EXEC_SERVER_NOISE_CHATGPT_ACCOUNT_ID")
+        .current_dir(home)
+        .stdout(Stdio::null())
+        .stderr(Stdio::inherit())
+        .kill_on_drop(true);
+    if mode == "noise" {
+        command
+            .env(
+                "CODEX_EXEC_SERVER_NOISE_REGISTRY_URL",
+                "https://registry.invalid",
+            )
+            .env("CODEX_EXEC_SERVER_NOISE_ENVIRONMENT_ID", "test-environment")
+            .env("CODEX_EXEC_SERVER_NOISE_AUTH_TOKEN", "test-token");
+    }
+    Ok((command.spawn()?, address))
+}
+
+pub(super) async fn rpc(
+    client: &mut WsClient,
+    id: i64,
+    method: &str,
+    params: Value,
+) -> Result<Value> {
+    send_request(client, method, id, Some(params)).await?;
+    timeout(RPC_TIMEOUT, async {
+        loop {
+            match read_jsonrpc_message(client).await? {
+                JSONRPCMessage::Response(response) if response.id == RequestId::Integer(id) => {
+                    return Ok(response.result);
+                }
+                JSONRPCMessage::Error(error) if error.id == RequestId::Integer(id) => {
+                    bail!("{}", error.error.message)
+                }
+                _ => {}
+            }
+        }
+    })
+    .await?
+}
+
+pub(super) async fn initialize(client: &mut WsClient) -> Result<()> {
+    let response = rpc(
+        client,
+        1,
+        "initialize",
+        json!({
+            "clientInfo": { "name": "codex-app-server-tests", "version": "1.0" },
+            "capabilities": { "experimentalApi": true }
+        }),
+    )
+    .await?;
+    assert!(response["userAgent"].is_string());
+    send_jsonrpc(
+        client,
+        JSONRPCMessage::Notification(JSONRPCNotification {
+            method: "initialized".into(),
+            params: None,
+        }),
+    )
+    .await
+}
