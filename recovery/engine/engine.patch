new file mode 100644
index 0000000000000000000000000000000000000000..82601f0a8ef08a993ec39869e1cad6638b1e4af0
--- /dev/null
+++ b/codex-rs/core/src/config/project_filesystem_fixture.rs
@@ -0,0 +1,147 @@
+use codex_exec_server::LOCAL_FS;
+use codex_file_system::*;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+use std::collections::BTreeMap;
+use std::io;
+use std::path::PathBuf;
+use std::sync::Mutex;
+
+/// Uses real metadata/directory reads but distinct project bytes. Every access
+/// is recorded and constrained before delegation, including failed probes.
+pub(super) struct ProjectFiles {
+    pub root: AbsolutePathBuf,
+    pub contents: Mutex<BTreeMap<PathBuf, Vec<u8>>>,
+    pub denied: Mutex<Option<(String, PathBuf, io::ErrorKind)>>,
+    pub calls: Mutex<Vec<(String, PathBuf)>>,
+}
+
+impl ProjectFiles {
+    pub fn new(root: AbsolutePathBuf) -> Self {
+        Self {
+            root,
+            contents: Mutex::new(BTreeMap::new()),
+            denied: Mutex::new(None),
+            calls: Mutex::new(Vec::new()),
+        }
+    }
+
+    fn check(&self, operation: &str, uri: &PathUri) -> io::Result<PathBuf> {
+        let path = uri.to_abs_path()?.to_path_buf();
+        self.calls
+            .lock()
+            .unwrap()
+            .push((operation.into(), path.clone()));
+        if !path.starts_with(self.root.as_path()) {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "outside project root",
+            ));
+        }
+        if let Some((denied_operation, denied_path, kind)) = &*self.denied.lock().unwrap()
+            && denied_operation == operation
+            && denied_path == &path
+        {
+            return Err(io::Error::new(*kind, "project provider failure"));
+        }
+        Ok(path)
+    }
+}
+
+impl ExecutorFileSystem for ProjectFiles {
+    fn canonicalize<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, PathUri> {
+        Box::pin(async move {
+            self.check("canonicalize", path)?;
+            LOCAL_FS.canonicalize(path, sandbox).await
+        })
+    }
+    fn read_file<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: ReadFileOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<u8>> {
+        Box::pin(async move {
+            let path_buf = self.check("read", path)?;
+            let contents = self.contents.lock().unwrap().get(&path_buf).cloned();
+            match contents {
+                Some(contents) => Ok(contents),
+                None => LOCAL_FS.read_file(path, options, sandbox).await,
+            }
+        })
+    }
+    fn get_metadata<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: GetMetadataOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileMetadata> {
+        Box::pin(async move {
