+fn project_fixture(home: &Path) -> Result<(AbsolutePathBuf, ProjectConfigFileSystem)> {
+    let root = AbsolutePathBuf::try_from(home.join("project"))?;
+    std::fs::create_dir_all(root.join(".codex"))?;
+    std::fs::write(
+        root.join(".codex/config.toml"),
+        "model = 'project-original'\n",
+    )?;
+    let key = toml::Value::String(root.to_string_lossy().into_owned());
+    std::fs::write(
+        home.join("config.toml"),
+        format!("model = 'user-model'\n[projects.{key}]\ntrust_level = 'trusted'\n"),
+    )?;
+    let project = ProjectConfigFileSystem::bounded(
+        Arc::clone(&LOCAL_FS) as Arc<dyn ExecutorFileSystem>,
+        root.clone(),
+    );
+    Ok((root, project))
+}
