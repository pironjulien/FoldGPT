+use super::BootstrapFileSystem;
+use super::WireResult;
+use super::canonical_uri;
+use super::invalid;
+use crate::*;
+use codex_utils_path_uri::PathUri;
+use std::io;
+
+fn bootstrap_context(sandbox: Option<&FileSystemSandboxContext>) -> io::Result<()> {
+    if sandbox.is_some() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "model context cannot select bootstrap file authority",
+        ));
+    }
+    Ok(())
+}
+
+fn unsupported<'a, T: 'a>() -> ExecutorFileSystemFuture<'a, T> {
+    Box::pin(async {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "operation is not provided by bootstrap read authority",
+        ))
+    })
+}
+
+impl ExecutorFileSystem for BootstrapFileSystem {
+    fn canonicalize<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, PathUri> {
+        Box::pin(async move {
+            bootstrap_context(sandbox)?;
+            match self.request("canonicalize", path, None).await?.0 {
+                WireResult::Canonical(value) => canonical_uri(&value.path),
+                _ => Err(invalid("expected bootstrap canonicalization")),
+            }
+        })
+    }
+
+    fn read_file<'a>(
+        &'a self,
+        path: &'a PathUri,
+        _options: ReadFileOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<u8>> {
+        Box::pin(async move {
+            bootstrap_context(sandbox)?;
+            self.bytes(path).await
+        })
+    }
+
+    fn read_file_stream<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileSystemReadStream> {
+        Box::pin(async move {
+            bootstrap_context(sandbox)?;
+            let bytes = self.bytes(path).await?;
+            // The authority supplies one bounded complete read; expose those real
+            // bytes in the trait's required maximum chunk sizes after validation.
+            let chunks: Vec<_> = bytes
+                .chunks(FILE_READ_CHUNK_SIZE)
+                .map(|chunk| Ok(bytes::Bytes::copy_from_slice(chunk)))
+                .collect();
+            Ok(FileSystemReadStream::new(futures::stream::iter(chunks)))
+        })
+    }
+
+    fn get_metadata<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: GetMetadataOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileMetadata> {
+        Box::pin(async move {
+            bootstrap_context(sandbox)?;
+            match self
+                .request("getMetadata", path, Some(options.follow_symlinks))
+                .await?
+                .0
+            {
+                WireResult::Metadata(value) => Ok(FileMetadata {
+                    is_directory: value.is_directory,
+                    is_file: value.is_file,
+                    is_symlink: value.is_symlink,
+                    size: value.size,
+                    created_at_ms: value.created_at_ms,
+                    modified_at_ms: value.modified_at_ms,
+                }),
+                _ => Err(invalid("expected bootstrap metadata")),
+            }
+        })
+    }
+
+    fn read_directory<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<ReadDirectoryEntry>> {
+        Box::pin(async move {
+            bootstrap_context(sandbox)?;
+            self.directory(path).await
+        })
+    }
+
+    fn write_file<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _contents: Vec<u8>,
+        _options: WriteFileOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        unsupported()
+    }
+
+    fn create_directory<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _options: CreateDirectoryOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        unsupported()
+    }
+
+    fn walk<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _options: WalkOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, WalkOutcome> {
+        unsupported()
+    }
+
+    fn remove<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _options: RemoveOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        unsupported()
+    }
+
+    fn copy<'a>(
+        &'a self,
+        _source: &'a PathUri,
+        _destination: &'a PathUri,
+        _options: CopyOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        unsupported()
+    }
+}
