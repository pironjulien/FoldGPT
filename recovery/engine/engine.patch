@@ -0,0 +1,20 @@
+use super::ExecServerClient;
+use super::ExecServerError;
+
+impl ExecServerClient {
+    /// Disconnect a non-resumable transport without supervising its native owner.
+    pub(crate) async fn close_fixed_transport(&self) -> Result<(), ExecServerError> {
+        if self.inner.reconnect_strategy.is_some() {
+            return Err(ExecServerError::Protocol(
+                "fixed local transport must not have a reconnect strategy".into(),
+            ));
+        }
+        let rpc_client = self.rpc_client_without_recovery()?;
+        rpc_client.close_transport().await;
+        self.inner.request_recovery(
+            rpc_client,
+            "local executor transport closed by its owner".into(),
+        );
+        Ok(())
+    }
+}
