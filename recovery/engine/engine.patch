+/// Finds a native ancestor within an inclusive, caller-supplied discovery root.
+///
+/// The start and every marker path must be lexically inside `discovery_root`.
+/// An invalid start fails before any filesystem operation; an escaping marker
+/// returns `PermissionDenied`. Provider errors other than `NotFound` propagate.
+/// Parent probes above the root are never scheduled, including pipelined probes.
+/// This limits discovery calls; symlink and filesystem access enforcement remains
+/// the responsibility of the supplied provider and sandbox context.
+pub async fn find_nearest_native_ancestor_with_markers_within(
+    file_system: &dyn ExecutorFileSystem,
+    start: &AbsolutePathBuf,
+    discovery_root: &AbsolutePathBuf,
+    markers: Vec<String>,
+    sandbox: Option<&FileSystemSandboxContext>,
+) -> FileSystemResult<Option<AbsolutePathBuf>> {
+    if !start.as_path().starts_with(discovery_root.as_path()) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "discovery start is outside discovery root",
+        ));
+    }
+    find_nearest_ancestor(
+        file_system,
+        start.clone(),
+        markers,
+        |ancestor| {
+            if ancestor == discovery_root {
+                None
+            } else {
+                ancestor.parent()
+            }
+        },
+        |ancestor, marker| {
+            let path = ancestor.join(marker);
+            if !path.as_path().starts_with(discovery_root.as_path()) {
+                return Err(io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "marker path is outside discovery root",
+                ));
+            }
+            Ok(PathUri::from_abs_path(&path))
+        },
+        FindUpErrorPolicy::Propagate,
+        sandbox,
+    )
+    .await
+}
