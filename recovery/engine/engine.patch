+#[tokio::test]
+async fn strict_trust_keeps_completed_canonicalize_errors_when_checkout_does_not_match() {
+    let tmp = TempDir::new().unwrap();
+    let repo = tmp.path().join("repo");
+    let checkout = tmp.path().join("checkout");
+    let admin = write_linked_worktree_metadata(&repo, &checkout);
+    let common = fs::canonicalize(repo.join(".git")).unwrap();
+    let other = tmp.path().join("other");
+    fs::write(
+        admin.join("gitdir"),
+        format!("{}\n", other.join(".git").display()),
+    )
+    .unwrap();
+    // Check both a missing registered checkout and a real but unrelated one.
+    for create_registered_checkout in [false, true] {
+        if create_registered_checkout {
+            fs::create_dir(&other).unwrap();
+        }
+        let fs = MetadataOverrideFileSystem {
+            failures: vec![(
+                FileSystemOperation::Canonicalize,
+                PathUri::from_abs_path(&common.abs()),
+                io::ErrorKind::PermissionDenied,
+            )],
+            ..Default::default()
+        };
+        let error = try_resolve_root_git_project_for_trust(&fs, &checkout.abs())
+            .await
+            .unwrap_err();
+        assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+    }
+}
