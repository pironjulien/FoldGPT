new file mode 100644
index 0000000000000000000000000000000000000000..cb82ce378617f6bf9404e0f420b2a9566a0e9799
--- /dev/null
+++ b/codex-rs/config/src/loader/project_filesystems.rs
@@ -0,0 +1,121 @@
+use std::io;
+use std::path::Path;
+
+use codex_file_system::ExecutorFileSystem;
+use codex_file_system::FileMetadata;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+
+/// Internal authority split: project discovery never selects the controller as
+/// a substitute for a supplied provider. Legacy callers retain existing behavior.
+#[derive(Clone, Copy)]
+pub(super) enum ProjectFileSystems<'a> {
+    Unified(&'a dyn ExecutorFileSystem),
+    Split {
+        controller: &'a dyn ExecutorFileSystem,
+        project: &'a dyn ExecutorFileSystem,
+        discovery_root: Option<&'a AbsolutePathBuf>,
+    },
+}
+
+impl<'a> ProjectFileSystems<'a> {
+    pub(super) fn discovery_root(self) -> Option<&'a AbsolutePathBuf> {
+        match self {
+            Self::Unified(_) => None,
+            Self::Split { discovery_root, .. } => discovery_root,
+        }
+    }
+
+    pub(super) fn ancestors(
+        self,
+        start: &AbsolutePathBuf,
+    ) -> impl Iterator<Item = AbsolutePathBuf> + 'a {
+        let root = self.discovery_root();
+        std::iter::successors(Some(start.clone()), move |path| {
+            if root == Some(path) {
+                None
+            } else {
+                path.parent()
+            }
+        })
+    }
+    pub(super) fn project(self) -> &'a dyn ExecutorFileSystem {
+        match self {
+            Self::Unified(fs) | Self::Split { project: fs, .. } => fs,
+        }
+    }
+
+    pub(super) fn is_split(self) -> bool {
+        matches!(self, Self::Split { .. })
+    }
+
+    pub(super) async fn metadata(self, path: &AbsolutePathBuf) -> io::Result<Option<FileMetadata>> {
+        let result = self
+            .project()
+            .get_metadata(
+                &PathUri::from_abs_path(path),
+                Default::default(),
+                /*sandbox*/ None,
+            )
+            .await;
+        match result {
+            Ok(metadata) => Ok(Some(metadata)),
+            Err(error) if !self.is_split() || error.kind() == io::ErrorKind::NotFound => Ok(None),
+            Err(error) => Err(error),
+        }
+    }
+
+    pub(super) async fn canonical_project(
+        self,
+        path: &AbsolutePathBuf,
+    ) -> io::Result<AbsolutePathBuf> {
+        match self {
+            Self::Unified(_) => Ok(AbsolutePathBuf::from_absolute_path(
+                super::normalize_path(path.as_path()).unwrap_or_else(|_| path.to_path_buf()),
+            )?),
+            Self::Split { project, .. } => canonicalize(project, path).await,
+        }
+    }
+
+    pub(super) async fn canonical_home(
+        self,
+        path: &AbsolutePathBuf,
+    ) -> io::Result<AbsolutePathBuf> {
+        match self {
+            Self::Unified(_) => self.canonical_project(path).await,
+            Self::Split { controller, .. } => canonicalize(controller, path).await,
+        }
+    }
+
+    pub(super) async fn trust_keys(self, path: &Path) -> io::Result<Vec<String>> {
+        if !self.is_split() {
+            return Ok(super::normalized_project_trust_keys(path));
+        }
+        let native = super::normalize_project_trust_lookup_key(path.to_string_lossy().into_owned());
+        let canonical = self
+            .canonical_project(&AbsolutePathBuf::from_absolute_path(path)?)
+            .await?;
+        let canonical = super::normalize_project_trust_lookup_key(
+            canonical.as_path().to_string_lossy().into_owned(),
+        );
+        Ok(if canonical == native {
+            vec![canonical]
+        } else {
+            vec![canonical, native]
+        })
+    }
+}
+
+async fn canonicalize(
+    fs: &dyn ExecutorFileSystem,
+    path: &AbsolutePathBuf,
+) -> io::Result<AbsolutePathBuf> {
+    match fs
+        .canonicalize(&PathUri::from_abs_path(path), /*sandbox*/ None)
+        .await
+    {
+        Ok(path) => path.to_abs_path(),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(path.clone()),
+        Err(error) => Err(error),
+    }
+}
