new file mode 100644
index 0000000000000000000000000000000000000000..306b908a0fd1d0e0e18793142a53c403fbfdd178
--- /dev/null
+++ b/codex-rs/exec-server/src/environment/local_runtime.rs
@@ -0,0 +1,151 @@
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use codex_http_client::HttpClientFactory;
+
+use super::Environment;
+use super::EnvironmentObservedStatus;
+use crate::ExecBackend;
+use crate::ExecProcessFuture;
+use crate::ExecServerError;
+use crate::ExecServerRuntimePaths;
+use crate::ExecutorFileSystem;
+use crate::client::http_client::RouteAwareHttpClient;
+use crate::protocol::EnvironmentInfo;
+
+/// The component that applies a requested sandbox, independently of host locality.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum SandboxOwner {
+    Controller,
+    Executor,
+}
+
+/// Execution and filesystem enforcement can belong to different implementations.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct LocalSandboxOwnership {
+    pub process: SandboxOwner,
+    pub filesystem: SandboxOwner,
+}
+
+/// Whether executor paths can also be accessed directly by the controller.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ControllerPathAccess {
+    Shared,
+    ExecutorOnly,
+}
+
+/// A real local host runtime supplied by the application bootstrap.
+///
+/// The owner authenticates the runtime before registration and retains its process
+/// and filesystem backends for the environment's lifetime. Both backends must
+/// enforce their complete request context and reject operations after connection
+/// loss; metadata readiness alone is not launch authorization. Paths are actual
+/// executor-native paths, never controller-side textual remappings.
+///
+/// Boxed futures preserve object safety at this runtime injection boundary.
+pub trait LocalRuntime: Send + Sync {
+    fn exec_backend(&self) -> Arc<dyn ExecBackend>;
+    fn filesystem(&self) -> Arc<dyn ExecutorFileSystem>;
+    /// Actual executor-owned inheritance snapshot when it differs from the
+    /// controller. Bootstrap supplies it; requests can apply their ordinary
+    /// shell policy and exact environment removals without inheriting a foreign
+    /// controller PATH. Providers using the controller's environment omit it.
+    fn parent_environment(&self) -> Option<HashMap<String, String>> {
+        None
+    }
+    /// Optional configuration authority installed by trusted bootstrap. It is
+    /// separate from model filesystem admission and is never client-selectable.
+    fn project_filesystem(&self) -> Option<codex_config::ProjectConfigFileSystem> {
+        None
+    }
+    fn sandbox_ownership(&self) -> LocalSandboxOwnership;
+    fn controller_path_access(&self) -> ControllerPathAccess;
+    fn info(&self) -> ExecProcessFuture<'_, EnvironmentInfo>;
+    fn observed_status(&self) -> EnvironmentObservedStatus;
+    fn wait_until_ready(&self) -> ExecProcessFuture<'_, ()>;
+}
+
+impl Environment {
+    /// Optional inheritance snapshot owned by the injected local runtime.
+    pub fn parent_environment(&self) -> Option<HashMap<String, String>> {
+        self.local_runtime
+            .as_ref()
+            .and_then(|runtime| runtime.parent_environment())
+    }
+    /// Configuration reads use a dedicated authority when bootstrap supplied
+    /// one; existing shared providers retain their own filesystem handle.
+    pub fn project_filesystem(&self) -> Option<codex_config::ProjectConfigFileSystem> {
+        self.local_runtime.as_ref().map(|runtime| {
+            runtime.project_filesystem().unwrap_or_else(|| {
+                codex_config::ProjectConfigFileSystem::shared(Arc::clone(&self.filesystem))
+            })
+        })
+    }
+    /// Whether bootstrap supplied the local shell, metadata and execution runtime.
+    ///
+    /// This is independent of sandbox ownership and controller path visibility;
+    /// a shared-path runtime can still use a different shell and temporary roots.
+    pub fn has_local_runtime(&self) -> bool {
+        self.local_runtime.is_some()
+    }
+
+    pub(super) fn local_with_runtime(
+        runtime: Arc<dyn LocalRuntime>,
+        local_runtime_paths: Option<ExecServerRuntimePaths>,
+        http_client_factory: HttpClientFactory,
+    ) -> Self {
+        Self {
+            remote_client: None,
+            ready_info: Arc::new(arc_swap::ArcSwapOption::empty()),
+            provisioning_status_tx: None,
+            startup_task: Arc::new(std::sync::Mutex::new(None)),
+            exec_backend: runtime.exec_backend(),
+            filesystem: runtime.filesystem(),
+            http_client: Arc::new(RouteAwareHttpClient::new(http_client_factory)),
+            local_runtime_paths,
+            local_runtime: Some(runtime),
+        }
+    }
+
+    /// Who enforces model command sandbox intent for this environment.
+    pub fn process_sandbox_owner(&self) -> SandboxOwner {
+        match &self.local_runtime {
+            Some(runtime) => runtime.sandbox_ownership().process,
+            None if self.is_remote() => SandboxOwner::Executor,
+            None => SandboxOwner::Controller,
+        }
+    }
+
+    /// Who enforces the optional agent context on filesystem operations.
+    pub fn filesystem_sandbox_owner(&self) -> SandboxOwner {
+        match &self.local_runtime {
+            Some(runtime) => runtime.sandbox_ownership().filesystem,
+            None if self.is_remote() => SandboxOwner::Executor,
+            None => SandboxOwner::Controller,
+        }
+    }
+
+    /// Direct filesystem access is separate from transport and sandbox ownership.
+    pub fn controller_path_access(&self) -> ControllerPathAccess {
+        match &self.local_runtime {
+            Some(runtime) => runtime.controller_path_access(),
+            None if self.is_remote() => ControllerPathAccess::ExecutorOnly,
+            None => ControllerPathAccess::Shared,
+        }
+    }
+
+    pub(super) fn local_readiness_result(&self) -> Option<Result<(), ExecServerError>> {
+        let runtime = self.local_runtime.as_ref()?;
+        match runtime.observed_status() {
+            EnvironmentObservedStatus::Ready => Some(Ok(())),
+            EnvironmentObservedStatus::Pending => None,
+            EnvironmentObservedStatus::Disconnected { error } => {
+                Some(Err(ExecServerError::Protocol(error)))
+            }
+        }
+    }
+}
