+use pretty_assertions::assert_eq;
+use std::fs;
+use std::io;
+use tempfile::TempDir;
+use tokio::process::Command;
+
+fn assert_calls_within(fs: &MetadataOverrideFileSystem, root: &AbsolutePathBuf) {
+    let calls = fs.calls.lock().unwrap();
+    assert!(!calls.is_empty());
+    for (operation, path) in calls.iter() {
+        assert!(
+            path.to_abs_path()
+                .unwrap()
+                .as_path()
+                .starts_with(root.as_path()),
+            "{operation:?} escaped {}: {path}",
+            root.display()
+        );
+    }
+}
+
+#[tokio::test]
+async fn bounded_discovery_includes_root_without_scheduling_parent_probes() {
+    let tmp = TempDir::new().unwrap();
+    let root = tmp.path().join("scope").abs();
+    let start = root.join("nested/deep");
+    fs::create_dir_all(&start).unwrap();
+    fs::write(tmp.path().join("marker"), "outside").unwrap();
+    fs::write(root.join("marker"), "inside").unwrap();
+    for expected in [Some(root.clone()), None] {
+        let provider = MetadataOverrideFileSystem::default();
+        assert_eq!(
+            find_nearest_native_ancestor_with_markers_within(
+                &provider,
+                &start,
+                &root,
+                vec!["marker".to_string()],
+                /*sandbox*/ None,
+            )
+            .await
+            .unwrap(),
+            expected
+        );
+        assert_calls_within(&provider, &root);
+        assert!(provider.calls.lock().unwrap().contains(&(
+            FileSystemOperation::Metadata,
+            PathUri::from_abs_path(&root.join("marker"))
+        )));
+        if expected.is_some() {
+            fs::remove_file(root.join("marker")).unwrap();
+        }
+    }
+}
+
+#[tokio::test]
+async fn bounded_discovery_rejects_outside_inputs_without_probing_them() {
+    let tmp = TempDir::new().unwrap();
+    let root = tmp.path().join("scope").abs();
+    let outside = tmp.path().join("scope-other").abs();
+    fs::create_dir(&root).unwrap();
+    fs::create_dir(&outside).unwrap();
+    for (start, marker, kind) in [
+        (&outside, "marker".to_string(), io::ErrorKind::InvalidInput),
+        (
+            &root,
+            "../marker".to_string(),
+            io::ErrorKind::PermissionDenied,
+        ),
+        (
+            &root,
+            outside.to_string_lossy().into_owned(),
+            io::ErrorKind::PermissionDenied,
+        ),
+    ] {
+        let provider = MetadataOverrideFileSystem::default();
+        let error = find_nearest_native_ancestor_with_markers_within(
