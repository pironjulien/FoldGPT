+use codex_exec_server::ExecProcess;
+use codex_exec_server::ExecProcessEvent;
+use codex_exec_server::ExecServerLocalRuntime;
+use codex_exec_server::FileSystemSandboxContext;
+use codex_exec_server::LOCAL_ENVIRONMENT_ID;
+use codex_exec_server::LocalRuntime;
+use codex_exec_server::ProcessId;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use codex_protocol::config_types::ShellEnvironmentPolicyInherit;
+use codex_utils_path_uri::PathUri;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use tokio::process::Command;
+use tokio::time::timeout;
+
+fn policy(workspace: &Path) -> Result<FileSystemSandboxContext> {
+    let cwd = PathUri::from_host_native_path(workspace)?;
+    Ok(serde_json::from_value(json!({
+        "permissions": {"type": "managed", "file_system": {"type": "restricted", "entries": [
+            {"path": {"type": "path", "path": cwd}, "access": "write"},
+            {"path": {"type": "path", "path": PathUri::from_host_native_path(workspace.join("private"))?}, "access": "deny"}
+        ]}, "network": "restricted"},
+        "cwd": cwd, "workspaceRoots": [cwd], "windowsSandboxLevel": "disabled"
+    }))?)
+}
+
+fn command(key: &str, shell: &str, sandbox: &FileSystemSandboxContext) -> Result<ExecParams> {
+    Ok(ExecParams {
+        process_id: ProcessId::from(key),
+        argv: vec![
+            "/usr/bin/bash".into(),
+            "--noprofile".into(),
+            "--norc".into(),
+            "-c".into(),
+            shell.into(),
+        ],
+        cwd: sandbox.cwd.clone().context("test policy cwd")?,
+        env_policy: None,
+        shell_snapshot: None,
+        env: HashMap::from([("VALUE".into(), "preserved environment".into())]),
+        tty: false,
+        pipe_stdin: false,
+        arg0: None,
+        sandbox: Some(sandbox.clone()),
+        enforce_managed_network: false,
+        managed_network: None,
+        network_proxy: None,
+    })
+}
+
+async fn output(process: &dyn ExecProcess) -> Result<(Vec<u8>, Vec<u8>, i32)> {
+    timeout(Duration::from_secs(12), async {
+        let mut after = None;
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+        loop {
+            let response = process.read(after, Some(32768), Some(100)).await?;
+            anyhow::ensure!(
+                response.failure.is_none(),
+                "native process failed: {response:?}"
+            );
+            for chunk in response.chunks {
+                match chunk.stream {
+                    ExecOutputStream::Stdout => stdout.extend_from_slice(&chunk.chunk.0),
+                    ExecOutputStream::Stderr => stderr.extend_from_slice(&chunk.chunk.0),
+                    ExecOutputStream::Pty => anyhow::bail!("pipe process returned PTY output"),
+                }
+                after = Some(chunk.seq);
+            }
+            if response.closed {
+                anyhow::ensure!(response.exited, "closure must include actual exit");
+                return Ok((
+                    stdout,
+                    stderr,
+                    response.exit_code.context("actual exit code")?,
+                ));
+            }
+        }
+    })
+    .await?
+}
+
+/// Uses an explicitly supplied, compiled native factory checkpoint. This cannot
+/// silently turn into a mock or run as root when that prerequisite is absent.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "requires FOLDGPT_NATIVE_FACTORY_BUILD and the real Linux native helpers"]
+async fn real_native_factory_preserves_local_identity_policy_io_and_disconnect() -> Result<()> {
+    let build = std::env::var_os("FOLDGPT_NATIVE_FACTORY_BUILD")
+        .context("compiled native factory checkpoint required")?;
+    let base = tempfile::Builder::new()
+        .prefix("foldgpt-rust-native-")
+        .tempdir_in("/var/tmp")?;
+    let workspace = base.path().join("workspace");
+    std::fs::DirBuilder::new().mode(0o700).create(&workspace)?;
+    std::fs::create_dir(workspace.join("private"))?;
+    std::fs::create_dir(workspace.join(".git"))?;
+    std::fs::write(workspace.join("private/secret"), b"private data")?;
+    std::fs::write(
+        base.path().join("environments.toml"),
+        "default = \"local\"\ninclude_local = true\n",
+    )?;
+    let launcher = base.path().join("launcher.py");
+    std::fs::write(&launcher, include_str!("fixtures/native_exec_server.py"))?;
+    let evidence_path = base.path().join("evidence.json");
+    // The test bootstrap owns this exact child and its pipes. The runtime has
+    // no executable, replacement callback, URL, or process-tree kill policy.
+    let mut child = Command::new("/usr/bin/python3")
+        .args(["-I", "-B"])
+        .arg(&launcher)
+        .arg(build)
+        .arg(&workspace)
+        .arg(&evidence_path)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::inherit())
+        .spawn()?;
+    let child_pid = child.id().context("bootstrap-owned server PID")?;
+    let runtime = ExecServerLocalRuntime::connect(
+        child.stdout.take().context("server stdout")?,
+        child.stdin.take().context("server stdin")?,
+        ControllerPathAccess::Shared,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    )
+    .await?;
+    let sandbox = policy(&workspace)?;
+    let mut first = command(
+        "native",
+        "printf '%s\\n%s\\n%s\\n' \"$PWD\" \"$VALUE\" \"$POLICY_VALUE\"; printf stderr >&2; if read value; then exit 8; else printf EOF; fi; printf 42 > answer; exit 23",
+        &sandbox,
+    )?;
+    first.env_policy = Some(ExecEnvPolicy {
+        inherit: ShellEnvironmentPolicyInherit::All,
+        ignore_default_excludes: false,
+        exclude: vec!["HOME".into()],
+        r#set: HashMap::from([("POLICY_VALUE".into(), "policy override".into())]),
+        include_only: vec!["PATH".into(), "POLICY_*".into()],
+    });
+    let test_result: Result<()> = async {
+        let manager = EnvironmentManager::prepare_from_codex_home(base.path())
+            .await?
+            .build_with_local_runtime(
+                runtime.clone(),
+                /*local_runtime_paths*/ None,
+                HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+            )?;
+        let environment = manager
+            .default_environment()
+            .context("registered local environment")?;
+        anyhow::ensure!(!environment.is_remote(), "native runtime must remain local");
+        anyhow::ensure!(Arc::ptr_eq(
+            &environment,
+            &manager
+                .get_environment(LOCAL_ENVIRONMENT_ID)
+                .context("local registry")?
+        ));
+        let info = environment.info().await?;
+        anyhow::ensure!(info.cwd == sandbox.cwd && info.shell.path == "/usr/bin/bash");
+        let started = environment.get_exec_backend().start(first.clone()).await?;
+        let actual = output(started.process.as_ref()).await?;
+        let expected = (
+            format!(
+                "{}\npreserved environment\npolicy override\nEOF",
+                workspace.display()
+            )
+            .into_bytes(),
+            b"stderr".to_vec(),
+            23,
+        );
+        anyhow::ensure!(
+            actual == expected,
+            "stdout/stderr/EOF/exit differ: {actual:?}"
+        );
+        let files = environment.get_filesystem();
+        let backend = environment.get_exec_backend();
+        let answer = PathUri::from_host_native_path(workspace.join("answer"))?;
+        anyhow::ensure!(
+            files
+                .read_file(&answer, Default::default(), Some(&sandbox))
+                .await?
+                == b"42"
+        );
+        files
+            .write_file(&answer, b"43".to_vec(), Default::default(), Some(&sandbox))
+            .await?;
+        anyhow::ensure!(std::fs::read(workspace.join("answer"))? == b"43");
+        let forbidden = PathUri::from_host_native_path(workspace.join("private/blocked"))?;
+        anyhow::ensure!(
+            files
+                .write_file(
+                    &forbidden,
+                    b"bad".to_vec(),
+                    Default::default(),
+                    Some(&sandbox)
+                )
+                .await
+                .is_err()
+        );
+        let mut unsupported = command("unsupported", "printf bad > unsupported", &sandbox)?;
+        unsupported.tty = true;
+        anyhow::ensure!(
+            environment
+                .get_exec_backend()
+                .start(unsupported)
+                .await
+                .is_err()
+        );
+        anyhow::ensure!(
+            !workspace.join("private/blocked").exists() && !workspace.join("unsupported").exists()
+        );
+        let mut unsupported_network = command(
+            "managed-network",
+            "printf bad > unsupported-network",
+            &sandbox,
+        )?;
+        unsupported_network.enforce_managed_network = true;
+        anyhow::ensure!(backend.start(unsupported_network).await.is_err());
+        anyhow::ensure!(!workspace.join("unsupported-network").exists());
+        let mut binary = command(
+            "binary",
+            "exec /usr/bin/python3 -I -B -c 'import os;os.write(1,os.read(0,5))'",
+            &sandbox,
+        )?;
+        binary.pipe_stdin = true;
+        let started = environment.get_exec_backend().start(binary).await?;
+        started.process.write(b"\0\xffABC".to_vec()).await?;
+        anyhow::ensure!(
+            output(started.process.as_ref()).await? == (b"\0\xffABC".to_vec(), Vec::new(), 0)
+        );
+        let started = environment
+            .get_exec_backend()
+            .start(command(
+                "disconnect",
+                "printf READY; exec /usr/bin/sleep 100",
+                &sandbox,
+            )?)
+            .await?;
+        let ready = timeout(Duration::from_secs(5), async {
+            loop {
+                let read = started.process.read(None, Some(32768), Some(100)).await?;
+                if !read.chunks.is_empty() {
+                    return Ok::<_, anyhow::Error>(read);
+                }
+                anyhow::ensure!(
+                    read.failure.is_none() && !read.closed,
+                    "worker did not become ready: {read:?}"
+                );
+            }
+        })
+        .await??;
+        anyhow::ensure!(ready.chunks.iter().any(|chunk| chunk.chunk.0 == b"READY"));
+        let mut events = started.process.subscribe_events();
+        runtime.disconnect().await?;
+        anyhow::ensure!(matches!(
+            runtime.observed_status(),
+            EnvironmentObservedStatus::Disconnected { .. }
+        ));
+        anyhow::ensure!(runtime.wait_until_ready().await.is_err());
+        anyhow::ensure!(
+            backend
+                .start(command("after-loss", "printf bad > replayed", &sandbox)?)
+                .await
+                .is_err()
+        );
+        let after_loss = PathUri::from_host_native_path(workspace.join("after-loss-file"))?;
+        anyhow::ensure!(
+            files
+                .write_file(
+                    &after_loss,
+                    b"bad".to_vec(),
+                    Default::default(),
+                    Some(&sandbox)
+                )
+                .await
+                .is_err()
+        );
+        let lost = timeout(
+            Duration::from_secs(5),
+            started.process.read(None, Some(32768), Some(100)),
+        )
+        .await?;
+        anyhow::ensure!(lost.is_err(), "disconnect cannot attest exit: {lost:?}");
+        timeout(Duration::from_secs(5), async {
+            loop {
+                match events.recv().await? {
+                    ExecProcessEvent::Output(_) => {}
+                    ExecProcessEvent::Failed(_) => return Ok::<_, anyhow::Error>(()),
+                    event @ (ExecProcessEvent::Exited { .. } | ExecProcessEvent::Closed { .. }) => {
+                        anyhow::bail!("transport loss synthesized a native event: {event:?}");
+                    }
+                }
+            }
+        })
+        .await??;
+        Ok(())
+    }
+    .await;
+    // Always await the real bootstrap child and its separate native close evidence.
+    let _ = runtime.disconnect().await;
+    let status = timeout(Duration::from_secs(15), child.wait()).await??;
+    test_result?;
+    anyhow::ensure!(status.success(), "native server failed: {status}");
+    let evidence: Value = serde_json::from_slice(&std::fs::read(evidence_path)?)?;
+    assert_eq!(evidence["pid"], child_pid);
+    assert_eq!(evidence["closeError"], Value::Null);
+    assert_eq!(evidence["quarantined"], false);
+    let calls = evidence["calls"]
+        .as_array()
+        .context("observed wire calls")?;
+    let starts: Vec<_> = calls
+        .iter()
+        .filter(|call| call["method"] == "process/start")
+        .collect();
+    assert_eq!(
+        starts
+            .iter()
+            .map(|call| call["params"]["processId"].clone())
+            .collect::<Vec<_>>(),
+        vec![
+            json!("native"),
+            json!("unsupported"),
+            json!("binary"),
+            json!("disconnect")
+        ]
+    );
+    assert_eq!(starts[0]["params"], serde_json::to_value(&first)?);
+    for call in calls.iter().filter(|call| {
+        ["fs/readFile", "fs/writeFile"].contains(&call["method"].as_str().unwrap_or_default())
+    }) {
+        assert_eq!(call["params"]["sandbox"], serde_json::to_value(&sandbox)?);
+    }
+    let records = evidence["records"]
+        .as_array()
+        .context("independent native observations")?;
+    for key in ["native", "binary", "disconnect"] {
+        let record = records
+            .iter()
+            .find(|record| record["key"] == key)
+            .context("native process record")?;
+        assert_eq!(record["nativeResult"]["cleanupComplete"], true);
+        anyhow::ensure!(
+            record["supervisorReturncode"].is_i64(),
+            "supervisor termination must be observed"
+        );
+    }
+    anyhow::ensure!(
+        !workspace.join("replayed").exists() && !workspace.join("after-loss-file").exists()
+    );
+    println!("real native factory evidence: {evidence}");
+    Ok(())
+}
