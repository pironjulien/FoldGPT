+#[tokio::test]
+async fn acquisition_transfers_three_real_socketpairs_and_binds_the_session() -> anyhow::Result<()>
+{
+    tokio::time::timeout(Duration::from_secs(15), async {
+        let peer = Peer::spawn("valid").await?;
+        let NativeRuntimeChannels {
+            mut exec,
+            config,
+            host,
+            lifetime,
+        } = peer.acquire().await?;
+        exec.write_all(b"descriptor-transport-test").await?;
+        lifetime.bind_session("transport-session").await?;
+        let mut echo = [0_u8; 3];
+        exec.read_exact(&mut echo).await?;
+        assert_eq!(echo, [0, 0, 255]);
+        for (index, descriptor) in [(1_u8, config), (2, host)] {
+            // Real direct sockets have no buffering adapter or byte relay.
+            let sent = unsafe {
+                libc::send(
+                    descriptor.as_raw_fd(),
+                    (&raw const index).cast(),
+                    1,
+                    libc::MSG_NOSIGNAL,
+                )
+            };
+            assert_eq!(sent, 1);
+            let socket = tokio::io::unix::AsyncFd::new(descriptor)?;
+            let mut echo = [0_u8; 3];
+            let received = socket
+                .async_io(tokio::io::Interest::READABLE, |descriptor| {
+                    let count = unsafe {
+                        libc::recv(
+                            descriptor.as_raw_fd(),
+                            echo.as_mut_ptr().cast(),
+                            echo.len(),
+                            0,
+                        )
+                    };
+                    if count < 0 {
+                        Err(io::Error::last_os_error())
+                    } else {
+                        Ok(count)
+                    }
+                })
+                .await?;
+            assert_eq!(received, 3);
+            assert_eq!(echo, [index, 0, 255]);
+        }
+        lifetime.disconnect();
+        drop(exec);
+        drop(lifetime);
+        assert_eq!(
+            peer.finish().await?,
+            serde_json::json!({"lifetimeClosed":true})
+        );
+        anyhow::Ok(())
+    })
+    .await??;
+    Ok(())
+}
+
+#[tokio::test]
+async fn rejected_descriptor_bundles_close_every_transferred_descriptor() -> anyhow::Result<()> {
+    for mode in [
