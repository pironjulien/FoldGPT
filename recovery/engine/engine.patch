+use super::{HostFileSystem, Operation, Response, invalid};
+use crate::*;
+use codex_utils_path_uri::PathUri;
+use std::io;
+
+fn host_context(sandbox: Option<&FileSystemSandboxContext>) -> io::Result<()> {
+    if sandbox.is_some() {
+        return Err(io::Error::new(io::ErrorKind::PermissionDenied, "model context cannot select host file authority"));
+    }
+    Ok(())
+}
+
+fn unsupported<'a, T: 'a>(sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, T> {
+    Box::pin(async move {
+        host_context(sandbox)?;
+        Err(io::Error::new(io::ErrorKind::Unsupported, "operation is not provided by host file authority"))
+    })
+}
+
+impl ExecutorFileSystem for HostFileSystem {
+    fn canonicalize<'a>(&'a self, path: &'a PathUri, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, PathUri> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::Canonicalize).await? {
+                Response::Canonical(path) => Ok(path),
+                _ => Err(invalid("expected host canonicalization")),
+            }
+        })
+    }
+
+    fn read_file<'a>(&'a self, path: &'a PathUri, _options: ReadFileOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, Vec<u8>> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            // This authority rejects every symlink structurally. Both options
+            // therefore have identical behavior for its ordinary admitted files.
+            match self.request(path, Operation::Read).await? {
+                Response::Bytes(bytes) => Ok(bytes),
+                _ => Err(invalid("expected host file bytes")),
+            }
+        })
+    }
+
+    fn write_file<'a>(&'a self, path: &'a PathUri, contents: Vec<u8>, _options: WriteFileOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, ()> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::Write(&contents)).await? {
+                Response::Done => Ok(()),
+                _ => Err(invalid("expected host write completion")),
+            }
+        })
+    }
+
+    fn get_metadata<'a>(&'a self, path: &'a PathUri, options: GetMetadataOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, FileMetadata> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::Metadata(options)).await? {
+                Response::Metadata(metadata) => Ok(metadata),
+                _ => Err(invalid("expected host metadata")),
+            }
+        })
+    }
+
+    fn read_directory<'a>(&'a self, path: &'a PathUri, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, Vec<ReadDirectoryEntry>> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::Directory).await? {
+                Response::Directory(entries) => Ok(entries),
+                _ => Err(invalid("expected host directory entries")),
+            }
+        })
+    }
+
+    fn create_directory<'a>(&'a self, path: &'a PathUri, options: CreateDirectoryOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, ()> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::CreateDirectory(options)).await? {
+                Response::Done => Ok(()),
+                _ => Err(invalid("expected host directory creation")),
+            }
+        })
+    }
+
+    fn read_file_stream<'a>(&'a self, _path: &'a PathUri, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, FileSystemReadStream> { unsupported(sandbox) }
+    fn walk<'a>(&'a self, _path: &'a PathUri, _options: WalkOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, WalkOutcome> { unsupported(sandbox) }
+    fn remove<'a>(&'a self, _path: &'a PathUri, _options: RemoveOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, ()> { unsupported(sandbox) }
+    fn copy<'a>(&'a self, _source: &'a PathUri, _destination: &'a PathUri, _options: CopyOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, ()> { unsupported(sandbox) }
+}
