+    let home = TempDir::new()?;
+    std::fs::write(home.path().join("command-runtime"), owner)?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        "default_permissions = ':danger-full-access'\n",
+    )?;
+    let (mut child, address) = spawn(home.path(), "injected").await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+    let command = vec![
+        "/bin/sh",
+        "-c",
+        "printf '%s' \"$FOLDGPT_COMMAND_TEST\"; printf err >&2; exit 23",
+    ];
+    let response = rpc(
+        &mut client,
+        2,
+        "command/exec",
+        json!({
+            "command": command, "cwd": home.path(), "permissionProfile":":danger-full-access",
+            "env": {"FOLDGPT_COMMAND_TEST":"injected-real", "PATH":null},
+        }),
+    )
+    .await?;
+    assert_eq!(
+        response,
+        json!({"exitCode":23,"stdout":"injected-real","stderr":"err"})
+    );
+    let recorded: ExecParams =
+        serde_json::from_slice(&std::fs::read(home.path().join("command-record.json"))?)?;
+    assert_eq!(recorded.argv, command);
+    assert_eq!(recorded.cwd, PathUri::from_host_native_path(home.path())?);
+    assert_eq!(
+        recorded.env.get("FOLDGPT_COMMAND_TEST").map(String::as_str),
+        Some("injected-real")
+    );
+    assert!(!recorded.env.contains_key("PATH"));
+    assert!(recorded.env_policy.is_none());
+    if owner == "executor" {
+        let context = recorded
+            .sandbox
+            .expect("executor receives portable permissions");
+        assert_eq!(
+            PermissionProfile::try_from(context.permissions)?,
+            PermissionProfile::Disabled
+        );
+        assert_eq!(
+            context.user_home_dir,
+            Some(PathUri::from_host_native_path(
+                home.path().join("runtime-home")
+            )?)
+        );
+    } else {
+        assert!(recorded.sandbox.is_none());
+    }
+    child.kill().await?;
+    Ok(())
+}
