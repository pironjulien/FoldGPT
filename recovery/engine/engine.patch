@@ -0,0 +1,173 @@
+//! Version-2 files use one bounded staging slot, independent of human processes.
+use super::{HostConnectionV2, canonical_uri, decode, invalid};
+use super::protocol::*;
+use std::collections::HashSet;
+use std::io;
+use std::sync::Arc;
+use codex_utils_path_uri::PathUri;
+
+pub struct HostFileSystemV2 { pub(super) connection: Arc<HostConnectionV2> }
+
+#[derive(Clone, Copy)]
+enum Operation<'a> {
+    Read,
+    Write(&'a [u8]),
+    Metadata(crate::GetMetadataOptions),
+    Canonicalize,
+    Directory,
+    CreateDirectory(crate::CreateDirectoryOptions),
+}
+
+enum FileResponse {
+    Bytes(Vec<u8>),
+    Metadata(crate::FileMetadata),
+    Canonical(PathUri),
+    Directory(Vec<crate::ReadDirectoryEntry>),
+    Done,
+}
+
+impl HostFileSystemV2 {
+    async fn request(&self, path: &PathUri, operation: Operation<'_>) -> io::Result<FileResponse> {
+        if canonical_uri(&path.to_string())? != *path || !path.starts_with(&self.connection.workspace_root) {
+            return Err(io::Error::new(io::ErrorKind::PermissionDenied, "host path is outside its workspace"));
+        }
+        if matches!(&operation, Operation::Write(bytes) if bytes.len() > MAX_DATA_BYTES) {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "host write exceeds the admitted data bound"));
+        }
+        let _slot = self.connection.file_slot.acquire().await.map_err(|_| super::closed())?;
+        let mut request = serde_json::json!({"path":path});
+        request["op"] = match &operation {
+            Operation::Read => "readFile",
+            Operation::Write(bytes) => {
+                request["bytes"] = bytes.len().into();
+                request["chunks"] = bytes.len().div_ceil(CHUNK_BYTES).into();
+                "writeFile"
+            }
+            Operation::Metadata(options) => { request["followSymlinks"] = options.follow_symlinks.into(); "getMetadata" }
+            Operation::Canonicalize => "canonicalize",
+            Operation::Directory => "readDirectory",
+            Operation::CreateDirectory(options) => { request["recursive"] = options.recursive.into(); "createDirectory" }
+        }.into();
+        let upload = match &operation { Operation::Write(bytes) => Some(*bytes), _ => None };
+        let response = self.connection.request(request, upload).await?;
+        let result = self.validate(&operation, response.result, response.bytes, response.chunks);
+        if result.is_err() { self.connection.disconnect(); }
+        result
+    }
+
+    fn validate(&self, operation: &Operation<'_>, result: WireResult, bytes: Vec<u8>, chunks: usize) -> io::Result<FileResponse> {
+        match (operation, result) {
+            (Operation::Read | Operation::Directory, WireResult::Counters(count))
+                if count.bytes == bytes.len() && count.chunks == chunks && chunks == bytes.len().div_ceil(CHUNK_BYTES) => {
+                if matches!(operation, Operation::Read) { return Ok(FileResponse::Bytes(bytes)); }
+                let directory: Directory = decode(&bytes)?;
+                let mut names = HashSet::new();
+                let entries = directory.entries.into_iter().map(|entry| {
+                    if entry.file_name.is_empty() || matches!(entry.file_name.as_str(), "." | "..")
+                        || entry.file_name.contains(['/', '\0']) || entry.is_directory == entry.is_file
+                        || !names.insert(entry.file_name.clone()) {
+                        return Err(invalid("invalid host directory entry"));
+                    }
+                    Ok(crate::ReadDirectoryEntry { file_name: entry.file_name, is_directory: entry.is_directory, is_file: entry.is_file })
+                }).collect::<io::Result<Vec<_>>>()?;
+                Ok(FileResponse::Directory(entries))
+            }
+            (Operation::Metadata(_), WireResult::Metadata(meta)) if meta.is_directory != meta.is_file && !meta.is_symlink => {
+                Ok(FileResponse::Metadata(crate::FileMetadata { is_directory: meta.is_directory, is_file: meta.is_file,
+                    is_symlink: meta.is_symlink, size: meta.size, created_at_ms: meta.created_at_ms, modified_at_ms: meta.modified_at_ms }))
+            }
+            (Operation::Canonicalize, WireResult::Canonical(value)) => {
+                let path = canonical_uri(&value.path)?;
+                if !path.starts_with(&self.connection.workspace_root) { return Err(invalid("host canonical path escapes its workspace")); }
+                Ok(FileResponse::Canonical(path))
+            }
+            (Operation::Write(_) | Operation::CreateDirectory(_), WireResult::Empty(result)) if result.is_empty() => Ok(FileResponse::Done),
+            _ => Err(invalid("host terminal result differs from the requested operation")),
+        }
+    }
+}
+
+use crate::*;
+
+fn host_context(sandbox: Option<&FileSystemSandboxContext>) -> io::Result<()> {
+    if sandbox.is_some() {
+        return Err(io::Error::new(io::ErrorKind::PermissionDenied, "model context cannot select host file authority"));
+    }
+    Ok(())
+}
+
+fn unsupported<'a, T: 'a>(sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, T> {
+    Box::pin(async move {
+        host_context(sandbox)?;
+        Err(io::Error::new(io::ErrorKind::Unsupported, "operation is not provided by host file authority"))
+    })
+}
+
+impl ExecutorFileSystem for HostFileSystemV2 {
+    fn canonicalize<'a>(&'a self, path: &'a PathUri, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, PathUri> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::Canonicalize).await? {
+                FileResponse::Canonical(path) => Ok(path),
+                _ => Err(invalid("expected host canonicalization")),
+            }
+        })
+    }
+
+    fn read_file<'a>(&'a self, path: &'a PathUri, _options: ReadFileOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, Vec<u8>> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            // This authority rejects every symlink structurally. Both options
+            // therefore have identical behavior for its ordinary admitted files.
+            match self.request(path, Operation::Read).await? {
+                FileResponse::Bytes(bytes) => Ok(bytes),
+                _ => Err(invalid("expected host file bytes")),
+            }
+        })
+    }
+
+    fn write_file<'a>(&'a self, path: &'a PathUri, contents: Vec<u8>, _options: WriteFileOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, ()> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::Write(&contents)).await? {
+                FileResponse::Done => Ok(()),
+                _ => Err(invalid("expected host write completion")),
+            }
+        })
+    }
+
+    fn get_metadata<'a>(&'a self, path: &'a PathUri, options: GetMetadataOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, FileMetadata> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::Metadata(options)).await? {
+                FileResponse::Metadata(metadata) => Ok(metadata),
+                _ => Err(invalid("expected host metadata")),
+            }
+        })
+    }
+
+    fn read_directory<'a>(&'a self, path: &'a PathUri, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, Vec<ReadDirectoryEntry>> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::Directory).await? {
+                FileResponse::Directory(entries) => Ok(entries),
+                _ => Err(invalid("expected host directory entries")),
+            }
+        })
+    }
+
+    fn create_directory<'a>(&'a self, path: &'a PathUri, options: CreateDirectoryOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, ()> {
+        Box::pin(async move {
+            host_context(sandbox)?;
+            match self.request(path, Operation::CreateDirectory(options)).await? {
+                FileResponse::Done => Ok(()),
+                _ => Err(invalid("expected host directory creation")),
+            }
+        })
+    }
+
+    fn read_file_stream<'a>(&'a self, _path: &'a PathUri, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, FileSystemReadStream> { unsupported(sandbox) }
+    fn walk<'a>(&'a self, _path: &'a PathUri, _options: WalkOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, WalkOutcome> { unsupported(sandbox) }
+    fn remove<'a>(&'a self, _path: &'a PathUri, _options: RemoveOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, ()> { unsupported(sandbox) }
+    fn copy<'a>(&'a self, _source: &'a PathUri, _destination: &'a PathUri, _options: CopyOptions, sandbox: Option<&'a FileSystemSandboxContext>) -> ExecutorFileSystemFuture<'a, ()> { unsupported(sandbox) }
