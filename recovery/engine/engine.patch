@@ -0,0 +1,88 @@
+"""PC integration launcher: real factory, with a read-only evidence observer."""
+
+import asyncio
+import importlib
+import json
+import os
+from pathlib import Path
+import sys
+
+build, workspace, evidence = map(Path, sys.argv[1:])
+if os.getuid() == 0:
+    raise RuntimeError("The native integration test must run unprivileged")
+sys.path.insert(0, str(build / "package"))
+from tools.executor.exec_server import ExecServer, local_environment_info, serve_stdio
+
+factory = importlib.import_module("tools.executor.bionic-supervisor.factory").factory
+os.chdir(workspace)
+backend = factory(
+    {
+        "helper": str(build / "native-files"),
+        "handleHelper": str(build / "native-file-handle"),
+        "processRunner": str(build / "runner"),
+        "workspace": str(workspace),
+        "executables": {"/usr/bin/bash": "/usr/bin/bash"},
+        "runtime": [
+            {"path": path, "execute": execute}
+            for path, execute in (
+                ("/usr", True),
+                ("/lib", True),
+                ("/lib64", True),
+                ("/etc/ld.so.cache", False),
+            )
+        ],
+        "limits": {"wall_ms": 3000, "output_bytes": 32768},
+        "parentEnvironment": {"PATH": "/usr/bin:/bin", "HOME": str(workspace)},
+    }
+)
+
+
+class ObservedBackend:
+    supported_methods = backend.supported_methods
+    capabilities = backend.capabilities
+
+    def __init__(self):
+        self.calls = []
+        self.records = {}
+
+    async def handle(self, call, notify):
+        self.calls.append({"method": call.method, "params": call.params})
+        try:
+            return await backend.handle(call, notify)
+        finally:
+            # Keep references before normal expiry or close removes the registry.
+            self.records.update(backend.processes.processes)
+
+    async def close(self, session_id):
+        error = None
+        try:
+            await backend.close(session_id)
+        except BaseException as failure:
+            error = repr(failure)
+            raise
+        finally:
+            evidence.write_text(
+                json.dumps(
+                    {
+                        "pid": os.getpid(),
+                        "calls": self.calls,
+                        "closeError": error,
+                        "quarantined": backend.processes.quarantined,
+                        "records": [
+                            {
+                                "key": record.key,
+                                "nativeResult": record.native_result,
+                                "supervisorReturncode": None
+                                if record.process is None
+                                else record.process.returncode,
+                            }
+                            for record in self.records.values()
+                        ],
+                    }
+                )
+            )
+
+
+info = local_environment_info()
+info["shell"] = {"name": "bash", "path": "/usr/bin/bash"}
+asyncio.run(serve_stdio(ExecServer(ObservedBackend(), environment_info=info)))
