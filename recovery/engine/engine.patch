+    std::fs::write(home.path().join("config.toml"), "model = 'user-model'\n")?;
+    let (mut child, address) = spawn(home.path(), "injected").await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+    let response = rpc(
+        &mut client,
+        2,
+        "thread/start",
+        json!({"cwd": cwd, "ephemeral": true, "sandbox": "workspace-write", "approvalPolicy": "never"}),
+    ).await?;
+    assert_eq!(response["model"], json!("child-model"));
+    let saved: toml::Value =
+        toml::from_str(&std::fs::read_to_string(home.path().join("config.toml"))?)?;
+    assert_eq!(
+        saved["projects"][project.to_string_lossy().as_ref()]["trust_level"].as_str(),
+        Some("trusted")
+    );
+    child.kill().await?;
+    Ok(())
+}
+
+#[test_case::test_case(false, None, false; "retain_controller")]
+#[test_case::test_case(true, None, true; "retain_provider")]
+#[test_case::test_case(false, Some(true), true; "select_provider")]
+#[test_case::test_case(true, Some(false), false; "select_controller")]
+#[tokio::test]
+async fn injected_project_config_permission_selection_uses_thread_authority(
+    initial_local: bool,
+    selected_local: Option<bool>,
+    expect_refusal: bool,
+) -> Result<()> {
+    let home = TempDir::new()?;
+    let (project, cwd) = fixture(home.path(), "trusted")?;
+    let server = create_mock_responses_server_repeating_assistant("Selected permissions").await;
+    let project_key = toml::Value::String(project.to_string_lossy().into_owned());
+    MockResponsesConfig::new(&server.uri())
+        .with_extra_config(&format!(
+            "[projects.{project_key}]\ntrust_level = 'trusted'\n"
+        ))
+        .write(home.path())?;
+    let local = json!([{"environmentId": "local", "cwd": cwd}]);
+    let (mut child, address) = spawn(home.path(), "injected").await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+    let started = rpc(
+        &mut client,
+        2,
+        "thread/start",
+        json!({
+            "cwd": cwd,
+            "ephemeral": true,
+            "environments": if initial_local { local.clone() } else { json!([]) }
+        }),
+    )
+    .await?;
+    // The controller's readable copy remains present. The refusal is installed
+    // only after startup to isolate permission selection from thread creation.
+    let project_config = cwd.join(".codex/config.toml");
+    std::fs::write(
+        home.path().join("deny-read"),
+        PathUri::from_host_native_path(&project_config)?.to_string(),
+    )?;
+    let mut params = json!({"threadId": started["thread"]["id"], "permissions": ":workspace"});
+    let method = if let Some(selected_local) = selected_local {
+        params["environments"] = if selected_local { local } else { json!([]) };
+        params["input"] = json!([{"type": "text", "text": "Select the requested permissions"}]);
+        "turn/start"
+    } else {
+        "thread/settings/update"
+    };
+    let result = rpc(&mut client, 3, method, params).await;
+    if expect_refusal {
+        let error = result
+            .expect_err("selected project provider refusal must reach the public settings API");
+        assert!(
+            error
+                .to_string()
+                .contains("bootstrap provider refused read"),
+            "{error}"
+        );
+    } else {
+        result?;
+    }
+    assert_eq!(
+        std::fs::read_to_string(project_config)?,
+        "model = \"child-model\"\n"
+    );
+    child.kill().await?;
+    Ok(())
+}
