+}
+
+#[tokio::test]
+async fn total_read_limit_accepts_exact_boundary_and_rejects_one_more_byte() -> io::Result<()> {
+    for total in [MAX_DATA_BYTES, MAX_DATA_BYTES + 1] {
+        let (filesystem, server) = connected().await?;
+        let path = "file:///scope/file".parse().unwrap();
+        let (result, sent) = deadline(async {
+            tokio::join!(filesystem.bytes(&path), async {
+                server.receive(MAX_PACKET_BYTES).await?;
+                let data = vec![42; CHUNK_BYTES];
+                for (index, offset) in (0..total).step_by(CHUNK_BYTES).enumerate() {
+                    let size = CHUNK_BYTES.min(total - offset);
+                    server
+                        .send(&serde_json::to_vec(&chunk(1, index, &data[..size]))?)
+                        .await?;
+                }
+                if total == MAX_DATA_BYTES {
+                    server
+                        .send(&serde_json::to_vec(&terminal(
+                            1,
+                            total,
+                            total.div_ceil(CHUNK_BYTES),
+                        ))?)
+                        .await?;
+                }
+                io::Result::Ok(())
+            })
+        })
+        .await;
+        sent?;
+        if total == MAX_DATA_BYTES {
+            assert_eq!(result?, vec![42; MAX_DATA_BYTES]);
+        } else {
+            assert_eq!(result.unwrap_err().kind(), io::ErrorKind::InvalidData);
+            assert_closed(&filesystem, &server).await;
+        }
+    }
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn malformed_directory_cannot_admit_a_queued_request_before_validation() -> io::Result<()> {
+    let (filesystem, server) = connected().await?;
+    let directory_filesystem = Arc::clone(&filesystem);
+    let directory = tokio::spawn(async move {
+        directory_filesystem
+            .directory(&"file:///scope".parse().unwrap())
+            .await
+    });
+    deadline(server.receive(MAX_PACKET_BYTES)).await?;
+    let queued_filesystem = Arc::clone(&filesystem);
+    let (waiting, is_waiting) = tokio::sync::oneshot::channel();
+    // Poll the queued call on its own OS thread: Tokio's local LIFO wakeup slot
+    // can otherwise hide the race until the synchronous directory parse returns.
+    let queued = tokio::task::spawn_blocking(move || {
+        tokio::runtime::Handle::current().block_on(async move {
+            let path = "file:///scope/file".parse().unwrap();
+            let mut request = Box::pin(queued_filesystem.bytes(&path));
+            assert!(futures::poll!(&mut request).is_pending());
+            waiting.send(()).unwrap();
+            request.await
+        })
+    });
+    deadline(is_waiting).await.unwrap();
+    // A large real parse exposes the admission race between the wire terminal
+    // and semantic validation on another Tokio worker. Only the final entry is invalid.
+    let mut entries = (0..100_000)
+        .map(|index| {
+            json!({
+                "fileName":format!("entry-{index:06}-padding-to-exercise-directory-validation"),
+                "isDirectory":false,"isFile":true
+            })
+        })
+        .collect::<Vec<_>>();
+    entries.push(json!({"fileName":"..","isDirectory":false,"isFile":true}));
+    let bytes = serde_json::to_vec(&json!({"entries":entries}))?;
+    assert!(bytes.len() <= MAX_DATA_BYTES);
+    for (index, bytes) in bytes.chunks(CHUNK_BYTES).enumerate() {
+        deadline(server.send(&serde_json::to_vec(&chunk(1, index, bytes))?)).await?;
+    }
+    server
+        .send(&serde_json::to_vec(&terminal(
+            1,
+            bytes.len(),
+            bytes.len().div_ceil(CHUNK_BYTES),
+        ))?)
+        .await?;
+    let received = deadline(server.receive(MAX_PACKET_BYTES)).await;
+    // Close the fixture even when a regression admits the queued request, so
+    // all spawned client tasks are joined before reporting the failing assertion.
+    server.shutdown();
+    let directory_error = deadline(directory).await.unwrap().unwrap_err();
+    let queued_error = deadline(queued).await.unwrap().unwrap_err();
+    assert_eq!(directory_error.kind(), io::ErrorKind::InvalidData);
+    assert_eq!(received.unwrap_err().kind(), io::ErrorKind::UnexpectedEof);
+    assert_eq!(queued_error.kind(), io::ErrorKind::BrokenPipe);
+    Ok(())
+}
+
+#[tokio::test]
+async fn cancelling_active_request_closes_channel_and_prevents_response_reuse() -> io::Result<()> {
+    let (filesystem, server) = connected().await?;
+    let request_filesystem = Arc::clone(&filesystem);
+    let request = tokio::spawn(async move {
+        request_filesystem
+            .bytes(&"file:///scope/file".parse().unwrap())
+            .await
+    });
+    deadline(server.receive(MAX_PACKET_BYTES)).await?;
+    server
+        .send(&serde_json::to_vec(&chunk(1, 0, b"partial"))?)
+        .await?;
+    request.abort();
+    assert!(deadline(request).await.unwrap_err().is_cancelled());
+    assert_closed(&filesystem, &server).await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn cancelling_mutex_waiter_preserves_active_request_and_identifier_sequence() -> io::Result<()>
+{
+    let (filesystem, server) = connected().await?;
+    let path = "file:///scope/file".parse().unwrap();
+    let mut active = Box::pin(filesystem.bytes(&path));
+    deadline(async {
+        tokio::select! {
+            result = &mut active => panic!("read completed before its response: {result:?}"),
+            request = server.receive(MAX_PACKET_BYTES) => request,
+        }
+    })
+    .await?;
+    let mut queued = Box::pin(filesystem.bytes(&path));
+    assert!(futures::poll!(&mut queued).is_pending());
+    drop(queued);
+    server
+        .send(&serde_json::to_vec(&terminal(1, 0, 0))?)
+        .await?;
+    assert_eq!(deadline(active).await?, Vec::<u8>::new());
+    let (result, sent) = deadline(async {
+        tokio::join!(filesystem.bytes(&path), async {
+            let request: Value = serde_json::from_slice(&server.receive(MAX_PACKET_BYTES).await?)?;
+            assert_eq!(request, json!({"id":2,"op":"readFile","path":path}));
+            server
+                .send(&serde_json::to_vec(&chunk(2, 0, b"\0\xffbinary"))?)
+                .await?;
+            server.send(&serde_json::to_vec(&terminal(2, 8, 1))?).await
+        })
+    })
+    .await;
+    sent?;
+    assert_eq!(result?, b"\0\xffbinary");
+    Ok(())
+}
+
+#[tokio::test]
+async fn disconnect_during_stream_never_exposes_unvalidated_prefix() -> io::Result<()> {
+    let (filesystem, server) = connected().await?;
+    let path = "file:///scope/file".parse().unwrap();
+    let (result, sent) = deadline(async {
+        tokio::join!(
+            filesystem.read_file_stream(&path, /*sandbox*/ None),
+            async {
+                server.receive(MAX_PACKET_BYTES).await?;
+                server
+                    .send(&serde_json::to_vec(&chunk(1, 0, b"prefix"))?)
+                    .await?;
+                server.shutdown();
+                io::Result::Ok(())
+            }
+        )
+    })
+    .await;
+    sent?;
+    assert_eq!(result.err().unwrap().kind(), io::ErrorKind::UnexpectedEof);
+    assert_closed(&filesystem, &server).await;
+    Ok(())
+}
