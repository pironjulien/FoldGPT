+#[tokio::test]
+async fn injected_command_exec_uses_runtime_environment_and_exact_null_removals() -> Result<()> {
+    let home = TempDir::new()?;
+    std::fs::write(home.path().join("command-runtime"), "executor")?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        "default_permissions = ':danger-full-access'\n[shell_environment_policy]\ninherit = 'all'\n",
+    )?;
+    let native_home = home.path().join("native-home");
+    let native_temp = home.path().join("native-temp");
+    let snapshot = json!({
+        "PATH":"/actual-runtime/bin", "HOME":native_home, "TMPDIR":native_temp,
+        "MixedName":"remove-only-this-case", "MIXEDNAME":"keep-other-case",
+        "STAR*VAR":"remove-only-this-name", "STAR_OTHER_VAR":"keep-other-name"
+    });
+    std::fs::write(
+        home.path().join("parent-environment.json"),
+        serde_json::to_vec(&snapshot)?,
+    )?;
+    let (mut child, address) = spawn(home.path(), "injected").await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+    let response = rpc(&mut client, 2, "command/exec", json!({
+        "command":["/bin/sh","-c","printf '%s|%s|%s|%s' \"$PATH\" \"$HOME\" \"$TMPDIR\" \"$MIXEDNAME\""],
+        "cwd":home.path(), "permissionProfile":":danger-full-access",
+        "env":{"MixedName":null,"STAR*VAR":null}
+    })).await?;
+    assert_eq!(
+        response,
+        json!({"exitCode":0,"stderr":"","stdout":format!(
+            "/actual-runtime/bin|{}|{}|keep-other-case", native_home.display(), native_temp.display()
+        )})
+    );
+    let recorded: ExecParams =
+        serde_json::from_slice(&std::fs::read(home.path().join("command-record.json"))?)?;
+    assert!(!recorded.env.contains_key("MixedName"));
+    assert!(!recorded.env.contains_key("STAR*VAR"));
+    assert_eq!(
+        recorded.env.get("STAR_OTHER_VAR").map(String::as_str),
+        Some("keep-other-name")
+    );
+    child.kill().await?;
+    Ok(())
