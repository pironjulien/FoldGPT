+//! Public host-file JSON-RPC with separate native and controller authorities.
+use anyhow::{Context, Result};
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use codex_utils_path_uri::PathUri;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::TempDir;
+
+use super::connection_handling_websocket::connect_websocket;
+use super::injected_local_runtime::{initialize, rpc, spawn};
+
+#[tokio::test]
+async fn public_host_files_keep_native_refusals_and_explicit_controller_roots() -> Result<()> {
+    let home = TempDir::new()?;
+    let native = home.path().join("native-files");
+    let controller = home.path().join("controller-files");
+    std::fs::create_dir(&native)?;
+    std::fs::create_dir(&controller)?;
+    std::fs::write(native.join("denied.txt"), b"native refused, controller can read")?;
+    std::fs::write(controller.join("attachment"), b"controller attachment")?;
+    std::fs::write(home.path().join("outside"), b"ungranted path")?;
+    // The host-native provider would reject this path if routing sent it there.
+    std::fs::write(native.join("deny-read"), PathUri::from_host_native_path(controller.join("attachment"))?.to_string())?;
+    let (mut child, address) = spawn(home.path(), "host-files").await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+    let file = native.join("project.py");
+    assert_eq!(rpc(&mut client, 2, "fs/writeFile", json!({"path":file,"dataBase64":STANDARD.encode(b"answer = 42\n\0")})).await?, json!({}));
+    assert_eq!(std::fs::read(&file)?, b"answer = 42\n\0");
+    let read = rpc(&mut client, 3, "fs/readFile", json!({"path":file})).await?;
+    assert_eq!(STANDARD.decode(read["dataBase64"].as_str().context("actual native bytes")?)?, std::fs::read(&file)?);
+    assert_eq!(std::fs::read_to_string(native.join("provider-read"))?, PathUri::from_host_native_path(&file)?.to_string());
+    let error = rpc(&mut client, 4, "fs/readFile", json!({"path":native.join("denied.txt")})).await.expect_err("no fallback after native refusal");
+    assert!(error.to_string().contains("bootstrap provider refused read"), "{error}");
+    std::fs::write(native.join("deny-write"), PathUri::from_host_native_path(&file)?.to_string())?;
+    let error = rpc(&mut client, 5, "fs/writeFile", json!({"path":file,"dataBase64":STANDARD.encode(b"must not write")})).await.expect_err("no write fallback");
+    assert!(error.to_string().contains("bootstrap provider refused write"), "{error}");
+    assert_eq!(std::fs::read(&file)?, b"answer = 42\n\0");
+    let attachment = rpc(&mut client, 6, "fs/readFile", json!({"path":controller.join("attachment")})).await?;
+    assert_eq!(STANDARD.decode(attachment["dataBase64"].as_str().context("actual controller bytes")?)?, b"controller attachment");
+    let error = rpc(&mut client, 7, "fs/readFile", json!({"path":home.path().join("outside")})).await.expect_err("ungranted root");
+    assert!(error.to_string().contains("outside the bootstrap-owned host file roots"), "{error}");
+    let destination = controller.join("copied");
+    let error = rpc(&mut client, 8, "fs/copy", json!({"sourcePath":file,"destinationPath":destination,"recursive":false})).await.expect_err("cross-authority copy must be explicit");
+    assert!(error.to_string().contains("distinct host file authorities"), "{error}");
+    assert!(!destination.exists());
+    let info = rpc(&mut client, 9, "environment/info", json!({"environmentId":"local"})).await?;
+    assert_eq!(info["cwd"], json!(PathUri::from_host_native_path(home.path().join("runtime-home"))?));
+    assert_eq!(rpc(&mut client, 12, "fs/createDirectory", json!({"path":native.join("created"),"recursive":false})).await?, json!({}));
+    assert_eq!(rpc(&mut client, 13, "fs/readDirectory", json!({"path":native.join("created")})).await?, json!({"entries":[]}));
+    let metadata = rpc(&mut client, 14, "fs/getMetadata", json!({"path":file})).await?;
+    assert_eq!((metadata["isFile"].clone(), metadata["isDirectory"].clone(), metadata["isSymlink"].clone()),
+        (json!(true), json!(false), json!(false)));
+    #[cfg(unix)]
+    {
+        std::os::unix::fs::symlink(&native, controller.join("native-alias"))?;
+        let error = rpc(&mut client, 10, "fs/writeFile", json!({"path":controller.join("native-alias/project.py"),"dataBase64":STANDARD.encode(b"alias must not bypass owner")})).await.expect_err("alias into native workspace");
+        assert!(error.to_string().contains("alias crosses file authorities"), "{error}");
+        std::os::unix::fs::symlink(native.join("new-file"), controller.join("dangling"))?;
+        let error = rpc(&mut client, 11, "fs/writeFile", json!({"path":controller.join("dangling"),"dataBase64":STANDARD.encode(b"must not create through alias")})).await.expect_err("dangling alias cannot select controller");
+        assert!(error.to_string().contains("unresolved controller symlink"), "{error}");
+        assert_eq!(std::fs::read(&file)?, b"answer = 42\n\0");
+        assert!(!native.join("new-file").exists());
+    }
+    child.kill().await?;
+    child.wait().await?;
+    Ok(())
+}
