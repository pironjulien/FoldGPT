+"""PC test owner: real native factory and credentialed configuration channel.
+
+Only Responses SSE is supplied by a model test fixture. This owner observes and
+forwards actual requests; it neither implements commands nor changes policy.
+"""
+
+import asyncio
+import hashlib
+import importlib
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import sys
+
+package, helpers, runner, binary, home, workspace, output, address = sys.argv[1:]
+home, workspace, output = map(Path, (home, workspace, output))
+if os.getuid() == 0:
+    raise RuntimeError("Native app-server qualification requires a nonroot owner")
+manifest_path = Path(helpers) / "manifest.json"
+manifest_bytes = manifest_path.read_bytes()
+snapshot_files = json.loads(manifest_bytes)["files"]
+for entry in snapshot_files:
+    path = Path(helpers) / entry["path"]
+    data = path.read_bytes()
+    if (
+        len(data) != entry["bytes"]
+        or hashlib.sha256(data).hexdigest() != entry["sha256"]
+    ):
+        raise RuntimeError(f"Native helper snapshot mismatch: {path}")
+sys.path.insert(0, package)
+from tools.executor.exec_server import ExecServer, local_environment_info, serve_stdio
+from tools.executor.native_bootstrap_files import create_bootstrap_read_authority
+from tools.executor.native_bootstrap_channel import BootstrapReadChannel
+
+factory = importlib.import_module("tools.executor.bionic-supervisor.factory").factory
+process_module = importlib.import_module("tools.executor.bionic-supervisor.processes")
+native_decisions = []
+
+
+class ObservedPolicy(process_module.Policy):
+    def decide(self, request):
+        decision = super().decide(request)
+        native_decisions.append({"request": request, "decision": decision})
+        return decision
+
+
+process_module.Policy = ObservedPolicy
+backend = factory(
+    {
+        "helper": str(Path(helpers) / "native-files"),
+        "handleHelper": str(Path(helpers) / "native-file-handle"),
+        "processRunner": runner,
+        "workspace": str(workspace),
+        "executables": {"/usr/bin/bash": "/usr/bin/bash"},
+        "runtime": [
+            {"path": path, "execute": execute}
+            for path, execute in (
+                ("/usr", True),
+                ("/lib", True),
+                ("/lib64", True),
+                ("/etc/ld.so.cache", False),
+            )
+        ],
+        "parentEnvironment": {"PATH": "/usr/bin:/bin", "HOME": str(workspace)},
+    }
+)
+native_read, engine_write = os.pipe()
+engine_read, native_write = os.pipe()
+session_read, session_write = os.pipe()
+native_socket, engine_socket = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET)
+for endpoint in (native_socket, engine_socket):
+    endpoint.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
+
+environment = {
+    "PATH": "/usr/bin:/bin",
+    "HOME": str(home),
+    "CODEX_HOME": str(home),
+    "RUST_MIN_STACK": "8388608",
+    "FOLDGPT_NATIVE_TEST_LISTEN": address,
+    "FOLDGPT_NATIVE_TEST_WORKSPACE": str(workspace),
+    "FOLDGPT_NATIVE_TEST_OUTPUT": str(output),
+    "FOLDGPT_NATIVE_TEST_FDS": json.dumps(
+        [engine_read, engine_write, engine_socket.fileno(), session_read]
+    ),
+    "FOLDGPT_NATIVE_TEST_PEER": json.dumps([os.getpid(), os.getuid(), os.getgid()]),
+}
+child = subprocess.Popen(
+    [
+        binary,
+        "--ignored",
+        "--exact",
+        "suite::v2::native_app_server::bootstrap_child",
+        "--nocapture",
+    ],
+    pass_fds=(engine_read, engine_write, engine_socket.fileno(), session_read),
+    stdin=subprocess.DEVNULL,
+    stdout=(output / "app-server.stdout").open("wb"),
+    stderr=(output / "app-server.stderr").open("wb"),
+    env=environment,
+    cwd=home,
+)
+engine_socket.close()
+for descriptor in (engine_read, engine_write, session_read):
+    os.close(descriptor)
+with Path(binary).open("rb") as test_binary:
+    test_binary_hash = hashlib.file_digest(test_binary, "sha256").hexdigest()
+(output / "owner-ready.json").write_text(
+    json.dumps(
+        {
+            "ownerPid": os.getpid(),
+            "appServerPid": child.pid,
+            "uid": os.getuid(),
+            "gid": os.getgid(),
+            "fixtureSha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+            "testBinarySha256": test_binary_hash,
+            "scope": "PC shared paths; real native execution; model responses are SSE fixtures",
+            "snapshotManifestSha256": hashlib.sha256(manifest_bytes).hexdigest(),
+            "snapshotFiles": snapshot_files,
+            "loadedPython": {
+                module.__file__: hashlib.sha256(
+                    Path(module.__file__).read_bytes()
+                ).hexdigest()
+                for module in tuple(sys.modules.values())
+                if getattr(module, "__file__", None)
+                and Path(module.__file__).is_relative_to(package)
+            },
+            "binaries": {
+                str(path): hashlib.sha256(Path(path).read_bytes()).hexdigest()
+                for path in (
+                    runner,
+                    str(Path(helpers) / "native-files"),
+                    str(Path(helpers) / "native-file-handle"),
+                )
+            },
+        }
+    )
+)
+
+
+class ObservedBackend:
+    supported_methods = backend.supported_methods
+    capabilities = backend.capabilities
+
+    def __init__(self):
+        self.calls, self.records, self.close_error = [], {}, None
+
+    async def handle(self, call, notify):
+        entry = {"method": call.method, "params": call.params}
+        self.calls.append(entry)
+        try:
+            result = await backend.handle(call, notify)
+            entry["result"] = result
+            return result
+        except BaseException as error:
+            entry["error"] = str(error)
+            raise
+        finally:
+            self.records.update(backend.processes.processes)
+
+    async def close(self, session_id):
+        try:
+            await backend.close(session_id)
+        except BaseException as error:
+            self.close_error = repr(error)
+            raise
+
+
+class ObservedChannel(BootstrapReadChannel):
+    async def _respond(self, request, phase):
+        bootstrap_calls.append(request)
+        await super()._respond(request, phase)
+
+
+class OwnedServer(ExecServer):
+    async def request(self, message):
+        result = await super().request(message)
+        if (
+            message.get("method") == "initialize"
+            and self.session_id
+            and not self.bootstrap_task
+        ):
+            authority = create_bootstrap_read_authority(
+                backend, session_id=self.session_id
+            )
+            channel = ObservedChannel(
+                native_socket, authority, peer=(child.pid, os.getuid(), os.getgid())
+            )
+            self.bootstrap_task = asyncio.create_task(channel.run())
+            with os.fdopen(session_write, "w") as pipe:
+                pipe.write(self.session_id + "\n")
+        return result
+
+    async def close(self):
+        if self.bootstrap_task is not None:
+            await self.bootstrap_task
+        await super().close()
+
+
+observed, bootstrap_calls = ObservedBackend(), []
+os.chdir(workspace)
+info = local_environment_info()
+info["shell"] = {"name": "bash", "path": "/usr/bin/bash"}
+server = OwnedServer(observed, environment_info=info)
+server.bootstrap_task = None
+error = None
+try:
+    with (
+        os.fdopen(native_read, "rb", buffering=0) as reader,
+        os.fdopen(native_write, "wb", buffering=0) as writer,
+    ):
+        asyncio.run(serve_stdio(server, reader, writer))
+except BaseException as failure:
+    error = repr(failure)
+    raise
+finally:
+    returncode = child.wait(timeout=30)
+    (output / "native-evidence.json").write_text(
+        json.dumps(
+            {
+                "ownerPid": os.getpid(),
+                "appServerPid": child.pid,
+                "appServerReturncode": returncode,
+                "error": error,
+                "closeError": observed.close_error,
+                "calls": observed.calls,
+                "bootstrapCalls": bootstrap_calls,
+                "nativeDecisions": native_decisions,
+                "filesClosed": backend.files.closed,
+                "helperGone": backend.files.process is None,
+                "quarantined": backend.processes.quarantined,
+                "records": [
+                    {
+                        "key": record.key,
+                        "nativeResult": record.native_result,
+                        "supervisorReturncode": None
+                        if record.process is None
+                        else record.process.returncode,
+                    }
+                    for record in observed.records.values()
+                ],
+            },
+            indent=2,
+        )
+    )
+if returncode:
+    raise SystemExit(returncode)
