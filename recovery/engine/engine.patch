+        );
+        drop(channels);
+        assert_eq!(
+            peer.finish().await?,
+            serde_json::json!({"lifetimeClosed":true})
+        );
+        anyhow::Ok(())
+    })
+    .await??;
+    Ok(())
+}
+
+#[tokio::test]
+async fn cancelled_acquisition_closes_its_admitted_connection() -> anyhow::Result<()> {
+    tokio::time::timeout(Duration::from_secs(15), async {
+        let mut peer = Peer::spawn("stall").await?;
+        let path = peer.started.socket.clone();
+        let identity = peer.identity();
+        let root = PathUri::from_host_native_path(peer.root.path())?;
+        let acquiring = tokio::spawn(async move {
+            NativeRuntimeChannels::acquire(std::path::Path::new(&path), identity, root).await
+        });
+        let mut admitted = String::new();
+        peer.output.read_line(&mut admitted).await?;
+        assert_eq!(admitted, "admitted\n");
+        acquiring.abort();
+        assert!(
+            acquiring
+                .await
+                .err()
+                .expect("acquisition task cancelled")
+                .is_cancelled()
+        );
+        assert_eq!(
+            peer.finish().await?,
+            serde_json::json!({"cancelClosed":true})
+        );
+        anyhow::Ok(())
+    })
+    .await??;
+    Ok(())
+}
