+#[tokio::test]
+async fn native_host_launch_refusal_never_runs_controller_and_handle_can_be_reused() -> Result<()> {
+    let home = TempDir::new()?;
+    let path = home.path().join("must-not-exist");
+    let (mut child, address) = spawn(home.path(), "host-process").await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+    let error = rpc(&mut client, 2, "process/spawn", json!({
+        "command":["sh","-c","printf bypass > \"$1\"","sh",path], "cwd":"/", "processHandle":"refusal",
+        "env":{"FOLDGPT_TEST_HOST_PROCESS_REFUSAL":"1"}
+    })).await.expect_err("native refusal must be final");
+    assert!(error.to_string().contains("native host process owner refused launch"), "{error}");
+    assert!(!path.exists());
+    assert_eq!(rpc(&mut client, 3, "process/spawn", json!({"command":["sh","-c","exit 17"],
+        "cwd":"/", "processHandle":"refusal"})).await?, json!({}));
+    assert_eq!(output(&mut client, "refusal").await?.2["exitCode"], 17);
