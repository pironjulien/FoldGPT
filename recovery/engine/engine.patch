diff --git a/codex-rs/exec-server/src/host_v2_processes.rs b/codex-rs/exec-server/src/host_v2_processes.rs
new file mode 100644
index 0000000000000000000000000000000000000000..dc7407b300787239875563d59a2478e6aa33743b
--- /dev/null
+++ b/codex-rs/exec-server/src/host_v2_processes.rs
@@ -0,0 +1,166 @@
+//! Real human process driver over multiplexed, bounded native requests.
+use std::collections::HashMap;
+use std::io;
+use std::sync::Arc;
+
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_pty::{OwnedProcessController, OwnedProcessDriver, ProcessSignal, SpawnedProcess, TerminalSize};
+use tokio::sync::{mpsc, oneshot};
+use tokio_util::sync::CancellationToken;
+
+use super::{HostConnectionV2, Response, invalid};
+use super::protocol::{CHUNK_BYTES, ProcessEvent, WireResult};
+
+/// Actual human argv/cwd/environment. The public app server owns its requested
+/// timeout/capture cap; this transport never substitutes a hidden default.
+pub struct HostProcessCommandV2 {
+    pub command: Vec<String>,
+    pub cwd: AbsolutePathBuf,
+    pub environment: HashMap<String, String>,
+    pub tty: bool,
+    pub stream_stdin: bool,
+    pub size: Option<TerminalSize>,
+}
+
+struct ProcessState { connection: Arc<HostConnectionV2>, process_id: String, done: CancellationToken }
+
+impl ProcessState {
+    async fn empty_request(&self, op: &str, data: Option<(&[u8], bool)>) -> io::Result<()> {
+        let mut request = serde_json::json!({"op":op,"processId":self.process_id});
+        if let Some((bytes, close_stdin)) = data {
+            request["dataBase64"] = STANDARD.encode(bytes).into();
+            request["closeStdin"] = close_stdin.into();
+        }
+        let Response { result, bytes, chunks } = self.connection.request(request, None).await?;
+        if matches!(result, WireResult::Empty(ref empty) if empty.is_empty()) && bytes.is_empty() && chunks == 0 { return Ok(()); }
+        self.connection.invalid_response("native host control returned an invalid result")
+    }
+
+    async fn terminate(&self) {
+        if self.done.is_cancelled() { return; }
+        if let Err(error) = self.empty_request("processTerminate", None).await {
+            if !self.done.is_cancelled() {
+                tracing::warn!(%error, "native human process cancellation failed");
+                self.connection.disconnect();
+            }
+        }
+    }
+}
+
+struct Controller { commands: mpsc::Sender<()>, state: Arc<ProcessState> }
+impl OwnedProcessController for Controller {
+    fn signal(&mut self, _signal: ProcessSignal) -> io::Result<()> {
+        Err(io::Error::new(io::ErrorKind::Unsupported, "human process v2 has no interrupt operation"))
+    }
+    fn request_terminate(&mut self) -> io::Result<()> {
+        if self.state.done.is_cancelled() { return Ok(()); }
+        self.commands.try_send(()).map_err(|error| io::Error::new(io::ErrorKind::WouldBlock, error.to_string()))
+    }
+    fn resize(&mut self, _size: TerminalSize) -> anyhow::Result<()> {
+        Err(anyhow::anyhow!("human process v2 does not provide a PTY"))
+    }
+}
+
+impl HostConnectionV2 {
+    pub async fn spawn(self: &Arc<Self>, command: HostProcessCommandV2) -> io::Result<SpawnedProcess> {
+        if command.tty || command.size.is_some() {
+            return Err(io::Error::new(io::ErrorKind::Unsupported, "native human PTY is not provided by version 2"));
+        }
+        if command.command.is_empty() { return Err(io::Error::new(io::ErrorKind::InvalidInput, "empty human process command")); }
+        let pipe_stdin = command.stream_stdin;
+        let Response { result, bytes, chunks } = self.request(serde_json::json!({"op":"processStart",
+            "command":command.command,"cwd":command.cwd,"environment":command.environment,"pipeStdin":pipe_stdin}), None).await?;
+        let WireResult::Started(started) = result else { return self.invalid_response("native human start has no real process identity") };
+        if !bytes.is_empty() || chunks != 0 || started.process_id.len() != 32
+            || !started.process_id.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte)) {
+            return self.invalid_response("native human start identity is malformed");
+        }
+        let state = Arc::new(ProcessState { connection: Arc::clone(self), process_id: started.process_id, done: CancellationToken::new() });
+        let (writer_tx, mut writer_rx) = mpsc::channel::<Vec<u8>>(32);
+        let writer = Arc::clone(&state);
+        let writer_handle = tokio::spawn(async move {
+            while let Some(data) = tokio::select! { data = writer_rx.recv() => data, _ = writer.done.cancelled() => None } {
+                for bytes in data.chunks(CHUNK_BYTES) {
+                    if let Err(error) = writer.empty_request("processWrite", Some((bytes, false))).await {
+                        tracing::debug!(%error, "human stdin stream ended");
+                        writer.terminate().await;
+                        return;
+                    }
+                }
+            }
+            if pipe_stdin && !writer.done.is_cancelled()
+                && let Err(error) = writer.empty_request("processWrite", Some((&[], true))).await {
+                tracing::debug!(%error, "human stdin EOF was refused");
+                writer.terminate().await;
+            }
+        });
+        let (command_tx, mut command_rx) = mpsc::channel::<()>(32);
+        let controller = Arc::clone(&state);
+        tokio::spawn(async move {
+            loop {
+                let command = tokio::select! { command = command_rx.recv() => command, _ = controller.done.cancelled() => break };
+                controller.terminate().await;
+                if command.is_none() { break; }
+            }
+        });
+        let (stdout_tx, stdout_rx) = mpsc::channel(32);
+        let (stderr_tx, stderr_rx) = mpsc::channel(32);
+        let (exit_tx, exit_rx) = oneshot::channel();
+        let output = Arc::clone(&state);
+        tokio::spawn(async move {
+            let result = pump(&output, &stdout_tx, &stderr_tx).await;
+            output.done.cancel();
+            drop(stdout_tx);
+            drop(stderr_tx);
+            match result {
+                Ok(exit_code) => { let _ = exit_tx.send(exit_code); }
+                Err(error) => {
+                    tracing::warn!(%error, "native human process stream failed");
+                    output.connection.disconnect();
+                    // No successful exit is invented; the standard adapter
+                    // treats a dropped status channel as a failed process.
+                }
+            }
+        });
+        Ok(codex_utils_pty::spawn_from_owned_driver(OwnedProcessDriver {
+            writer_tx, stdout_rx, stderr_rx, exit_rx,
+            controller: Box::new(Controller { commands: command_tx, state }),
+            writer_handle: Some(writer_handle),
+        }))
+    }
+}
+
+async fn pump(state: &ProcessState, stdout: &mpsc::Sender<Vec<u8>>, stderr: &mpsc::Sender<Vec<u8>>) -> io::Result<i32> {
+    let mut next_seq = 1;
+    let mut exit_code = None;
+    let mut discarding = false;
+    loop {
+        let Response { result, bytes, chunks } = state.connection.request(
+            serde_json::json!({"op":"processRead","processId":state.process_id}), None).await?;
+        if !bytes.is_empty() || chunks != 0 { return Err(invalid("human event contains unexpected file chunks")); }
+        let WireResult::Event(envelope) = result else { return Err(invalid("human process read lacks its typed event")) };
+        let seq = match &envelope.event { ProcessEvent::Output { seq, .. } | ProcessEvent::Exited { seq, .. } | ProcessEvent::Closed { seq, .. } => *seq };
+        if seq != next_seq { return Err(invalid("native human event sequence changed")); }
+        next_seq = next_seq.checked_add(1).ok_or_else(|| invalid("human event sequence exhausted"))?;
+        match envelope.event {
+            ProcessEvent::Output { stream, data_base64, .. } => {
+                let bytes = STANDARD.decode(&data_base64).map_err(invalid)?;
+                if bytes.is_empty() || bytes.len() > CHUNK_BYTES || STANDARD.encode(&bytes) != data_base64 { return Err(invalid("invalid human process output chunk")); }
+                let sender = match stream.as_str() { "stdout" => stdout, "stderr" => stderr, _ => return Err(invalid("invalid human output stream")) };
+                if !discarding && sender.send(bytes).await.is_err() {
+                    discarding = true;
+                    state.terminate().await;
+                }
+            }
+            ProcessEvent::Exited { exit_code: code, .. } => {
+                if exit_code.replace(code).is_some() { return Err(invalid("duplicate native human exit")); }
+            }
+            ProcessEvent::Closed { failure, .. } => {
+                if let Some(failure) = failure { return Err(io::Error::other(failure)); }
+                return exit_code.ok_or_else(|| invalid("human process closed without an actual exit"));
+            }
+        }
+    }
+}
diff --git a/codex-rs/exec-server/src/host_v2_protocol.rs b/codex-rs/exec-server/src/host_v2_protocol.rs
