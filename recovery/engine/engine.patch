+}
+
+async fn request(
+    client: &mut WsClient,
+    id: i64,
+    method: &str,
+    params: Value,
+    events: &mut Vec<Value>,
+) -> Result<Value> {
+    send_request(client, method, id, Some(params)).await?;
+    timeout(WAIT, async {
+        loop {
+            let message = read_jsonrpc_message(client).await?;
+            events.push(serde_json::to_value(&message)?);
+            match message {
+                JSONRPCMessage::Response(response) if response.id == RequestId::Integer(id) => {
+                    return Ok(response.result);
+                }
+                JSONRPCMessage::Error(error) if error.id == RequestId::Integer(id) => {
+                    bail!("{}", error.error.message)
+                }
+                _ => {}
+            }
+        }
+    })
+    .await?
+}
+
+fn command(call: &str, text: &str) -> Value {
+    ev_function_call(
+        call,
+        "exec_command",
+        &json!({"cmd": text, "login": false, "yield_time_ms": 10000, "max_output_tokens": 3000})
+            .to_string(),
+    )
+}
+
+fn copy_tree(from: &Path, to: &Path) -> Result<()> {
+    std::fs::create_dir_all(to)
+        .with_context(|| format!("create evidence directory {}", to.display()))?;
+    for entry in std::fs::read_dir(from)? {
+        let entry = entry?;
+        let kind = entry.file_type()?;
+        anyhow::ensure!(!kind.is_symlink(), "unexpected evidence symlink");
+        if kind.is_dir() {
+            copy_tree(&entry.path(), &to.join(entry.file_name()))?;
+        } else {
+            // Evidence lives on the Windows project volume. Copy exact bytes
+            // without trying to apply Linux ownership/mode bits to that volume.
+            let mut source = std::fs::File::open(entry.path())?;
+            let mut target = std::fs::File::create(to.join(entry.file_name()))?;
+            std::io::copy(&mut source, &mut target).with_context(|| {
+                format!(
+                    "copy evidence {} to {}",
+                    entry.path().display(),
+                    to.display()
+                )
+            })?;
+        }
+    }
+    Ok(())
+}
+
+/// Requires supplied immutable helpers; never skips missing prerequisites or
+/// substitutes the ordinary PC Environment. No Android operations are involved.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "requires real FOLDGPT_NATIVE_TEST_HELPERS, RUNNER and ARTIFACTS paths"]
+async fn real_native_app_server_python_project() -> Result<()> {
+    let helpers = PathBuf::from(
