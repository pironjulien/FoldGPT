new file mode 100644
index 0000000000000000000000000000000000000000..faa200507044abb07d9c931352f48398917a8f85
--- /dev/null
+++ b/codex-rs/exec-server/src/host_files.rs
@@ -0,0 +1,239 @@
+//! Connection-owned host file authority, never the model's filesystem provider.
+
+use std::collections::HashSet;
+use std::io;
+use std::os::fd::AsRawFd;
+use std::os::fd::OwnedFd;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use codex_utils_path_uri::PathUri;
+use tokio::sync::Semaphore;
+
+use crate::bootstrap_files_socket::{BootstrapPeer, CredentialedSocket};
+
+#[path = "host_files_protocol.rs"]
+mod protocol;
+use protocol::*;
+
+/// Host/UI authority supplied by the native owner over a private, separate FD.
+///
+/// Possession belongs to trusted host bootstrap; no model request or environment
+/// selector creates this authority. Never install it in `Environment` or expose
+/// it through the model's filesystem getter. Native ownership, leases, quarantine
+/// and helper reaping remain with the server. Disconnect is not cleanup proof.
+pub struct HostFileSystem {
+    socket: CredentialedSocket,
+    workspace_root: PathUri,
+    session_id: String,
+    next_id: AtomicU64,
+    request_slot: Semaphore,
+    closed: AtomicBool,
+}
+
+#[derive(Clone, Copy)]
+pub(super) enum Operation<'a> {
+    Read,
+    Write(&'a [u8]),
+    Metadata(crate::GetMetadataOptions),
+    Canonicalize,
+    Directory,
+    CreateDirectory(crate::CreateDirectoryOptions),
+}
+
+pub(super) enum Response {
+    Bytes(Vec<u8>),
+    Metadata(crate::FileMetadata),
+    Canonical(PathUri),
+    Directory(Vec<crate::ReadDirectoryEntry>),
+    Done,
+}
+
+impl HostFileSystem {
+    /// Consume an anonymous socketpair endpoint and authenticate every packet.
+    /// Enable SO_PASSCRED on both endpoints before handoff/peer transmission.
+    pub async fn connect(descriptor: OwnedFd, peer: BootstrapPeer, expected_session: &str) -> io::Result<Arc<Self>> {
+        if expected_session.is_empty() || expected_session.len() > 128 {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "invalid host files session identity"));
+        }
+        for query in [libc::getsockname, libc::getpeername] {
+            let mut address: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+            let mut length = std::mem::size_of_val(&address) as libc::socklen_t;
+            // SAFETY: query fills the live owned socket's bounded address buffer.
+            if unsafe { query(descriptor.as_raw_fd(), (&raw mut address).cast(), &raw mut length) } != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            if address.sun_family != libc::AF_UNIX as libc::sa_family_t
+                || length as usize != std::mem::size_of::<libc::sa_family_t>() {
+                return Err(io::Error::new(io::ErrorKind::InvalidInput, "host files requires an anonymous socketpair"));
+            }
+        }
+        let socket = CredentialedSocket::new(descriptor, peer)?;
+        let ready: Ready = decode(&socket.receive(MAX_PACKET_BYTES).await?)?;
+        if ready.kind != "ready" || ready.schema != SCHEMA || ready.session_id != expected_session
+            || ready.chunk_bytes != CHUNK_BYTES || ready.max_data_bytes != MAX_DATA_BYTES
+            || ready.max_packet_bytes != MAX_PACKET_BYTES || ready.operations != OPERATIONS {
+            return Err(invalid("host files handshake differs from its owned session or protocol"));
+        }
+        let workspace_root = canonical_uri(&ready.workspace_root)?;
+        Ok(Arc::new(Self { socket, workspace_root, session_id: ready.session_id,
+            next_id: AtomicU64::new(1), request_slot: Semaphore::new(1), closed: AtomicBool::new(false) }))
+    }
+
+    pub fn workspace_root(&self) -> &PathUri { &self.workspace_root }
+    pub fn session_id(&self) -> &str { &self.session_id }
+
+    pub fn disconnect(&self) {
+        self.closed.store(true, Ordering::Release);
+        self.request_slot.close();
+        self.socket.shutdown();
+    }
+
+    async fn request(&self, path: &PathUri, operation: Operation<'_>) -> io::Result<Response> {
+        if canonical_uri(&path.to_string())? != *path || !path.starts_with(&self.workspace_root) {
+            return Err(io::Error::new(io::ErrorKind::PermissionDenied, "host path is outside its workspace"));
+        }
+        if matches!(&operation, Operation::Write(bytes) if bytes.len() > MAX_DATA_BYTES) {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "host write exceeds the admitted data bound"));
+        }
+        let _permit = self.request_slot.acquire().await.map_err(|_| closed())?;
+        if self.closed.load(Ordering::Acquire) { return Err(closed()); }
+        // Drop order is intentional: revoke the channel before releasing admission
+        // if validation, I/O or the calling future is interrupted at any phase.
+        let mut lease = RequestLease { filesystem: self, complete: false };
+        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+        if id >= 1_u64 << 53 { return Err(invalid("host request identifiers exhausted")); }
+        let mut request = serde_json::json!({"id":id,"path":path});
+        request["op"] = match &operation {
+            Operation::Read => "readFile",
+            Operation::Write(bytes) => {
+                request["bytes"] = bytes.len().into();
+                request["chunks"] = bytes.len().div_ceil(CHUNK_BYTES).into();
+                "writeFile"
+            }
+            Operation::Metadata(options) => { request["followSymlinks"] = options.follow_symlinks.into(); "getMetadata" }
+            Operation::Canonicalize => "canonicalize",
+            Operation::Directory => "readDirectory",
+            Operation::CreateDirectory(options) => { request["recursive"] = options.recursive.into(); "createDirectory" }
+        }.into();
+        self.send(request).await?;
+        if let Operation::Write(bytes) = &operation {
+            for (index, chunk) in bytes.chunks(CHUNK_BYTES).enumerate() {
+                self.send(serde_json::json!({"type":"chunk","id":id,"index":index,"dataBase64":STANDARD.encode(chunk)})).await?;
+            }
+            // Even an empty write requires explicit commit; never retry after it.
+            self.send(serde_json::json!({"type":"commit","id":id})).await?;
+        }
+        let mut bytes = Vec::new();
+        let mut chunks = 0;
+        let mut short_chunk = false;
+        loop {
+            let reply: Reply = decode(&self.socket.receive(MAX_PACKET_BYTES).await?)?;
+            match reply {
+                Reply::Chunk { id: received, index, data_base64 } => {
+                    let chunk = STANDARD.decode(&data_base64).map_err(invalid)?;
+                    if !matches!(operation, Operation::Read | Operation::Directory) || received != id || index != chunks
+                        || short_chunk || chunk.is_empty() || chunk.len() > CHUNK_BYTES
+                        || bytes.len() + chunk.len() > MAX_DATA_BYTES || STANDARD.encode(&chunk) != data_base64 {
+                        return Err(invalid("invalid host read chunk"));
+                    }
+                    short_chunk = chunk.len() < CHUNK_BYTES;
+                    bytes.extend_from_slice(&chunk);
+                    chunks += 1;
+                }
+                Reply::Result { id: received, result } => {
+                    if received != id { return Err(invalid("host result ID differs")); }
+                    let response = self.validate(&operation, result, bytes, chunks)?;
+                    lease.complete = true;
+                    return Ok(response);
+                }
+                Reply::Error { id: received, error } => {
+                    let kind = match error.code {
+                        -32004 => io::ErrorKind::NotFound,
+                        -32000 | -32600 => io::ErrorKind::PermissionDenied,
+                        -32603 => io::ErrorKind::Other,
+                        _ => return Err(invalid("unknown host authority error code")),
+                    };
+                    if received != id || chunks != 0 { return Err(invalid("invalid host error result")); }
+                    lease.complete = true;
+                    return Err(io::Error::new(kind, error.message));
+                }
+            }
+        }
+    }
+
+    async fn send(&self, value: serde_json::Value) -> io::Result<()> {
+        let data = serde_json::to_vec(&value).map_err(invalid)?;
+        if data.len() > MAX_PACKET_BYTES { return Err(invalid("host request packet is too large")); }
+        self.socket.send(&data).await
+    }
+
+    fn validate(&self, operation: &Operation<'_>, result: WireResult, bytes: Vec<u8>, chunks: usize) -> io::Result<Response> {
+        match (operation, result) {
+            (Operation::Read | Operation::Directory, WireResult::Counters(count))
+                if count.bytes == bytes.len() && count.chunks == chunks && chunks == bytes.len().div_ceil(CHUNK_BYTES) => {
+                if matches!(operation, Operation::Read) { return Ok(Response::Bytes(bytes)); }
+                let directory: Directory = decode(&bytes)?;
+                let mut names = HashSet::new();
+                let entries = directory.entries.into_iter().map(|entry| {
+                    if entry.file_name.is_empty() || matches!(entry.file_name.as_str(), "." | "..")
+                        || entry.file_name.contains(['/', '\0']) || entry.is_directory == entry.is_file
+                        || !names.insert(entry.file_name.clone()) {
+                        return Err(invalid("invalid host directory entry"));
+                    }
+                    Ok(crate::ReadDirectoryEntry { file_name: entry.file_name, is_directory: entry.is_directory, is_file: entry.is_file })
+                }).collect::<io::Result<Vec<_>>>()?;
+                Ok(Response::Directory(entries))
+            }
+            (Operation::Metadata(_), WireResult::Metadata(meta)) if meta.is_directory != meta.is_file && !meta.is_symlink => {
+                Ok(Response::Metadata(crate::FileMetadata { is_directory: meta.is_directory, is_file: meta.is_file,
+                    is_symlink: meta.is_symlink, size: meta.size, created_at_ms: meta.created_at_ms, modified_at_ms: meta.modified_at_ms }))
+            }
+            (Operation::Canonicalize, WireResult::Canonical(value)) => {
+                let path = canonical_uri(&value.path)?;
+                if !path.starts_with(&self.workspace_root) { return Err(invalid("host canonical path escapes its workspace")); }
+                Ok(Response::Canonical(path))
+            }
+            (Operation::Write(_) | Operation::CreateDirectory(_), WireResult::Empty(result)) if result.is_empty() => Ok(Response::Done),
+            _ => Err(invalid("host terminal result differs from the requested operation")),
+        }
+    }
+}
+
+impl Drop for HostFileSystem { fn drop(&mut self) { self.disconnect(); } }
+
+struct RequestLease<'a> { filesystem: &'a HostFileSystem, complete: bool }
+impl Drop for RequestLease<'_> { fn drop(&mut self) { if !self.complete { self.filesystem.disconnect(); } } }
+
+fn invalid(error: impl std::fmt::Display) -> io::Error { io::Error::new(io::ErrorKind::InvalidData, error.to_string()) }
+fn closed() -> io::Error { io::Error::new(io::ErrorKind::BrokenPipe, "host files channel is closed") }
+
+fn decode<T: serde::de::DeserializeOwned>(data: &[u8]) -> io::Result<T> {
+    // Serde structs can accept positional arrays. The wire requires objects;
+    // inspect only shape here, then decode ORIGINAL bytes so duplicate fields
+    // are still rejected by the typed deny_unknown_fields deserializers.
+    let shape: serde_json::Value = serde_json::from_slice(data).map_err(invalid)?;
+    if !shape.is_object()
+        || ["result", "error"].iter().any(|key| shape.get(key).is_some_and(|value| !value.is_object()))
+        || shape.get("entries").is_some_and(|entries| entries.as_array().is_none_or(|entries| entries.iter().any(|entry| !entry.is_object()))) {
+        return Err(invalid("host protocol requires typed JSON objects"));
+    }
+    serde_json::from_slice(data).map_err(invalid)
+}
+
+fn canonical_uri(value: &str) -> io::Result<PathUri> {
+    let path: PathUri = value.parse().map_err(invalid)?;
+    if path.to_string() != value || PathUri::from_abs_path(&path.to_abs_path()?) != path {
+        return Err(invalid("host files requires a canonical native file URI"));
+    }
+    Ok(path)
+}
+
+#[path = "host_files_trait.rs"]
+mod filesystem;
+
+#[cfg(test)]
+#[path = "host_files_tests.rs"]
+mod tests;
