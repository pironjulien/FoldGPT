+}
+
+#[tokio::test]
+async fn malformed_directory_content_closes_the_channel() -> io::Result<()> {
+    let mut payloads = vec![
+        b"not-json".to_vec(),
+        serde_json::to_vec(&json!({"entries":[], "extra":true}))?,
+    ];
+    for name in ["", ".", "..", "path/child", "nul\0name"] {
+        payloads.push(serde_json::to_vec(
+            &json!({"entries":[{"fileName":name,"isDirectory":false,"isFile":true}]}),
+        )?);
+    }
+    for entries in [
+        json!([{"fileName":"same","isDirectory":false,"isFile":true},{"fileName":"same","isDirectory":true,"isFile":false}]),
+        json!([{"fileName":"ambiguous","isDirectory":true,"isFile":true}]),
+        json!([{"fileName":"unknown","isDirectory":false,"isFile":false}]),
+    ] {
+        payloads.push(serde_json::to_vec(&json!({"entries":entries}))?);
+    }
+    for bytes in payloads {
+        let (filesystem, server) = connected().await?;
+        let path = "file:///scope".parse().unwrap();
+        let (result, sent) = deadline(async {
+            tokio::join!(filesystem.read_directory(&path, /*sandbox*/ None), async {
+                server.receive(MAX_PACKET_BYTES).await?;
+                server
+                    .send(&serde_json::to_vec(&chunk(1, 0, &bytes))?)
+                    .await?;
+                server
+                    .send(&serde_json::to_vec(&terminal(1, bytes.len(), 1))?)
+                    .await
+            })
+        })
+        .await;
+        sent?;
+        assert_eq!(result.unwrap_err().kind(), io::ErrorKind::InvalidData);
+        assert_closed(&filesystem, &server).await;
