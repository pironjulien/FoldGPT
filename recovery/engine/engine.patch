+    );
+    std::fs::create_dir_all(&artifacts)?;
+    let output = tempfile::Builder::new()
+        .prefix("native-app-server-")
+        .tempdir_in(&artifacts)?
+        .keep();
+    let base = tempfile::Builder::new()
+        .prefix("foldgpt-native-app-")
+        .tempdir_in("/var/tmp")?;
+    let home = base.path().join("home");
