@@ -0,0 +1,80 @@
+"""Real AF_UNIX descriptor/credential adversary; no native executor is simulated."""
+import array
+import json
+import os
+from pathlib import Path
+import socket
+import struct
+import sys
+
+directory, mode = Path(sys.argv[1]), sys.argv[2]
+path = directory / "owner.sock"
+listener = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
+listener.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
+listener.bind(str(path))
+listener.listen(1)
+print(json.dumps({"pid": os.getpid(), "uid": os.getuid(), "gid": os.getgid(), "socket": str(path)}), flush=True)
+connection, _ = listener.accept()
+connection.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
+connection.settimeout(10)
+request = connection.recv(4096)
+if not request:
+    print(json.dumps({"closedBeforeAdmission": True}), flush=True)
+    sys.exit(0)
+assert json.loads(request) == {"type": "acquire", "schema": "foldgpt.native-runtime.v1"}
+if mode == "stall":
+    print("admitted", flush=True)
+    assert connection.recv(4096) == b""
+    print(json.dumps({"cancelClosed": True}), flush=True)
+    sys.exit(0)
+kinds = [socket.SOCK_STREAM, socket.SOCK_SEQPACKET, socket.SOCK_SEQPACKET]
+if mode == "extra":
+    kinds.append(socket.SOCK_SEQPACKET)
+if mode == "wrong_type":
+    kinds[0] = socket.SOCK_SEQPACKET
+pairs = [socket.socketpair(socket.AF_UNIX, kind) for kind in kinds]
+for pair in pairs:
+    for endpoint in pair:
+        endpoint.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
+        endpoint.settimeout(10)
+packet = {"type": "channels", "schema": "foldgpt.native-runtime.v1",
+          "workspaceRoot": directory.as_uri(), "fdRoles": ["exec", "config", "host"]}
+payload = json.dumps(packet).encode()
+if mode == "duplicate":
+    payload = payload[:-1] + b',"type":"channels"}'
+if mode == "truncated":
+    payload += b" " * 4096
+
+def transfer():
+    controls = [(socket.SOL_SOCKET, socket.SCM_CREDENTIALS, struct.pack("iII", os.getpid(), os.getuid(), os.getgid())),
+                (socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", [pair[0].fileno() for pair in pairs]))]
+    assert connection.sendmsg([payload], controls) == len(payload)
+
+if mode == "foreign_sender":
+    child = os.fork()
+    if child == 0:
+        transfer()
+        os._exit(0)
+    assert os.waitpid(child, 0)[1] == 0
+else:
+    transfer()
+for client, _ in pairs:
+    client.close()
+if mode in ("extra", "wrong_type", "duplicate", "truncated", "foreign_sender"):
+    all_closed = all(server.recv(1) == b"" for _, server in pairs)
+    print(json.dumps({"allDescriptorsClosed": all_closed}), flush=True)
+    sys.exit(0 if all_closed else 1)
+assert pairs[0][1].recv(128) == b"descriptor-transport-test"
+ready = {"type": "ready", "schema": "foldgpt.native-runtime.v1",
+         "sessionId": "wrong" if mode == "wrong_session" else "transport-session",
+         "workspaceRoot": directory.as_uri()}
+connection.send(json.dumps(ready).encode())
+if mode == "wrong_session":
+    assert connection.recv(1) == b""
+else:
+    for index, (_, server) in enumerate(pairs):
+        if index:
+            assert server.recv(128) == bytes([index])
+        server.send(bytes([index, 0, 255]))
+    assert connection.recv(1) == b""
+print(json.dumps({"lifetimeClosed": True}), flush=True)
