@@ -0,0 +1,61 @@
+//! Human host execution injected by trusted bootstrap, separate from model tools.
+
+use std::collections::HashMap;
+use std::future::Future;
+use std::io;
+use std::pin::Pin;
+
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_pty::SpawnedProcess;
+use codex_utils_pty::TerminalSize;
+
+/// Validated host command forwarded without changing its program, cwd or input.
+///
+/// The app server owns timeout and output-capture behavior. A backend must not
+/// silently impose a shorter timeout or truncate the actual output stream.
+pub struct HostProcessCommand {
+    pub command: Vec<String>,
+    pub cwd: AbsolutePathBuf,
+    pub environment: HashMap<String, String>,
+    pub tty: bool,
+    pub stream_stdin: bool,
+    pub size: Option<TerminalSize>,
+}
+
+/// Connection-side process authority granted by native bootstrap.
+///
+/// Implementations must start real processes, own every descendant and retain
+/// the native workspace lease until independently observed cleanup. Dropping a
+/// request or losing its transport must cancel owned work; it must not release
+/// an uncertain lease. This capability is never an Environment/ExecBackend and
+/// accepts no model sandbox override. Refusal is final, without controller retry.
+pub trait HostProcessBackend: Send + Sync {
+    fn spawn(&self, command: HostProcessCommand) -> HostProcessFuture<'_>;
+}
+
+pub type HostProcessFuture<'a> =
+    Pin<Box<dyn Future<Output = io::Result<SpawnedProcess>> + Send + 'a>>;
+
+/// Explicit native v2 authority. Construction never negotiates a downgrade or
+/// installs itself; the authenticated bootstrap chooses this separate owner.
+#[cfg(any(target_os = "linux", target_os = "android"))]
+pub struct NativeHostProcessBackend {
+    connection: std::sync::Arc<codex_exec_server::HostConnectionV2>,
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+impl NativeHostProcessBackend {
+    pub fn new(connection: std::sync::Arc<codex_exec_server::HostConnectionV2>) -> Self { Self { connection } }
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+impl HostProcessBackend for NativeHostProcessBackend {
+    fn spawn(&self, command: HostProcessCommand) -> HostProcessFuture<'_> {
+        Box::pin(async move {
+            self.connection.spawn(codex_exec_server::HostProcessCommandV2 {
+                command: command.command, cwd: command.cwd, environment: command.environment,
+                tty: command.tty, stream_stdin: command.stream_stdin, size: command.size,
+            }).await
+        })
+    }
+}
