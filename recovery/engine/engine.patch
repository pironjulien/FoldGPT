+use codex_utils_path_uri::PathUri;
+
+/// Real PC filesystem provider with explicit test admission and no path remapping.
+/// This fixture does not claim Android enforcement or controller-invisible paths.
+pub(in super::super) struct Runtime {
+    pub home: PathBuf,
+    pub path_access: ControllerPathAccess,
+    pub environment: Environment,
+}
+
+impl LocalRuntime for Runtime {
+    fn parent_environment(&self) -> Option<std::collections::HashMap<String, String>> {
+        let path = self.home.join("parent-environment.json");
+        path.exists().then(|| {
+            serde_json::from_slice(&std::fs::read(path).expect("read fixture environment"))
+                .expect("fixture environment must be a string mapping")
+        })
+    }
+
+    fn exec_backend(&self) -> Arc<dyn ExecBackend> {
+        if self.home.join("command-runtime").exists() {
+            Arc::new(CommandBackend {
+                inner: self.environment.get_exec_backend(),
+                home: self.home.clone(),
+            })
+        } else {
+            self.environment.get_exec_backend()
+        }
+    }
+
+    fn filesystem(&self) -> Arc<dyn ExecutorFileSystem> {
+        Arc::new(Files {
+            inner: self.environment.get_filesystem(),
+            denied: PathUri::from_host_native_path(self.home.join("denied.txt"))
+                .expect("temporary test file has an absolute native path"),
+            home: self.home.clone(),
+        })
+    }
+
+    fn sandbox_ownership(&self) -> LocalSandboxOwnership {
+        LocalSandboxOwnership {
+            process: if std::fs::read_to_string(self.home.join("command-runtime"))
+                .ok()
+                .as_deref()
+                == Some("executor")
+            {
+                SandboxOwner::Executor
+            } else {
+                SandboxOwner::Controller
+            },
+            filesystem: SandboxOwner::Controller,
+        }
+    }
+
+    fn controller_path_access(&self) -> ControllerPathAccess {
+        self.path_access
+    }
+
+    fn info(&self) -> ExecProcessFuture<'_, EnvironmentInfo> {
+        Box::pin(async {
+            if self.home.join("disconnected").exists() {
+                return Err(ExecServerError::Protocol(
+                    "bootstrap runtime disconnected".into(),
+                ));
+            }
+            let mut info = self.environment.info().await?;
+            info.user_home_dir = Some(
+                PathUri::from_host_native_path(self.home.join("runtime-home"))
+                    .map_err(|err| ExecServerError::Protocol(err.to_string()))?,
+            );
+            info.cwd = info.user_home_dir.clone();
+            Ok(info)
+        })
+    }
+
+    fn observed_status(&self) -> EnvironmentObservedStatus {
+        if self.home.join("disconnected").exists() {
+            EnvironmentObservedStatus::Disconnected {
+                error: "bootstrap runtime disconnected".into(),
+            }
+        } else {
+            EnvironmentObservedStatus::Ready
+        }
+    }
+
+    fn wait_until_ready(&self) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async { self.info().await.map(|_| ()) })
+    }
+}
+
+struct CommandBackend {
+    inner: Arc<dyn ExecBackend>,
+    home: PathBuf,
+}
+
+impl ExecBackend for CommandBackend {
+    fn start(
+        &self,
+        mut params: codex_exec_server::ExecParams,
+    ) -> codex_exec_server::ExecBackendFuture<'_> {
+        Box::pin(async move {
+            let record = serde_json::to_vec(&params)
+                .map_err(|error| ExecServerError::Protocol(error.to_string()))?;
+            std::fs::write(self.home.join("command-record.json"), record)
+                .map_err(|error| ExecServerError::Protocol(error.to_string()))?;
+            if self.home.join("deny-command").exists() {
+                return Err(ExecServerError::Protocol(
+                    "bootstrap command admission denied".into(),
+                ));
+            }
+            // This PC fixture admits the explicitly requested Disabled policy.
+            // Other portable policies require a real configured sandbox backend.
+            // Android's executor has separate admission tests and refuses Disabled.
+            if let Some(context) = &params.sandbox
+                && codex_protocol::models::PermissionProfile::try_from(context.permissions.clone())
+                    .is_ok_and(|profile| {
+                        profile == codex_protocol::models::PermissionProfile::Disabled
+                    })
+                && !params.enforce_managed_network
+                && params.managed_network.is_none()
+                && params.network_proxy.is_none()
+            {
+                params.sandbox = None;
+            }
+            self.inner.start(params).await
+        })
+    }
+}
+
+struct Files {
+    inner: Arc<dyn ExecutorFileSystem>,
+    denied: PathUri,
+    home: PathBuf,
+}
+
+impl Files {
+    fn check(&self, operation: &str, path: &PathUri) -> io::Result<()> {
+        let denied = std::fs::read_to_string(self.home.join(format!("deny-{operation}")));
+        if denied.ok().as_deref() == Some(path.to_string().as_str()) {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                format!("bootstrap provider refused {operation}"),
+            ));
+        }
+        Ok(())
+    }
+}
+
+impl ExecutorFileSystem for Files {
+    fn canonicalize<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, PathUri> {
+        Box::pin(async move {
+            self.check("canonicalize", path)?;
+            self.inner.canonicalize(path, sandbox).await
+        })
+    }
+    fn read_file<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: ReadFileOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<u8>> {
+        Box::pin(async move {
+            std::fs::write(self.home.join("provider-read"), path.to_string())?;
+            self.check("read", path)?;
+            if path == &self.denied || self.home.join("disconnected").exists() {
+                return Err(io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "bootstrap provider refused read",
+                ));
+            }
+            let contents = self.inner.read_file(path, options, sandbox).await?;
+            if std::fs::read_to_string(self.home.join("replace-after-read"))
+                .ok()
+                .as_deref()
+                == Some(path.to_string().as_str())
+            {
+                std::fs::remove_file(self.home.join("replace-after-read"))?;
+                std::fs::write(
+                    path.to_abs_path()?,
+                    "model = 'controller-replacement'\n[features]\nmemories = false\n",
+                )?;
+            }
+            Ok(contents)
+        })
+    }
+    fn read_file_stream<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileSystemReadStream> {
+        self.inner.read_file_stream(path, sandbox)
+    }
+    fn write_file<'a>(
+        &'a self,
+        path: &'a PathUri,
+        contents: Vec<u8>,
+        options: WriteFileOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        Box::pin(async move {
+            self.check("write", path)?;
+            self.inner
+                .write_file(path, contents, options, sandbox)
+                .await
+        })
+    }
+    fn create_directory<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: CreateDirectoryOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        self.inner.create_directory(path, options, sandbox)
+    }
+    fn get_metadata<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: GetMetadataOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileMetadata> {
+        Box::pin(async move {
+            self.check("metadata", path)?;
+            self.inner.get_metadata(path, options, sandbox).await
+        })
+    }
+    fn read_directory<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<ReadDirectoryEntry>> {
+        self.inner.read_directory(path, sandbox)
+    }
+    fn walk<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: WalkOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, WalkOutcome> {
+        self.inner.walk(path, options, sandbox)
+    }
+    fn remove<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: RemoveOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        self.inner.remove(path, options, sandbox)
+    }
+    fn copy<'a>(
+        &'a self,
+        source: &'a PathUri,
+        destination: &'a PathUri,
+        options: CopyOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        self.inner.copy(source, destination, options, sandbox)
+    }
+}
