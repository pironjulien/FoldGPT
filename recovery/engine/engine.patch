+
+struct RecordingBackend {
+    inner: LocalProcess,
+    requests: Mutex<Vec<ExecParams>>,
+}
+
+impl ExecBackend for RecordingBackend {
+    fn start(&self, params: ExecParams) -> ExecBackendFuture<'_> {
+        self.requests.lock().unwrap().push(params.clone());
+        self.inner.start(params)
+    }
+}
+
+struct Runtime {
+    backend: Arc<RecordingBackend>,
+    filesystem: Arc<dyn ExecutorFileSystem>,
+    info: EnvironmentInfo,
+    status: Mutex<EnvironmentObservedStatus>,
+    controller_paths: ControllerPathAccess,
+}
+
+impl Runtime {
+    fn new(cwd: &std::path::Path) -> Arc<Self> {
+        Arc::new(Self {
+            backend: Arc::new(RecordingBackend {
+                inner: LocalProcess::default(),
+                requests: Mutex::new(Vec::new()),
+            }),
+            filesystem: Arc::new(LocalFileSystem::unsandboxed()),
+            info: EnvironmentInfo {
+                cwd: Some(PathUri::from_host_native_path(cwd).unwrap()),
+                ..EnvironmentInfo::local()
+            },
+            status: Mutex::new(EnvironmentObservedStatus::Ready),
+            controller_paths: ControllerPathAccess::Shared,
+        })
+    }
+}
+
+impl LocalRuntime for Runtime {
+    fn exec_backend(&self) -> Arc<dyn ExecBackend> {
+        self.backend.clone()
+    }
+    fn filesystem(&self) -> Arc<dyn ExecutorFileSystem> {
+        Arc::clone(&self.filesystem)
+    }
+    fn sandbox_ownership(&self) -> LocalSandboxOwnership {
+        LocalSandboxOwnership {
+            process: SandboxOwner::Executor,
+            filesystem: SandboxOwner::Executor,
+        }
+    }
+    fn controller_path_access(&self) -> ControllerPathAccess {
+        self.controller_paths
+    }
+    fn info(&self) -> ExecProcessFuture<'_, EnvironmentInfo> {
+        Box::pin(async { Ok(self.info.clone()) })
+    }
+    fn observed_status(&self) -> EnvironmentObservedStatus {
+        self.status.lock().unwrap().clone()
+    }
+    fn wait_until_ready(&self) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async {
+            match self.observed_status() {
+                EnvironmentObservedStatus::Ready => Ok(()),
+                EnvironmentObservedStatus::Pending => {
+                    Err(ExecServerError::Protocol("runtime is pending".into()))
+                }
+                EnvironmentObservedStatus::Disconnected { error } => {
+                    Err(ExecServerError::Protocol(error))
+                }
+            }
+        })
+    }
+}
+
+fn manager(runtime: Arc<Runtime>) -> EnvironmentManager {
+    PreparedEnvironmentManager {
+        source: PreparedEnvironmentSource::Snapshot(EnvironmentProviderSnapshot {
+            environments: Vec::new(),
+            default: EnvironmentDefault::EnvironmentId(LOCAL_ENVIRONMENT_ID.into()),
+            include_local: true,
+        }),
+    }
+    .build_with_local_runtime(
+        runtime,
+        /*local_runtime_paths*/ None,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    )
+    .unwrap()
+}
+
+#[tokio::test]
+async fn injected_local_runtime_owns_real_process_and_filesystem_operations() {
+    let temp = tempfile::tempdir().unwrap();
+    let runtime = Runtime::new(temp.path());
+    let manager = manager(Arc::clone(&runtime));
+    let environment = manager.default_environment().unwrap();
+    assert!(Arc::ptr_eq(
+        &environment,
+        &manager.try_local_environment().unwrap()
+    ));
+    assert!(Arc::ptr_eq(
+        &environment,
+        &manager.get_environment(LOCAL_ENVIRONMENT_ID).unwrap()
+    ));
+    assert!(!environment.is_remote());
+    assert!(Arc::ptr_eq(
+        &environment.get_filesystem(),
+        &runtime.filesystem
+    ));
+    assert_eq!(environment.info().await.unwrap(), runtime.info);
+    assert_eq!(environment.force_info().await.unwrap(), runtime.info);
+
+    #[cfg(unix)]
+    let argv = vec![
+        "/bin/sh".into(),
+        "-c".into(),
+        "printf real-child > result; exit 23".into(),
+    ];
+    #[cfg(windows)]
+    let argv = vec![
+        "cmd.exe".into(),
+        "/C".into(),
+        "<nul set /p =real-child>result & exit /b 23".into(),
+    ];
+    let params = ExecParams {
+        process_id: ProcessId::from("injected-child"),
+        argv,
+        cwd: runtime.info.cwd.clone().unwrap(),
+        env_policy: None,
+        shell_snapshot: None,
+        env: Default::default(),
+        tty: false,
+        pipe_stdin: false,
+        arg0: None,
+        sandbox: None,
+        enforce_managed_network: false,
+        managed_network: None,
+        network_proxy: None,
+    };
+    let started = environment
+        .get_exec_backend()
+        .start(params.clone())
+        .await
+        .unwrap();
+    let mut events = started.process.subscribe_events();
+    let exit = tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        loop {
+            if let ExecProcessEvent::Exited { exit_code, .. } = events.recv().await.unwrap() {
+                break exit_code;
+            }
+        }
+    })
+    .await
+    .unwrap();
+    assert_eq!(exit, 23);
+    let path = PathUri::from_host_native_path(temp.path().join("result")).unwrap();
+    assert_eq!(
+        environment
+            .get_filesystem()
+            .read_file(&path, Default::default(), /*sandbox*/ None)
+            .await
+            .unwrap(),
+        b"real-child"
+    );
+
+    let restricted = FileSystemSandboxContext::from_permission_profile_with_cwd(
+        PermissionProfile::workspace_write(),
+        params.cwd.clone(),
+    );
+    let restricted_params = ExecParams {
+        process_id: ProcessId::from("refused-child"),
+        sandbox: Some(restricted.clone()),
+        ..params.clone()
+    };
+    let result = environment
+        .get_exec_backend()
+        .start(restricted_params.clone())
+        .await;
+    assert!(
+        result
+            .err()
+            .unwrap()
+            .to_string()
+            .contains("sandbox runtime paths are not configured")
+    );
+    assert_eq!(
+        *runtime.backend.requests.lock().unwrap(),
+        vec![params, restricted_params]
+    );
+    let error = environment
+        .get_filesystem()
+        .write_file(
+            &path,
+            b"must not be written".to_vec(),
+            Default::default(),
+            Some(&restricted),
+        )
+        .await
+        .unwrap_err();
+    assert!(
+        error
+            .to_string()
+            .contains("sandboxed filesystem operations require configured runtime paths")
+    );
+    assert_eq!(
+        std::fs::read(temp.path().join("result")).unwrap(),
+        b"real-child"
+    );
+}
+
+#[tokio::test]
+async fn injected_runtime_readiness_does_not_fall_back_to_always_ready_local() {
+    let temp = tempfile::tempdir().unwrap();
+    let runtime = Runtime::new(temp.path());
+    let environment = manager(Arc::clone(&runtime)).default_environment().unwrap();
+    *runtime.status.lock().unwrap() = EnvironmentObservedStatus::Pending;
+    assert!(!environment.startup_finished());
+    assert!(environment.readiness_result().is_none());
+    assert_eq!(
+        environment.status().await,
+        EnvironmentObservedStatus::Pending
+    );
+    let failure = EnvironmentObservedStatus::Disconnected {
+        error: "worker connection lost".into(),
+    };
+    *runtime.status.lock().unwrap() = failure.clone();
+    assert!(environment.startup_finished());
+    assert!(environment.readiness_result().unwrap().is_err());
+    assert_eq!(environment.status().await, failure);
+    assert!(environment.wait_until_ready().await.is_err());
+    *runtime.status.lock().unwrap() = EnvironmentObservedStatus::Ready;
+    environment.wait_until_ready().await.unwrap();
+    assert!(environment.readiness_result().unwrap().is_ok());
+}
+
+#[tokio::test]
+async fn injected_runtime_rejects_configurations_without_a_local_environment() {
+    let temp = tempfile::tempdir().unwrap();
+    let sources = [
+        PreparedEnvironmentSource::Snapshot(EnvironmentProviderSnapshot {
+            environments: Vec::new(),
+            default: EnvironmentDefault::Disabled,
+            include_local: false,
+        }),
+        PreparedEnvironmentSource::Noise(
+            NoiseRendezvousEnvironmentConfig::new(
+                "https://registry.invalid".into(),
+                "environment".into(),
+                "test-token".into(),
+                /*chatgpt_account_id*/ None,
+            )
+            .unwrap(),
+        ),
+    ];
+    for source in sources {
+        let result = PreparedEnvironmentManager { source }.build_with_local_runtime(
+            Runtime::new(temp.path()),
+            /*local_runtime_paths*/ None,
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        );
+        assert!(result.is_err());
+    }
+}
+
+#[tokio::test]
+async fn executor_only_paths_are_rejected_before_unadapted_controller_routes_can_run() {
+    let temp = tempfile::tempdir().unwrap();
+    let mut runtime = Runtime::new(temp.path());
+    Arc::get_mut(&mut runtime).unwrap().controller_paths = ControllerPathAccess::ExecutorOnly;
+    let result = PreparedEnvironmentManager {
+        source: PreparedEnvironmentSource::Snapshot(EnvironmentProviderSnapshot {
+            environments: Vec::new(),
+            default: EnvironmentDefault::EnvironmentId(LOCAL_ENVIRONMENT_ID.into()),
+            include_local: true,
+        }),
+    }
+    .build_with_local_runtime(
+        runtime.clone(),
+        /*local_runtime_paths*/ None,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    );
+    assert!(
+        result
+            .unwrap_err()
+            .to_string()
+            .contains("executor-only local paths require controller filesystem routing")
+    );
+    assert!(runtime.backend.requests.lock().unwrap().is_empty());
+}
