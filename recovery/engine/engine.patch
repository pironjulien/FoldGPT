diff --git a/codex-rs/exec-server/examples/bootstrap_files_pc.rs b/codex-rs/exec-server/examples/bootstrap_files_pc.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1855d6f754c0aaf8ee69939465452a8e8a19809c
--- /dev/null
+++ b/codex-rs/exec-server/examples/bootstrap_files_pc.rs
@@ -0,0 +1,162 @@
+//! Explicit PC qualification client for a real native authority owned by another UID.
+
+#[cfg(target_os = "linux")]
+#[tokio::main]
+async fn main() -> anyhow::Result<()> {
+    use anyhow::Context;
+    use codex_config::AbsolutePathBuf;
+    use codex_config::LoaderOverrides;
+    use codex_config::NoopThreadConfigLoader;
+    use codex_config::ProjectConfigFileSystem;
+    use codex_config::loader::load_config_layers_state_with_project_filesystem;
+    use codex_exec_server::BootstrapFileSystem;
+    use codex_exec_server::BootstrapPeer;
+    use codex_exec_server::ExecutorFileSystem;
+    use codex_exec_server::LOCAL_FS;
+    use codex_utils_path_uri::PathUri;
+    use std::io::ErrorKind;
+    use std::os::fd::FromRawFd;
+    use std::os::fd::OwnedFd;
+    use std::path::PathBuf;
+    use std::sync::Arc;
+
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    anyhow::ensure!(
+        args.len() == 8,
+        "expected owned FD, peer PID/UID/GID, session, workspace, home, report"
+    );
+    let descriptor: i32 = args[0].parse()?;
+    anyhow::ensure!(
+        descriptor >= 3,
+        "qualification requires a separate inherited descriptor"
+    );
+    let peer = BootstrapPeer {
+        pid: args[1].parse()?,
+        uid: args[2].parse()?,
+        gid: args[3].parse()?,
+    };
+    // SAFETY: geteuid has no preconditions. The qualification requires genuinely different nonroot UIDs.
+    let uid = unsafe { libc::geteuid() };
+    anyhow::ensure!(
+        uid != 0 && peer.uid != 0 && uid != peer.uid,
+        "distinct nonroot controller/executor required"
+    );
+    let root = AbsolutePathBuf::from_absolute_path(&args[5])?;
+    let root_uri = PathUri::from_abs_path(&root);
+    let home = PathBuf::from(&args[6]);
+    std::fs::create_dir_all(&home)?;
+    let direct_error =
+        std::fs::read(root.join("binary")).expect_err("controller must not open native workspace");
+    anyhow::ensure!(
+        direct_error.kind() == ErrorKind::PermissionDenied,
+        "expected real controller denial: {direct_error}"
+    );
+    // SAFETY: the test owner transfers this sole descriptor to this process with pass_fds.
+    let filesystem =
+        BootstrapFileSystem::connect(unsafe { OwnedFd::from_raw_fd(descriptor) }, peer, &args[4])
+            .await?;
+    anyhow::ensure!(
+        filesystem.discovery_root() == &root_uri,
+        "native root mismatch"
+    );
+    let binary = root_uri.join("binary")?;
+    let actual = filesystem
+        .read_file(&binary, Default::default(), /*sandbox*/ None)
+        .await?;
+    let expected: Vec<u8> = (0_u8..=255).cycle().take(70_000).collect();
+    anyhow::ensure!(actual == expected, "binary stream differs");
+    let metadata = filesystem
+        .get_metadata(&binary, Default::default(), /*sandbox*/ None)
+        .await?;
+    anyhow::ensure!(
+        metadata.is_file && metadata.size == actual.len() as u64 && !metadata.is_symlink,
+        "actual metadata differs"
+    );
+    let canonical = filesystem
+        .canonicalize(&root_uri.join(".codex")?, /*sandbox*/ None)
+        .await?;
+    anyhow::ensure!(
+        canonical == root_uri.join(".codex")?,
+        "canonical directory differs"
+    );
+    let entries = filesystem
+        .read_directory(&root_uri.join(".codex")?, /*sandbox*/ None)
+        .await?;
+    anyhow::ensure!(
+        entries.len() == 1 && entries[0].file_name == "config.toml" && entries[0].is_file,
+        "real directory entries differ"
+    );
+    for (path, kind) in [
+        (root_uri.join("missing")?, ErrorKind::NotFound),
+        (
+            root_uri.parent().context("native root parent")?,
+            ErrorKind::PermissionDenied,
+        ),
+    ] {
+        let error = filesystem
+            .get_metadata(&path, Default::default(), /*sandbox*/ None)
+            .await
+            .expect_err("negative path must fail");
+        anyhow::ensure!(error.kind() == kind, "wrong error category: {error}");
+    }
+    let mut user = toml::Table::new();
+    user.insert("model".into(), "controller-user-model".into());
+    user.insert(
+        "projects".into(),
+        toml::Value::Table(toml::Table::from_iter([(
+            root.to_string_lossy().into_owned(),
+            toml::Value::Table(toml::Table::from_iter([(
+                "trust_level".into(),
+                "trusted".into(),
+            )])),
+        )])),
+    );
+    std::fs::write(home.join("config.toml"), toml::to_string(&user)?)?;
+    let project = ProjectConfigFileSystem::bounded(
+        Arc::clone(&filesystem) as Arc<dyn ExecutorFileSystem>,
+        root.clone(),
+    );
+    let layers = load_config_layers_state_with_project_filesystem(
+        LOCAL_FS.as_ref(),
+        &project,
+        &home,
+        Some(root),
+        &[],
+        LoaderOverrides::without_managed_config_for_tests(),
+        &NoopThreadConfigLoader,
+    )
+    .await?;
+    anyhow::ensure!(
+        layers.effective_config()["model"].as_str() == Some("native-project-model"),
+        "project layer was not read from native authority"
+    );
+    let origins = layers.origins();
+    let origin = &origins.get("model").context("model origin")?.name;
+    anyhow::ensure!(
+        matches!(origin, codex_config::ConfigLayerSource::Project { .. }),
+        "wrong model origin"
+    );
+    // Check the authority is still usable after real NotFound and permission refusal.
+    anyhow::ensure!(
+        filesystem
+            .read_file(&binary, Default::default(), /*sandbox*/ None)
+            .await?
+            == expected,
+        "reads failed after refusal"
+    );
+    filesystem.disconnect();
+    let report = serde_json::json!({"verified":true,"controllerUid":uid,"executorUid":peer.uid,
+        "controllerReadError":"PermissionDenied","binaryBytes":actual.len(),"projectModel":"native-project-model",
+        "nativeMetadata":true,"nativeDirectory":true,"nativeCanonicalization":true,
+        "boundedConfigLoader":true,"realNotFound":true,"outsideRootDenied":true,
+        "scope":"PC bootstrap channel and real config loader; no app-server/UI/Android claim"});
+    std::fs::write(&args[7], serde_json::to_vec_pretty(&report)?)?;
+    println!("{report}");
+    Ok(())
+}
+
+#[cfg(not(target_os = "linux"))]
+fn main() {
+    eprintln!("This explicit native-authority qualification requires Linux.");
+    std::process::exit(1);
+}
