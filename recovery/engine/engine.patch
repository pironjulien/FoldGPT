+use core_test_support::PathBufExt;
+use core_test_support::PathExt;
+use pretty_assertions::assert_eq;
+use std::fs;
+use std::io;
+use tempfile::TempDir;
+use tokio::process::Command;
+
+#[tokio::test]
+async fn strict_trust_resolves_real_repo_files_and_linked_worktree() {
+    let tmp = TempDir::new().unwrap();
+    let repo = create_test_git_repo(&tmp).await;
+    for cwd in [&repo, &repo.join("test.txt")] {
+        assert_eq!(
+            try_resolve_root_git_project_for_trust(LOCAL_FS.as_ref(), &cwd.abs())
+                .await
+                .unwrap(),
+            Some(repo.abs())
+        );
+    }
+    let common = repo.join(".git-data");
+    let output = Command::new("git")
+        .arg("init")
+        .arg("--separate-git-dir")
+        .arg(&common)
+        .current_dir(&repo)
+        .output()
+        .await
+        .unwrap();
+    assert!(output.status.success(), "{output:?}");
+    let checkout = tmp.path().join("checkout");
+    let output = Command::new("git")
+        .args(["worktree", "add", "--detach"])
+        .arg(&checkout)
+        .current_dir(&repo)
+        .output()
+        .await
+        .unwrap();
+    assert!(output.status.success(), "{output:?}");
+    assert_eq!(
+        try_resolve_root_git_project_for_trust(LOCAL_FS.as_ref(), &checkout.abs())
+            .await
+            .unwrap()
+            .map(|path| normalize_for_path_comparison(path.as_path()).unwrap()),
+        Some(normalize_for_path_comparison(&repo).unwrap())
+    );
+}
+
+#[tokio::test]
+async fn strict_trust_propagates_metadata_errors_without_parent_fallback() {
+    let tmp = TempDir::new().unwrap();
+    let repo = create_test_git_repo(&tmp).await;
+    let nested = repo.join("nested");
+    fs::create_dir_all(nested.join(".git")).unwrap();
+    fs::write(nested.join(".git/HEAD"), "ref: refs/heads/main\n").unwrap();
+    for path in [&nested, &nested.join(".git"), &nested.join(".git/HEAD")] {
+        let fs = MetadataOverrideFileSystem {
+            failures: vec![(
+                FileSystemOperation::Metadata,
+                PathUri::from_abs_path(&path.abs()),
+                io::ErrorKind::PermissionDenied,
+            )],
+            ..Default::default()
+        };
+        let error = try_resolve_root_git_project_for_trust(&fs, &nested.abs())
+            .await
+            .unwrap_err();
+        assert_eq!(
+            (error.kind(), error.to_string()),
+            (
+                io::ErrorKind::PermissionDenied,
+                "injected Metadata failure".to_string()
+            ),
+            "{}",
+            path.display()
+        );
+    }
+}
+
+#[tokio::test]
+async fn strict_trust_propagates_worktree_provider_errors() {
+    let tmp = TempDir::new().unwrap();
+    let repo = tmp.path().join("repo");
+    let checkout = tmp.path().join("checkout");
+    let original_admin = write_linked_worktree_metadata(&repo, &checkout);
+    let admin = fs::canonicalize(&original_admin).unwrap();
+    let common = fs::canonicalize(repo.join(".git")).unwrap();
+    for (operation, path) in [
+        (FileSystemOperation::Metadata, original_admin.clone()),
+        (FileSystemOperation::Metadata, admin.join("gitdir")),
+        (FileSystemOperation::Metadata, admin.join("commondir")),
+        (FileSystemOperation::Metadata, repo.join(".git")),
+        (FileSystemOperation::ReadFile, checkout.join(".git")),
+        (FileSystemOperation::ReadFile, admin.join("gitdir")),
+        (FileSystemOperation::ReadFile, admin.join("commondir")),
+        (FileSystemOperation::Canonicalize, original_admin),
+        (FileSystemOperation::Canonicalize, checkout.clone()),
+        (FileSystemOperation::Canonicalize, common),
+    ] {
+        for kind in [
+            io::ErrorKind::PermissionDenied,
+            io::ErrorKind::ConnectionReset,
+            io::ErrorKind::InvalidData,
+        ] {
+            let fs = MetadataOverrideFileSystem {
+                failures: vec![(operation, PathUri::from_abs_path(&path.abs()), kind)],
+                ..Default::default()
+            };
+            let error = try_resolve_root_git_project_for_trust(&fs, &checkout.abs())
+                .await
+                .unwrap_err();
+            assert_eq!(
+                (error.kind(), error.to_string()),
+                (kind, format!("injected {operation:?} failure")),
+                "{}",
+                path.display()
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn strict_trust_keeps_completed_read_errors_when_other_metadata_is_invalid() {
+    for contents in [None, Some("")] {
+        let tmp = TempDir::new().unwrap();
+        let repo = tmp.path().join("repo");
+        let checkout = tmp.path().join("checkout");
+        let admin = fs::canonicalize(write_linked_worktree_metadata(&repo, &checkout)).unwrap();
+        match contents {
+            Some(contents) => fs::write(admin.join("gitdir"), contents).unwrap(),
+            None => fs::remove_file(admin.join("gitdir")).unwrap(),
+        }
+        let fs = MetadataOverrideFileSystem {
+            failures: vec![(
+                FileSystemOperation::ReadFile,
+                PathUri::from_abs_path(&admin.join("commondir").abs()),
+                io::ErrorKind::ConnectionReset,
+            )],
+            ..Default::default()
+        };
+        let error = try_resolve_root_git_project_for_trust(&fs, &checkout.abs())
+            .await
+            .unwrap_err();
+        assert_eq!(error.kind(), io::ErrorKind::ConnectionReset);
+    }
+}
+
+#[tokio::test]
+async fn strict_trust_keeps_completed_canonicalize_errors_when_checkout_does_not_match() {
+    let tmp = TempDir::new().unwrap();
+    let repo = tmp.path().join("repo");
+    let checkout = tmp.path().join("checkout");
+    let admin = write_linked_worktree_metadata(&repo, &checkout);
+    let common = fs::canonicalize(repo.join(".git")).unwrap();
+    let other = tmp.path().join("other");
+    fs::write(
+        admin.join("gitdir"),
+        format!("{}\n", other.join(".git").display()),
+    )
+    .unwrap();
+    // Check both a missing registered checkout and a real but unrelated one.
+    for create_registered_checkout in [false, true] {
+        if create_registered_checkout {
+            fs::create_dir(&other).unwrap();
+        }
+        let fs = MetadataOverrideFileSystem {
+            failures: vec![(
+                FileSystemOperation::Canonicalize,
+                PathUri::from_abs_path(&common.abs()),
+                io::ErrorKind::PermissionDenied,
+            )],
+            ..Default::default()
+        };
+        let error = try_resolve_root_git_project_for_trust(&fs, &checkout.abs())
+            .await
+            .unwrap_err();
+        assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+    }
+}
+
+#[tokio::test]
+async fn strict_trust_returns_none_for_missing_or_invalid_metadata() {
+    let outside = TempDir::new().unwrap();
+    assert_eq!(
+        try_resolve_root_git_project_for_trust(LOCAL_FS.as_ref(), &outside.path().abs())
+            .await
+            .unwrap(),
+        None
+    );
+    for filename in [".git", "gitdir", "commondir"] {
+        for contents in [
+            None,
+            Some(String::new()),
+            Some("invalid".to_string()),
+            Some("x".repeat(65_537)),
+        ] {
+            let tmp = TempDir::new().unwrap();
+            let repo = tmp.path().join("repo");
+            let checkout = tmp.path().join("checkout");
+            let admin = write_linked_worktree_metadata(&repo, &checkout);
+            let path = if filename == ".git" {
+                checkout.join(filename)
+            } else {
+                admin.join(filename)
+            };
+            match contents {
+                Some(contents) => fs::write(&path, contents).unwrap(),
+                None => fs::remove_file(&path).unwrap(),
+            }
+            assert_eq!(
+                try_resolve_root_git_project_for_trust(LOCAL_FS.as_ref(), &checkout.abs())
+                    .await
+                    .unwrap(),
+                None,
+                "{}",
+                path.display()
+            );
+        }
+    }
+}
