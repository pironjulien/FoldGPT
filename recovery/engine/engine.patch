@@ -0,0 +1,251 @@
+//! Production startup of the separately installed FoldGPT native executor.
+
+use std::io;
+use std::path::PathBuf;
+
+use crate::AppServerBootstrapOptions;
+use crate::AppServerRuntimeOptions;
+
+/// Startup-only native manifest; never loaded from model/configuration RPCs.
+#[derive(Debug, Default, Clone, clap::Args)]
+pub struct AppServerNativeRuntimeArgs {
+    #[arg(long = "foldgpt-native-bootstrap", hide = true)]
+    pub native_bootstrap: Option<PathBuf>,
+}
+
+/// Retains all independently authenticated native authorities until shutdown.
+pub struct NativeAppServerBootstrap {
+    options: AppServerBootstrapOptions,
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    resources: Option<native::Resources>,
+}
+
+impl NativeAppServerBootstrap {
+    pub async fn acquire(
+        args: AppServerNativeRuntimeArgs,
+        options: AppServerRuntimeOptions,
+    ) -> io::Result<Self> {
+        let Some(path) = args.native_bootstrap else {
+            return Ok(Self {
+                options: options.into(),
+                #[cfg(any(target_os = "linux", target_os = "android"))]
+                resources: None,
+            });
+        };
+        #[cfg(any(target_os = "linux", target_os = "android"))]
+        {
+            let result = tokio::time::timeout(
+                std::time::Duration::from_secs(30),
+                native::acquire(path, options),
+            )
+            .await;
+            result.map_err(|_| {
+                io::Error::new(
+                    io::ErrorKind::TimedOut,
+                    "native runtime startup timed out; cleanup remains owned by the native service",
+                )
+            })?
+        }
+        #[cfg(not(any(target_os = "linux", target_os = "android")))]
+        {
+            let _ = (path, options);
+            Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "this platform cannot acquire the Android native runtime",
+            ))
+        }
+    }
+
+    pub fn options(&self) -> AppServerBootstrapOptions {
+        self.options.clone()
+    }
+
+    /// Close every local channel after normal app-server cleanup. Native reaping
+    /// is still the external owner's responsibility, not this return value.
+    pub async fn finish(self, result: io::Result<()>) -> io::Result<()> {
+        #[cfg(any(target_os = "linux", target_os = "android"))]
+        if let Some(resources) = self.resources {
+            return resources.finish(result).await;
+        }
+        result
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod native {
+    use std::io;
+    use std::path::Path;
+    use std::path::PathBuf;
+    use std::sync::Arc;
+    use std::sync::Mutex;
+
+    use codex_config::ProjectConfigFileSystem;
+    use codex_exec_server::BootstrapFileSystem;
+    use codex_exec_server::ControllerPathAccess;
+    use codex_exec_server::ExecServerLocalRuntime;
+    use codex_exec_server::HostFileSystem;
+    use codex_exec_server::LocalRuntime;
+    use codex_exec_server::NativeRuntimeChannels;
+    use codex_exec_server::NativeRuntimeLifetime;
+    use codex_exec_server::NativeRuntimeStartup;
+    use codex_exec_server::verify_native_workspace_bytes;
+    use codex_http_client::HttpClientFactory;
+    use codex_http_client::OutboundProxyPolicy;
+    use codex_utils_path_uri::PathUri;
+    use tokio_util::sync::CancellationToken;
+
+    use super::AppServerRuntimeOptions;
+    use super::NativeAppServerBootstrap;
+
+    pub(super) struct Resources {
+        runtime: Arc<ExecServerLocalRuntime>,
+        config: Arc<BootstrapFileSystem>,
+        host: Arc<HostFileSystem>,
+        lifetime: Arc<NativeRuntimeLifetime>,
+        stop_monitor: CancellationToken,
+        failure: Arc<Mutex<Option<String>>>,
+        monitor: Option<tokio::task::JoinHandle<()>>,
+    }
+
+    pub(super) async fn acquire(
+        path: PathBuf,
+        options: AppServerRuntimeOptions,
+    ) -> io::Result<NativeAppServerBootstrap> {
+        let startup = NativeRuntimeStartup::read(&path)?;
+        let root = startup.workspace()?;
+        let NativeRuntimeChannels {
+            exec,
+            config,
+            host,
+            lifetime,
+        } = NativeRuntimeChannels::acquire(
+            Path::new(&startup.socket_path),
+            startup.peer(),
+            root.clone(),
+        )
+        .await?;
+        let (reader, writer) = exec.into_split();
+        let runtime = ExecServerLocalRuntime::connect(
+            reader,
+            writer,
+            ControllerPathAccess::Shared,
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        )
+        .await
+        .map_err(io::Error::other)?;
+        let session = runtime.session_id().ok_or_else(|| {
+            io::Error::other("native exec initialization did not return a session")
+        })?;
+        lifetime.bind_session(&session).await?;
+        let config = BootstrapFileSystem::connect(config, startup.peer(), &session).await?;
+        let host = HostFileSystem::connect(host, startup.peer(), &session).await?;
+        if config.discovery_root() != &root || host.workspace_root() != &root {
+            return Err(io::Error::other(
+                "native file authorities differ from the initialized workspace",
+            ));
+        }
+        let info = runtime.info().await.map_err(io::Error::other)?;
+        if info.cwd.as_ref() != Some(&root) {
+            return Err(io::Error::other(
+                "native cwd differs from its shared workspace",
+            ));
+        }
+        for path in info
+            .cwd
+            .iter()
+            .chain(info.user_home_dir.iter())
+            .chain(info.temp_dir.iter())
+            .chain(info.temporary_directories.iter().flatten())
+        {
+            startup.covers(path)?;
+        }
+        if Path::new(&info.shell.path).is_absolute() {
+            startup.covers(&PathUri::from_host_native_path(&info.shell.path)?)?;
+        }
+        // No Environment has been registered yet. Shared becomes available only
+        // after native dev/inode identities and actual native-written bytes pass.
+        verify_native_workspace_bytes(&root, &host).await?;
+        let runtime = runtime
+            .with_parent_environment(startup.parent_environment())
+            .map_err(io::Error::other)?
+            .with_project_filesystem(ProjectConfigFileSystem::bounded(
+                config.clone(),
+                root.to_abs_path()?,
+            ))
+            .map_err(io::Error::other)?;
+        let shutdown = CancellationToken::new();
+        let stop_monitor = CancellationToken::new();
+        let failure = Arc::new(Mutex::new(None));
+        let bootstrap_options = options
+            .with_local_runtime(runtime.clone())
+            .with_host_filesystem(root, host.clone(), startup.controller_roots()?)?
+            .with_runtime_shutdown(shutdown.clone());
+        let monitor = {
+            let lifetime = lifetime.clone();
+            let stop = stop_monitor.clone();
+            let failed = failure.clone();
+            let runtime = runtime.clone();
+            let config = config.clone();
+            let host = host.clone();
+            tokio::spawn(async move {
+                tokio::select! {
+                    biased;
+                    _ = stop.cancelled() => {}
+                    error = lifetime.wait_for_revocation() => {
+                        if let Ok(mut failure) = failed.lock() { *failure = Some(error.to_string()); }
+                        // Stop app-server admission through its existing cleanup path.
+                        shutdown.cancel();
+                        config.disconnect();
+                        host.disconnect();
+                        let _ = runtime.disconnect().await;
+                    }
+                }
+            })
+        };
+        Ok(NativeAppServerBootstrap {
+            options: bootstrap_options,
+            resources: Some(Resources {
+                runtime,
+                config,
+                host,
+                lifetime,
+                stop_monitor,
+                failure,
+                monitor: Some(monitor),
+            }),
+        })
+    }
+
+    impl Resources {
+        pub(super) async fn finish(mut self, result: io::Result<()>) -> io::Result<()> {
+            self.stop_monitor.cancel();
+            if let Some(monitor) = self.monitor.take() {
+                monitor.await.map_err(io::Error::other)?;
+            }
+            self.config.disconnect();
+            self.host.disconnect();
+            self.lifetime.disconnect();
+            let disconnect = self.runtime.disconnect().await.map_err(io::Error::other);
+            if let Some(failure) = self
+                .failure
+                .lock()
+                .map_err(|_| io::Error::other("native lifecycle failure record poisoned"))?
+                .as_ref()
+            {
+                return Err(io::Error::other(format!(
+                    "native runtime owner unavailable: {failure}"
+                )));
+            }
+            result.and(disconnect)
+        }
+    }
+
+    impl Drop for Resources {
+        fn drop(&mut self) {
+            self.stop_monitor.cancel();
+            self.config.disconnect();
