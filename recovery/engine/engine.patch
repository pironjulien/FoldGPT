index 0000000000000000000000000000000000000000..915536aab14ce71f4838348af3897d904252b32e
--- /dev/null
+++ b/codex-rs/core/src/bounded_trust_tests.rs
@@ -0,0 +1,295 @@
+use super::FileSystemOperation;
+use super::MetadataOverrideFileSystem;
+use super::create_test_git_repo;
+use super::write_linked_worktree_metadata;
+use codex_file_system::find_nearest_native_ancestor_with_markers_within;
+use codex_git_utils::try_resolve_root_git_project_for_trust_within;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path::normalize_for_path_comparison;
+use codex_utils_path_uri::PathUri;
+use core_test_support::PathBufExt;
+use core_test_support::PathExt;
+use pretty_assertions::assert_eq;
+use std::fs;
+use std::io;
+use tempfile::TempDir;
+use tokio::process::Command;
+
+fn assert_calls_within(fs: &MetadataOverrideFileSystem, root: &AbsolutePathBuf) {
+    let calls = fs.calls.lock().unwrap();
+    assert!(!calls.is_empty());
+    for (operation, path) in calls.iter() {
+        assert!(
+            path.to_abs_path()
+                .unwrap()
+                .as_path()
+                .starts_with(root.as_path()),
+            "{operation:?} escaped {}: {path}",
+            root.display()
+        );
+    }
+}
+
+#[tokio::test]
+async fn bounded_discovery_includes_root_without_scheduling_parent_probes() {
+    let tmp = TempDir::new().unwrap();
+    let root = tmp.path().join("scope").abs();
+    let start = root.join("nested/deep");
+    fs::create_dir_all(&start).unwrap();
+    fs::write(tmp.path().join("marker"), "outside").unwrap();
+    fs::write(root.join("marker"), "inside").unwrap();
+    for expected in [Some(root.clone()), None] {
+        let provider = MetadataOverrideFileSystem::default();
+        assert_eq!(
+            find_nearest_native_ancestor_with_markers_within(
+                &provider,
+                &start,
+                &root,
+                vec!["marker".to_string()],
+                /*sandbox*/ None,
+            )
+            .await
+            .unwrap(),
+            expected
+        );
+        assert_calls_within(&provider, &root);
+        assert!(provider.calls.lock().unwrap().contains(&(
+            FileSystemOperation::Metadata,
+            PathUri::from_abs_path(&root.join("marker"))
+        )));
+        if expected.is_some() {
+            fs::remove_file(root.join("marker")).unwrap();
+        }
+    }
+}
+
+#[tokio::test]
+async fn bounded_discovery_rejects_outside_inputs_without_probing_them() {
+    let tmp = TempDir::new().unwrap();
+    let root = tmp.path().join("scope").abs();
+    let outside = tmp.path().join("scope-other").abs();
+    fs::create_dir(&root).unwrap();
+    fs::create_dir(&outside).unwrap();
+    for (start, marker, kind) in [
+        (&outside, "marker".to_string(), io::ErrorKind::InvalidInput),
+        (
+            &root,
+            "../marker".to_string(),
+            io::ErrorKind::PermissionDenied,
+        ),
+        (
+            &root,
+            outside.to_string_lossy().into_owned(),
+            io::ErrorKind::PermissionDenied,
+        ),
+    ] {
+        let provider = MetadataOverrideFileSystem::default();
+        let error = find_nearest_native_ancestor_with_markers_within(
+            &provider,
+            start,
+            &root,
+            vec![marker],
+            /*sandbox*/ None,
+        )
+        .await
+        .unwrap_err();
+        assert_eq!(error.kind(), kind);
+        assert!(provider.calls.lock().unwrap().is_empty());
+    }
+}
+
+#[tokio::test]
+async fn bounded_discovery_propagates_refusal_before_valid_parent_marker() {
+    let tmp = TempDir::new().unwrap();
+    let root = tmp.path().abs();
+    let start = root.join("nested");
+    fs::create_dir(&start).unwrap();
+    fs::write(root.join("marker"), "valid").unwrap();
+    let provider = MetadataOverrideFileSystem {
+        failures: vec![(
+            FileSystemOperation::Metadata,
+            PathUri::from_abs_path(&start.join("marker")),
+            io::ErrorKind::ConnectionReset,
+        )],
+        ..Default::default()
+    };
+    let error = find_nearest_native_ancestor_with_markers_within(
+        &provider,
+        &start,
+        &root,
+        vec!["marker".to_string()],
+        /*sandbox*/ None,
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::ConnectionReset);
+    assert_calls_within(&provider, &root);
+}
+
+#[tokio::test]
+async fn bounded_trust_includes_real_root_and_stops_at_incomplete_child_repo() {
+    let tmp = TempDir::new().unwrap();
+    let repo = create_test_git_repo(&tmp).await.abs();
+    let provider = MetadataOverrideFileSystem::default();
+    assert_eq!(
+        try_resolve_root_git_project_for_trust_within(&provider, &repo.join("test.txt"), &repo)
+            .await
+            .unwrap(),
+        Some(repo.clone())
+    );
+    assert_calls_within(&provider, &repo);
+    let root = repo.join("scope");
+    fs::create_dir_all(root.join(".git")).unwrap();
+    let provider = MetadataOverrideFileSystem::default();
+    assert_eq!(
+        try_resolve_root_git_project_for_trust_within(&provider, &root, &root)
+            .await
+            .unwrap(),
+        None
+    );
+    assert_calls_within(&provider, &root);
+}
+
+#[tokio::test]
+async fn bounded_trust_rejects_outside_cwd_and_propagates_provider_refusals() {
+    let tmp = TempDir::new().unwrap();
+    let repo = create_test_git_repo(&tmp).await.abs();
+    let provider = MetadataOverrideFileSystem::default();
+    let error = try_resolve_root_git_project_for_trust_within(&provider, &tmp.path().abs(), &repo)
+        .await
+        .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::InvalidInput);
+    assert!(provider.calls.lock().unwrap().is_empty());
+    let provider = MetadataOverrideFileSystem {
+        failures: vec![(
+            FileSystemOperation::Metadata,
+            PathUri::from_abs_path(&repo.join(".git/HEAD")),
+            io::ErrorKind::PermissionDenied,
+        )],
+        ..Default::default()
+    };
+    let error = try_resolve_root_git_project_for_trust_within(&provider, &repo, &repo)
+        .await
+        .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+    assert_calls_within(&provider, &repo);
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn bounded_trust_preserves_real_filesystem_permission_denial() {
+    use std::os::unix::fs::PermissionsExt;
+
+    let tmp = TempDir::new().unwrap();
+    let repo = create_test_git_repo(&tmp).await.abs();
+    let dot_git = repo.join(".git");
+    let original = fs::metadata(&dot_git).unwrap().permissions();
+    let provider = MetadataOverrideFileSystem::default();
+    fs::set_permissions(&dot_git, fs::Permissions::from_mode(0o000)).unwrap();
+    let result = try_resolve_root_git_project_for_trust_within(&provider, &repo, &repo).await;
+    fs::set_permissions(&dot_git, original).unwrap();
+    let error = result.expect_err("run Git trust permission tests as an unprivileged user");
+    assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+    assert_calls_within(&provider, &repo);
+}
+
+#[tokio::test]
+async fn bounded_trust_resolves_real_worktree_only_when_admin_is_in_scope() {
+    let tmp = TempDir::new().unwrap();
+    let root = fs::canonicalize(tmp.path()).unwrap().abs();
+    let repo = create_test_git_repo(&tmp).await;
+    let checkout = root.join("checkout");
+    let output = Command::new("git")
+        .args(["worktree", "add", "--detach"])
+        .arg(checkout.as_path())
+        .current_dir(&repo)
+        .output()
+        .await
+        .unwrap();
+    assert!(output.status.success(), "{output:?}");
+    let repo = fs::canonicalize(repo).unwrap().abs();
+    let provider = MetadataOverrideFileSystem::default();
+    assert_eq!(
+        try_resolve_root_git_project_for_trust_within(&provider, &checkout, &root)
+            .await
+            .unwrap()
+            .map(|path| normalize_for_path_comparison(&path).unwrap()),
+        Some(normalize_for_path_comparison(&repo).unwrap())
+    );
+    assert_calls_within(&provider, &root);
+    let provider = MetadataOverrideFileSystem::default();
+    let error = try_resolve_root_git_project_for_trust_within(&provider, &checkout, &checkout)
+        .await
+        .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+    assert_calls_within(&provider, &checkout);
+}
+
+#[tokio::test]
+async fn bounded_trust_never_probes_external_metadata_references() {
+    for filename in [".git", "gitdir", "commondir"] {
+        let tmp = TempDir::new().unwrap();
+        let root = fs::canonicalize(tmp.path()).unwrap().join("scope").abs();
+        let repo = root.join("repo");
+        let checkout = root.join("checkout");
+        let admin = write_linked_worktree_metadata(repo.as_path(), checkout.as_path());
+        let outside = tmp.path().join("outside/.git");
+        fs::create_dir_all(&outside).unwrap();
+        let (path, contents) = if filename == ".git" {
+            (
+                checkout.join(".git"),
+                format!("gitdir: {}\n", outside.display()),
+            )
+        } else {
+            (
+                admin.join(filename).abs(),
+                format!("{}\n", outside.display()),
+            )
+        };
+        fs::write(path, contents).unwrap();
+        let provider = MetadataOverrideFileSystem::default();
+        let error = try_resolve_root_git_project_for_trust_within(&provider, &checkout, &root)
+            .await
+            .unwrap_err();
+        assert_eq!(error.kind(), io::ErrorKind::PermissionDenied, "{filename}");
+        assert_calls_within(&provider, &root);
+    }
+}
+
+#[tokio::test]
+async fn bounded_trust_rejects_canonical_escape_before_followup_metadata() {
+    let tmp = TempDir::new().unwrap();
+    let root = fs::canonicalize(tmp.path()).unwrap().join("scope").abs();
+    let repo = root.join("repo");
+    let checkout = root.join("checkout");
+    let admin = write_linked_worktree_metadata(repo.as_path(), checkout.as_path()).abs();
+    let outside = tmp.path().join("outside/worktrees/feature-x").abs();
+    fs::create_dir_all(&outside).unwrap();
+    let provider = MetadataOverrideFileSystem {
+        canonical_overrides: vec![(
+            PathUri::from_abs_path(&admin),
+            PathUri::from_abs_path(&outside),
+        )],
+        ..Default::default()
+    };
+    let error = try_resolve_root_git_project_for_trust_within(&provider, &checkout, &root)
+        .await
+        .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+    assert_calls_within(&provider, &root);
+}
+
+#[tokio::test]
+async fn bounded_trust_does_not_return_main_checkout_outside_root() {
+    let tmp = TempDir::new().unwrap();
+    let repo = fs::canonicalize(tmp.path()).unwrap().join("repo");
+    let root = repo.join(".git").abs();
+    let checkout = root.join("checkout");
+    write_linked_worktree_metadata(&repo, checkout.as_path());
+    let provider = MetadataOverrideFileSystem::default();
+    let error = try_resolve_root_git_project_for_trust_within(&provider, &checkout, &root)
+        .await
+        .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+    assert_calls_within(&provider, &root);
+}
