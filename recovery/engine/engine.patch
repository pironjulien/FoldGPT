+++ b/codex-rs/exec-server/src/host_v2_protocol.rs
@@ -0,0 +1,94 @@
+use std::collections::BTreeMap;
+use serde::Deserialize;
+
+pub(super) const SCHEMA: &str = "foldgpt.host.v2";
+pub(super) const CHUNK_BYTES: usize = 32768;
+pub(super) const MAX_DATA_BYTES: usize = 16777216;
+pub(super) const MAX_PACKET_BYTES: usize = 65536;
+pub(super) const MAX_PENDING: usize = 128;
+pub(super) const OPERATIONS: [&str; 10] = ["readFile", "writeFile", "getMetadata", "canonicalize",
+    "readDirectory", "createDirectory", "processStart", "processRead", "processWrite", "processTerminate"];
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Ready {
+    #[serde(rename = "type")]
+    pub kind: String,
+    pub schema: String,
+    pub session_id: String,
+    pub workspace_root: String,
+    pub chunk_bytes: usize,
+    pub max_data_bytes: usize,
+    pub max_packet_bytes: usize,
+    pub max_pending_requests: usize,
+    pub operations: Vec<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(tag = "type", rename_all = "camelCase", deny_unknown_fields)]
+pub(super) enum Reply {
+    #[serde(rename_all = "camelCase")]
+    Chunk { id: u64, index: usize, data_base64: String },
+    Result { id: u64, result: WireResult },
+    Error { id: u64, error: WireError },
+}
+
+#[derive(Deserialize)]
+#[serde(untagged)]
+pub(super) enum WireResult {
+    Started(Started),
+    Event(EventEnvelope),
+    Counters(Counters),
+    Metadata(Metadata),
+    Canonical(Canonical),
+    Empty(BTreeMap<String, serde::de::IgnoredAny>),
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Started { pub process_id: String }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct EventEnvelope { pub event: ProcessEvent }
+
+#[derive(Deserialize)]
+#[serde(tag = "type", rename_all = "camelCase", deny_unknown_fields)]
+pub(super) enum ProcessEvent {
+    #[serde(rename_all = "camelCase")]
+    Output { seq: u64, stream: String, data_base64: String },
+    #[serde(rename_all = "camelCase")]
+    Exited { seq: u64, exit_code: i32 },
+    Closed { seq: u64, failure: Option<String> },
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Counters { pub bytes: usize, pub chunks: usize }
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Metadata {
+    pub is_directory: bool,
+    pub is_file: bool,
+    pub is_symlink: bool,
+    pub size: u64,
+    pub created_at_ms: i64,
+    pub modified_at_ms: i64,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Canonical { pub path: String }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct WireError { pub code: i64, pub message: String }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Directory { pub entries: Vec<Entry> }
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Entry { pub file_name: String, pub is_directory: bool, pub is_file: bool }
diff --git a/codex-rs/exec-server/src/host_v2_tests.rs b/codex-rs/exec-server/src/host_v2_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..21eb9acf59116d9bb74f55ed7baeffa9e539c63e
--- /dev/null
+++ b/codex-rs/exec-server/src/host_v2_tests.rs
@@ -0,0 +1,150 @@
+//! Actual credentialed socketpair exchanges; these fixtures test protocol, not
+//! Android deployment or the native filesystem's separately qualified policy.
+use super::*;
+use crate::ExecutorFileSystem;
+use pretty_assertions::assert_eq;
+use serde_json::{Value, json};
+use std::future::Future;
+use std::os::fd::FromRawFd;
+use std::time::Duration;
+
+fn identity() -> BootstrapPeer {
+    // SAFETY: identity queries have no preconditions.
+    BootstrapPeer { pid: std::process::id(), uid: unsafe { libc::geteuid() }, gid: unsafe { libc::getegid() } }
+}
+
+fn pair() -> io::Result<(OwnedFd, CredentialedSocket)> {
+    let mut fds = [-1; 2];
+    // SAFETY: fds holds both socketpair outputs, then ownership is unique.
+    if unsafe { libc::socketpair(libc::AF_UNIX, libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC, 0, fds.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let (client, server) = unsafe { (OwnedFd::from_raw_fd(fds[0]), OwnedFd::from_raw_fd(fds[1])) };
+    let enabled: libc::c_int = 1;
+    // SAFETY: valid owned FD and correctly-sized integer socket option.
+    if unsafe { libc::setsockopt(client.as_raw_fd(), libc::SOL_SOCKET, libc::SO_PASSCRED,
+        (&raw const enabled).cast(), std::mem::size_of_val(&enabled) as _) } != 0 { return Err(io::Error::last_os_error()); }
+    let send_bound = MAX_PACKET_BYTES as libc::c_int;
+    // Bound the real socket queue so the large-write cancellation case cannot
+    // enqueue its entire 16MiB payload before the test observes the header.
+    if unsafe { libc::setsockopt(client.as_raw_fd(), libc::SOL_SOCKET, libc::SO_SNDBUF,
+        (&raw const send_bound).cast(), std::mem::size_of_val(&send_bound) as _) } != 0 { return Err(io::Error::last_os_error()); }
+    Ok((client, CredentialedSocket::new(server, identity())?))
+}
+
+fn ready() -> Value {
+    json!({"type":"ready","schema":SCHEMA,"sessionId":"host-test","workspaceRoot":"file:///scope",
+        "chunkBytes":CHUNK_BYTES,"maxDataBytes":MAX_DATA_BYTES,"maxPacketBytes":MAX_PACKET_BYTES,"maxPendingRequests":MAX_PENDING,"operations":OPERATIONS})
+}
+async fn deadline<T>(future: impl Future<Output = T>) -> T {
+    tokio::time::timeout(Duration::from_secs(20), future).await.expect("host protocol must terminate")
+}
+async fn send(server: &CredentialedSocket, value: Value) -> io::Result<()> { server.send(&serde_json::to_vec(&value)?).await }
+async fn receive(server: &CredentialedSocket) -> io::Result<Value> {
+    Ok(serde_json::from_slice(&deadline(server.receive(MAX_PACKET_BYTES)).await?)?)
+}
+async fn connected() -> io::Result<(Arc<HostConnectionV2>, CredentialedSocket)> {
+    let (client, server) = pair()?;
+    send(&server, ready()).await?;
+    Ok((deadline(HostConnectionV2::connect(client, identity(), "host-test")).await?, server))
+}
+fn path() -> PathUri { "file:///scope/file".parse().unwrap() }
+fn chunk(id: u64, index: usize, bytes: &[u8]) -> Value { json!({"type":"chunk","id":id,"index":index,"dataBase64":STANDARD.encode(bytes)}) }
+fn result(id: u64, payload: Value) -> Value { json!({"type":"result","id":id,"result":payload}) }
+
+#[tokio::test]
+async fn rejects_version_one_without_negotiating_a_downgrade() -> io::Result<()> {
+    let (client, server) = pair()?;
+    let mut packet = ready(); packet["schema"] = json!("foldgpt.host-files.v1");
+    send(&server, packet).await?;
+    assert!(HostConnectionV2::connect(client, identity(), "host-test").await.is_err());
+    assert_eq!(deadline(server.receive(MAX_PACKET_BYTES)).await.unwrap_err().kind(), io::ErrorKind::UnexpectedEof);
+    Ok(())
+}
+
+#[tokio::test]
+async fn process_control_response_is_independent_of_pending_filesystem_request() -> io::Result<()> {
+    let (connection, server) = connected().await?;
+    let files = connection.filesystem();
+    let pending_file = tokio::spawn(async move { files.read_file(&path(), Default::default(), None).await });
+    let file_request = receive(&server).await?;
+    let transport = Arc::clone(&connection);
+    let control = tokio::spawn(async move { transport.request(json!({"op":"processTerminate", "processId":"01234567890123456789012345678901"}), None).await });
+    let control_request = receive(&server).await?;
+    send(&server, result(control_request["id"].as_u64().unwrap(), json!({}))).await?;
+    assert!(matches!(deadline(control).await.unwrap()?.result, WireResult::Empty(_)));
+    assert!(!pending_file.is_finished());
+    let id = file_request["id"].as_u64().unwrap();
+    send(&server, chunk(id, 0, b"real response bytes")).await?;
+    send(&server, result(id, json!({"bytes":19,"chunks":1}))).await?;
+    assert_eq!(deadline(pending_file).await.unwrap()?, b"real response bytes");
+    connection.disconnect();
+    Ok(())
+}
+
+#[tokio::test]
+async fn interleaved_bounded_file_chunks_and_process_events_keep_separate_owners() -> io::Result<()> {
+    let (connection, server) = connected().await?;
+    let files = connection.filesystem();
+    let reading = tokio::spawn(async move { files.read_file(&path(), Default::default(), None).await });
+    let file_id = receive(&server).await?["id"].as_u64().unwrap();
+    let transport = Arc::clone(&connection);
+    let event = tokio::spawn(async move { transport.request(json!({"op":"processRead", "processId":"01234567890123456789012345678901"}), None).await });
+    let event_id = receive(&server).await?["id"].as_u64().unwrap();
+    let bytes = vec![42; CHUNK_BYTES];
+    send(&server, chunk(file_id, 0, &bytes)).await?;
+    send(&server, result(event_id, json!({"event":{"type":"exited","seq":1,"exitCode":17}}))).await?;
+    send(&server, chunk(file_id, 1, b"tail")).await?;
+    send(&server, result(file_id, json!({"bytes":CHUNK_BYTES+4,"chunks":2}))).await?;
+    assert!(matches!(deadline(event).await.unwrap()?.result, WireResult::Event(EventEnvelope { event:ProcessEvent::Exited { seq:1, exit_code:17 } })));
+    assert_eq!(deadline(reading).await.unwrap()?, [bytes, b"tail".to_vec()].concat());
+    connection.disconnect();
+    Ok(())
+}
+
+#[tokio::test]
+async fn cancelled_admitted_upload_revokes_connection_without_commit_or_retry() -> io::Result<()> {
+    let (connection, server) = connected().await?;
+    let files = connection.filesystem();
+    let writing = tokio::spawn(async move { files.write_file(&path(), vec![7;MAX_DATA_BYTES], Default::default(), None).await });
+    assert_eq!(receive(&server).await?["op"], "writeFile");
+    writing.abort();
+    assert!(writing.await.unwrap_err().is_cancelled());
+    loop {
+        match deadline(server.receive(MAX_PACKET_BYTES)).await {
+            Ok(packet) => assert_ne!(serde_json::from_slice::<Value>(&packet)?["type"], "commit"),
+            Err(error) => { assert_eq!(error.kind(), io::ErrorKind::UnexpectedEof); break; }
+        }
+    }
+    assert!(connection.closed.load(Ordering::Acquire));
+    Ok(())
+}
+
+#[tokio::test]
+async fn unknown_reply_identity_fails_all_pending_requests() -> io::Result<()> {
+    let (connection, server) = connected().await?;
+    let files = connection.filesystem();
+    let reading = tokio::spawn(async move { files.read_file(&path(), Default::default(), None).await });
+    receive(&server).await?;
+    send(&server, result(99, json!({"bytes":0,"chunks":0}))).await?;
+    assert_eq!(deadline(reading).await.unwrap().unwrap_err().kind(), io::ErrorKind::BrokenPipe);
+    assert!(connection.closed.load(Ordering::Acquire));
+    Ok(())
+}
+
+#[tokio::test]
+async fn valid_native_start_refusal_preserves_next_request_without_replay() -> io::Result<()> {
+    let (connection, server) = connected().await?;
+    let transport = Arc::clone(&connection);
+    let refused = tokio::spawn(async move { transport.request(json!({"op":"processStart","command":["cat"],"cwd":"/","environment":{},"pipeStdin":false}), None).await });
+    assert_eq!(receive(&server).await?["id"], 1);
+    send(&server, json!({"type":"error","id":1,"error":{"code":-32602,"message":"native runtime refuses executable"}})).await?;
+    assert_eq!(deadline(refused).await.unwrap().err().unwrap().kind(), io::ErrorKind::PermissionDenied);
+    let files = connection.filesystem();
+    let next = tokio::spawn(async move { files.read_file(&path(), Default::default(), None).await });
+    assert_eq!(receive(&server).await?["id"], 2);
+    send(&server, result(2, json!({"bytes":0,"chunks":0}))).await?;
+    assert_eq!(deadline(next).await.unwrap()?, Vec::<u8>::new());
+    connection.disconnect();
+    Ok(())
+}
