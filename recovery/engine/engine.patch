+use crate::ExecServerError;
+use crate::ExecutorFileSystem;
+use crate::LocalRuntime;
+use crate::LocalSandboxOwnership;
+use crate::SandboxOwner;
+use crate::client::LazyRemoteExecServerClient;
+use crate::connection::JsonRpcConnection;
+use crate::protocol::EnvironmentInfo;
+use crate::remote_file_system::RemoteFileSystem;
+use crate::remote_process::RemoteProcess;
+
+/// A local runtime over one authenticated, bootstrap-owned ExecServer connection.
+///
+/// The bootstrap must authenticate and own the local service and both I/O halves
+/// before connecting. This API neither launches a process nor selects a URL or
+/// replacement transport. It reuses the official wire client and typed backends
+/// without creating a remote Environment or allowing connection recovery.
+///
+/// Transport state, process exit and native cleanup are separate. The bootstrap
+/// must retain its independent native cleanup observer and ownership after this
+/// runtime disconnects or is dropped; no method here attests native cleanup.
+pub struct ExecServerLocalRuntime {
+    client: LazyRemoteExecServerClient,
+    connected_client: ExecServerClient,
+    backend: Arc<dyn ExecBackend>,
+    filesystem: Arc<dyn ExecutorFileSystem>,
+    controller_paths: ControllerPathAccess,
+    disconnect_requested: AtomicBool,
+}
+
+impl ExecServerLocalRuntime {
+    /// Initialize exactly one already-authenticated local stream.
+    ///
+    /// For the Android bridge, the bootstrap supplies the packaged peer-checking
+    /// AF_UNIX client's stdin/stdout. A raw socket is also suitable only after its
+    /// actual peer credentials have been verified by the bootstrap. There is no
+    /// reconnect closure, executable, shell string or resumable session argument.
+    pub async fn connect<R, W>(
+        reader: R,
+        writer: W,
+        controller_paths: ControllerPathAccess,
+        http_client_factory: HttpClientFactory,
+    ) -> Result<Arc<Self>, ExecServerError>
+    where
+        R: AsyncRead + Unpin + Send + 'static,
+        W: AsyncWrite + Unpin + Send + 'static,
+    {
+        let connected_client = ExecServerClient::connect(
+            JsonRpcConnection::from_stdio(reader, writer, "authenticated local executor".into()),
+            ExecServerClientConnectOptions::default(),
+        )
+        .await?;
+        let client = LazyRemoteExecServerClient::from_connected(
+            connected_client.clone(),
+            http_client_factory,
+        );
+        Ok(Arc::new(Self {
+            backend: Arc::new(RemoteProcess::for_local_runtime(client.clone())),
+            filesystem: Arc::new(RemoteFileSystem::for_local_runtime(client.clone())),
+            client,
+            connected_client,
+            controller_paths,
+            disconnect_requested: AtomicBool::new(false),
+        }))
+    }
+
+    /// Close admission and the transport, without reporting native cleanup.
+    /// The bootstrap must continue observing and owning the service separately.
+    pub async fn disconnect(&self) -> Result<(), ExecServerError> {
+        self.disconnect_requested.store(true, Ordering::Release);
+        self.connected_client.close_fixed_transport().await
+    }
+}
+
+impl LocalRuntime for ExecServerLocalRuntime {
+    fn exec_backend(&self) -> Arc<dyn ExecBackend> {
+        Arc::clone(&self.backend)
+    }
+    fn filesystem(&self) -> Arc<dyn ExecutorFileSystem> {
+        Arc::clone(&self.filesystem)
+    }
+    fn sandbox_ownership(&self) -> LocalSandboxOwnership {
+        LocalSandboxOwnership {
+            process: SandboxOwner::Executor,
+            filesystem: SandboxOwner::Executor,
+        }
+    }
+    fn controller_path_access(&self) -> ControllerPathAccess {
+        self.controller_paths
+    }
+    fn info(&self) -> ExecProcessFuture<'_, EnvironmentInfo> {
+        Box::pin(async {
+            self.wait_until_ready().await?;
+            self.client.environment_info().await
+        })
+    }
+    fn observed_status(&self) -> EnvironmentObservedStatus {
+        if self.disconnect_requested.load(Ordering::Acquire) {
+            return EnvironmentObservedStatus::Disconnected { error: "local executor transport was closed by its owner; native cleanup is not attested".into() };
+        }
+        match self.client.readiness_result() {
+            Some(Ok(())) => EnvironmentObservedStatus::Ready,
+            Some(Err(error)) => EnvironmentObservedStatus::Disconnected {
+                error: error.to_string(),
+            },
+            None => EnvironmentObservedStatus::Disconnected {
+                error: "local executor transport disconnected; no replacement is configured".into(),
+            },
+        }
+    }
+    fn wait_until_ready(&self) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async {
+            match self.observed_status() {
+                EnvironmentObservedStatus::Ready => {
+                    self.connected_client.environment_status().await.map(drop)
+                }
+                EnvironmentObservedStatus::Pending => Err(ExecServerError::Disconnected(
+                    "local executor is not initialized".into(),
+                )),
+                EnvironmentObservedStatus::Disconnected { error } => {
+                    Err(ExecServerError::Disconnected(error))
+                }
+            }
+        })
+    }
+}
