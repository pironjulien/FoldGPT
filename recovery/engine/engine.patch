+    ) -> io::Result<PathUri> {
+        self.check_path(path)?;
+        let canonical = self.provider().canonicalize(path, sandbox).await?;
+        // A resolved alias outside the boundary must not become a new metadata
+        // target. The provider remains responsible for enforcing the resolution
+        // itself under its filesystem authority.
+        self.check_path(&canonical)?;
+        Ok(canonical)
+    }
+}
