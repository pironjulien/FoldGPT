diff --git a/codex-rs/exec-server/src/runtime_acquisition.rs b/codex-rs/exec-server/src/runtime_acquisition.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e3f99bded1726419472ce6f5155e8b6372712143
--- /dev/null
+++ b/codex-rs/exec-server/src/runtime_acquisition.rs
@@ -0,0 +1,226 @@
+//! Startup-only acquisition of three independent native authorities.
+
+use std::io;
+use std::os::fd::OwnedFd;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::atomic::AtomicU8;
+use std::sync::atomic::Ordering;
+
+use codex_utils_path_uri::PathUri;
+use serde::Deserialize;
+
+use crate::BootstrapPeer;
+use crate::runtime_acquisition_socket::AcquisitionSocket;
+use crate::runtime_acquisition_socket::verify_peer;
+
+const SCHEMA: &str = "foldgpt.native-runtime.v1";
+
+/// Owned session lifetime channel, retained independently of model RPCs.
+/// Closing this requests native cleanup; it does not attest successful reaping.
+pub struct NativeRuntimeLifetime {
+    socket: AcquisitionSocket,
+    workspace_root: PathUri,
+    phase: AtomicU8,
+}
+
+/// Descriptors transferred exactly once by the kernel-authenticated native owner.
+/// These are startup capabilities, not serializable model or environment options.
+pub struct NativeRuntimeChannels {
+    pub exec: tokio::net::UnixStream,
+    pub config: OwnedFd,
+    pub host: OwnedFd,
+    pub lifetime: Arc<NativeRuntimeLifetime>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct ChannelsPacket {
+    #[serde(rename = "type")]
+    kind: String,
+    schema: String,
+    workspace_root: String,
+    fd_roles: [String; 3],
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct ReadyPacket {
+    #[serde(rename = "type")]
+    kind: String,
+    schema: String,
+    workspace_root: String,
+    session_id: String,
+}
+
+impl NativeRuntimeChannels {
+    /// Connect once to a private path published by the existing lifecycle owner.
+    /// The caller validates the startup manifest/path and bounds this future.
+    pub async fn acquire(
+        path: &Path,
+        peer: BootstrapPeer,
+        workspace_root: PathUri,
+    ) -> io::Result<Self> {
+        let socket = AcquisitionSocket::connect(path, peer)?;
+        socket
+            .send(br#"{"type":"acquire","schema":"foldgpt.native-runtime.v1"}"#)
+            .await?;
+        let (bytes, descriptors) = socket.receive().await?;
+        let packet: ChannelsPacket = decode(&bytes)?;
+        if packet.kind != "channels"
+            || packet.schema != SCHEMA
+            || packet.fd_roles != ["exec", "config", "host"]
+            || packet.workspace_root != workspace_root.to_string()
+            || descriptors.len() != 3
+        {
+            return Err(invalid(
+                "native authority channels do not match the startup contract",
+            ));
+        }
+        let mut descriptors = descriptors.into_iter();
+        let exec = descriptors.next().expect("three checked descriptors");
+        let config = descriptors.next().expect("three checked descriptors");
+        let host = descriptors.next().expect("three checked descriptors");
+        for (descriptor, kind) in [
+            (&exec, libc::SOCK_STREAM),
+            (&config, libc::SOCK_SEQPACKET),
+            (&host, libc::SOCK_SEQPACKET),
+        ] {
+            verify_peer(descriptor, peer, kind)?;
+            anonymous(descriptor)?;
+        }
+        let exec = std::os::unix::net::UnixStream::from(exec);
+        exec.set_nonblocking(true)?;
+        Ok(Self {
+            exec: tokio::net::UnixStream::from_std(exec)?,
+            config,
+            host,
+            lifetime: Arc::new(NativeRuntimeLifetime {
+                socket,
+                workspace_root,
+                phase: AtomicU8::new(0),
+            }),
+        })
+    }
+}
+
+impl NativeRuntimeLifetime {
+    /// Complete phase two only after the real exec initialization response.
+    /// Compare against the exec client's actual session, never a guessed ID.
+    pub async fn bind_session(&self, expected_session: &str) -> io::Result<()> {
+        if self
+            .phase
+            .compare_exchange(0, 1, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            self.disconnect();
+            return Err(invalid("native acquisition cannot bind a session twice"));
+        }
+        let mut admission = BindingGuard {
+            lifetime: self,
+            complete: false,
+        };
+        if expected_session.is_empty() || expected_session.len() > 128 {
+            return Err(invalid("invalid initialized native session"));
+        }
+        let (bytes, descriptors) = self.socket.receive().await?;
+        if !descriptors.is_empty() {
+            return Err(invalid(
+                "native session binding must not transfer descriptors",
+            ));
+        }
+        let packet: ReadyPacket = decode(&bytes)?;
+        if packet.kind != "ready"
+            || packet.schema != SCHEMA
+            || packet.session_id != expected_session
+            || packet.workspace_root != self.workspace_root.to_string()
+        {
+            return Err(invalid(
+                "native file authority session differs from the real exec session",
+            ));
+        }
+        self.phase.store(2, Ordering::Release);
+        admission.complete = true;
+        Ok(())
+    }
+
+    /// Every subsequent packet or EOF revokes this owned runtime. No keepalive
+    /// or reconnection message is part of this protocol.
+    pub async fn wait_for_revocation(&self) -> io::Error {
+        if self.phase.load(Ordering::Acquire) != 2 {
+            self.disconnect();
+            return invalid("native lifetime monitoring requires an initialized session");
+        }
+        let error = match self.socket.receive().await {
+            Ok(_) => invalid("unexpected packet after native runtime acquisition"),
+            Err(error) => error,
+        };
+        self.disconnect();
+        error
+    }
+
+    pub fn disconnect(&self) {
+        self.phase.store(3, Ordering::Release);
+        self.socket.shutdown();
+    }
+}
+
+struct BindingGuard<'a> {
+    lifetime: &'a NativeRuntimeLifetime,
+    complete: bool,
+}
+impl Drop for BindingGuard<'_> {
+    fn drop(&mut self) {
+        if !self.complete {
+            self.lifetime.disconnect();
+        }
+    }
+}
+
+impl Drop for NativeRuntimeLifetime {
+    fn drop(&mut self) {
+        self.disconnect();
+    }
+}
+
+fn anonymous(descriptor: &OwnedFd) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+    for query in [libc::getsockname, libc::getpeername] {
+        let mut address: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+        let mut length = std::mem::size_of_val(&address) as libc::socklen_t;
+        // SAFETY: query fills the bounded address buffer of this owned socket.
+        if unsafe {
+            query(
+                descriptor.as_raw_fd(),
+                (&raw mut address).cast(),
+                &raw mut length,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        if address.sun_family != libc::AF_UNIX as libc::sa_family_t
+            || length as usize != std::mem::size_of::<libc::sa_family_t>()
+        {
+            return Err(invalid(
+                "native channel is not an anonymous connected socketpair",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn decode<T: serde::de::DeserializeOwned>(bytes: &[u8]) -> io::Result<T> {
+    if !serde_json::from_slice::<serde_json::Value>(bytes)
+        .map_err(io::Error::other)?
+        .is_object()
+    {
+        return Err(invalid("native acquisition requires a JSON object"));
+    }
+    // Decode original bytes so typed deserialization still detects duplicate keys.
+    serde_json::from_slice(bytes).map_err(|error| invalid(&error.to_string()))
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
