@@ -0,0 +1,168 @@
+use super::*;
+use std::os::unix::net::UnixStream;
+use std::os::unix::process::CommandExt;
+use std::process::Command;
+
+fn pair() -> (OwnedFd, OwnedFd) {
+    let mut descriptors = [-1; 2];
+    // SAFETY: descriptors has space for both socketpair outputs.
+    assert_eq!(
+        unsafe {
+            libc::socketpair(
+                libc::AF_UNIX,
+                libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC,
+                0,
+                descriptors.as_mut_ptr(),
+            )
+        },
+        0
+    );
+    // SAFETY: both successfully created descriptors have unique ownership here.
+    unsafe {
+        (
+            OwnedFd::from_raw_fd(descriptors[0]),
+            OwnedFd::from_raw_fd(descriptors[1]),
+        )
+    }
+}
+
+fn identity() -> BootstrapPeer {
+    BootstrapPeer {
+        pid: std::process::id(),
+        uid: unsafe { libc::geteuid() },
+        gid: unsafe { libc::getegid() },
+    }
+}
+
+#[tokio::test]
+async fn credentialed_packets_preserve_boundaries_and_binary_bytes() -> io::Result<()> {
+    let (first, second) = pair();
+    let first = CredentialedSocket::new(first, identity())?;
+    let second = CredentialedSocket::new(second, identity())?;
+    first.send(b"\0\xffone").await?;
+    first.send(b"two").await?;
+    assert_eq!(second.receive(64).await?, b"\0\xffone");
+    assert_eq!(second.receive(64).await?, b"two");
+    second.send(b"reply").await?;
+    assert_eq!(first.receive(64).await?, b"reply");
+    first.shutdown();
+    assert_eq!(
+        second.receive(64).await.unwrap_err().kind(),
+        io::ErrorKind::UnexpectedEof
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn packet_from_wrong_expected_pid_is_denied() -> io::Result<()> {
+    let (first, second) = pair();
+    let wrong = BootstrapPeer {
+        pid: if std::process::id() == 1 { 2 } else { 1 },
+        ..identity()
+    };
+    let first = CredentialedSocket::new(first, identity())?;
+    let second = CredentialedSocket::new(second, wrong)?;
+    first.send(b"not-the-owner").await?;
+    assert_eq!(
+        second.receive(64).await.unwrap_err().kind(),
+        io::ErrorKind::PermissionDenied
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn oversized_packet_is_denied_without_returning_a_prefix() -> io::Result<()> {
+    let (first, second) = pair();
+    let first = CredentialedSocket::new(first, identity())?;
+    let second = CredentialedSocket::new(second, identity())?;
+    first.send(&[42; 65]).await?;
+    assert_eq!(
+        second.receive(64).await.unwrap_err().kind(),
+        io::ErrorKind::PermissionDenied
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn transferred_rights_are_closed_and_packet_is_denied() -> io::Result<()> {
+    let (first, second) = pair();
+    let second = CredentialedSocket::new(second, identity())?;
+    let file = std::fs::File::open("/dev/null")?;
+    let mut data = [42_u8];
+    let mut vector = libc::iovec {
+        iov_base: data.as_mut_ptr().cast(),
+        iov_len: 1,
+    };
+    let mut control = [0_usize; 8];
+    let mut message: libc::msghdr = unsafe { mem::zeroed() };
+    message.msg_iov = &raw mut vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.as_mut_ptr().cast();
+    // SAFETY: ancillary storage is aligned and large enough for one passed FD.
+    unsafe {
+        message.msg_controllen = libc::CMSG_SPACE(mem::size_of::<libc::c_int>() as _) as usize;
+        let header = libc::CMSG_FIRSTHDR(&raw const message);
+        (*header).cmsg_level = libc::SOL_SOCKET;
+        (*header).cmsg_type = libc::SCM_RIGHTS;
+        (*header).cmsg_len = libc::CMSG_LEN(mem::size_of::<libc::c_int>() as _) as usize;
+        libc::CMSG_DATA(header)
+            .cast::<libc::c_int>()
+            .write_unaligned(file.as_raw_fd());
+        assert_eq!(
+            libc::sendmsg(first.as_raw_fd(), &raw const message, libc::MSG_NOSIGNAL),
+            1
+        );
+    }
+    let before = std::fs::read_dir("/proc/self/fd")?.count();
+    assert_eq!(
+        second.receive(64).await.unwrap_err().kind(),
+        io::ErrorKind::PermissionDenied
+    );
+    assert_eq!(std::fs::read_dir("/proc/self/fd")?.count(), before);
+    Ok(())
+}
+
+#[tokio::test]
+async fn stream_descriptors_are_not_accepted_as_message_transport() -> io::Result<()> {
+    let (stream, _other) = UnixStream::pair()?;
+    let error = CredentialedSocket::new(stream.into(), identity())
+        .err()
+        .unwrap();
+    assert_eq!(error.kind(), io::ErrorKind::InvalidInput);
+    Ok(())
+}
+
+#[tokio::test]
+async fn inherited_endpoint_is_authenticated_by_actual_sender_pid() -> io::Result<()> {
+    for accept_child in [true, false] {
+        let (first, second) = pair();
+        // Enable receive credentials before the child can send its first packet.
+        let mut second = CredentialedSocket::new(second, identity())?;
+        let descriptor = first.as_raw_fd();
+        let mut command = Command::new("/usr/bin/python3");
+        command
+            .args([
+                "-B",
+                "-c",
+                "import socket,sys; socket.socket(fileno=int(sys.argv[1])).send(b'child')",
+            ])
+            .arg(descriptor.to_string());
+        // SAFETY: after fork the closure only changes a live FD flag with an async-signal-safe syscall.
+        unsafe {
+            command.pre_exec(move || checked(libc::fcntl(descriptor, libc::F_SETFD, 0)).map(drop));
+        }
+        let mut child = command.spawn()?;
+        if accept_child {
+            second.peer.pid = child.id();
+        }
+        drop(first);
+        let result = second.receive(64).await;
+        assert!(child.wait()?.success());
+        if accept_child {
+            assert_eq!(result?, b"child");
+        } else {
+            assert_eq!(result.unwrap_err().kind(), io::ErrorKind::PermissionDenied);
+        }
+    }
+    Ok(())
+}
