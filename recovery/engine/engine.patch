+++ b/codex-rs/config/src/project_filesystem.rs
@@ -0,0 +1,113 @@
+use crate::ConfigLayerSource;
+use crate::ConfigLayerStack;
+use codex_file_system::ExecutorFileSystem;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::fmt;
+use std::io;
+use std::sync::Arc;
+
+/// Trusted project configuration access installed by application bootstrap.
+///
+/// This handle is never deserialized from configuration or a model request. Its
+/// optional root stops discovery; the supplied filesystem still owns access
+/// enforcement, including symlink resolution and connection lifecycle.
+#[derive(Clone)]
+pub struct ProjectConfigFileSystem {
+    filesystem: Arc<dyn ExecutorFileSystem>,
+    discovery_root: Option<AbsolutePathBuf>,
+}
+
+impl ProjectConfigFileSystem {
+    pub fn shared(filesystem: Arc<dyn ExecutorFileSystem>) -> Self {
+        Self {
+            filesystem,
+            discovery_root: None,
+        }
+    }
+
+    pub fn bounded(
+        filesystem: Arc<dyn ExecutorFileSystem>,
+        discovery_root: AbsolutePathBuf,
+    ) -> Self {
+        Self {
+            filesystem,
+            discovery_root: Some(discovery_root),
+        }
+    }
+
+    pub fn filesystem(&self) -> &dyn ExecutorFileSystem {
+        self.filesystem.as_ref()
+    }
+
+    pub fn discovery_root(&self) -> Option<&AbsolutePathBuf> {
+        self.discovery_root.as_ref()
+    }
+
+    pub async fn trust_root(&self, cwd: &AbsolutePathBuf) -> io::Result<Option<AbsolutePathBuf>> {
+        match self.discovery_root() {
+            Some(root) => {
+                codex_git_utils::try_resolve_root_git_project_for_trust_within(
+                    self.filesystem(),
+                    cwd,
+                    root,
+                )
+                .await
+            }
+            None => {
+                codex_git_utils::try_resolve_root_git_project_for_trust(self.filesystem(), cwd)
+                    .await
+            }
+        }
+    }
+
+    /// File references follow their declaring layer, never a lexical path prefix.
+    /// Session flags resolve relative paths against the execution cwd.
+    pub fn for_source<'a>(
+        &'a self,
+        controller: &'a dyn ExecutorFileSystem,
+        source: &ConfigLayerSource,
+    ) -> &'a dyn ExecutorFileSystem {
+        match source {
+            ConfigLayerSource::Project { .. } | ConfigLayerSource::SessionFlags => {
+                self.filesystem()
+            }
+            ConfigLayerSource::PackagedDefaults { .. }
+            | ConfigLayerSource::Mdm { .. }
+            | ConfigLayerSource::System { .. }
+            | ConfigLayerSource::EnterpriseManaged { .. }
+            | ConfigLayerSource::User { .. }
+            | ConfigLayerSource::LegacyManagedConfigTomlFromFile { .. }
+            | ConfigLayerSource::LegacyManagedConfigTomlFromMdm => controller,
+        }
+    }
+
+    pub fn for_key<'a>(
+        &'a self,
+        controller: &'a dyn ExecutorFileSystem,
+        layers: &ConfigLayerStack,
+        key: &str,
+    ) -> &'a dyn ExecutorFileSystem {
+        match layers.origins().get(key) {
+            Some(origin) => self.for_source(controller, &origin.name),
+            None => controller,
+        }
+    }
+}
+
+impl fmt::Debug for ProjectConfigFileSystem {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("ProjectConfigFileSystem")
+            .field("discovery_root", &self.discovery_root)
+            .finish_non_exhaustive()
+    }
+}
+
+impl PartialEq for ProjectConfigFileSystem {
+    fn eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.filesystem, &other.filesystem)
+            && self.discovery_root == other.discovery_root
+    }
+}
+
+impl Eq for ProjectConfigFileSystem {}
