+
+fn policy(workspace: &Path) -> Result<FileSystemSandboxContext> {
+    let cwd = PathUri::from_host_native_path(workspace)?;
+    Ok(serde_json::from_value(json!({
+        "permissions": {"type": "managed", "file_system": {"type": "restricted", "entries": [
+            {"path": {"type": "path", "path": cwd}, "access": "write"},
+            {"path": {"type": "path", "path": PathUri::from_host_native_path(workspace.join("private"))?}, "access": "deny"}
+        ]}, "network": "restricted"},
+        "cwd": cwd, "workspaceRoots": [cwd], "windowsSandboxLevel": "disabled"
+    }))?)
+}
+
+fn command(key: &str, shell: &str, sandbox: &FileSystemSandboxContext) -> Result<ExecParams> {
+    Ok(ExecParams {
+        process_id: ProcessId::from(key),
+        argv: vec![
+            "/usr/bin/bash".into(),
+            "--noprofile".into(),
+            "--norc".into(),
+            "-c".into(),
+            shell.into(),
+        ],
+        cwd: sandbox.cwd.clone().context("test policy cwd")?,
+        env_policy: None,
+        shell_snapshot: None,
+        env: HashMap::from([("VALUE".into(), "preserved environment".into())]),
+        tty: false,
+        pipe_stdin: false,
+        arg0: None,
+        sandbox: Some(sandbox.clone()),
+        enforce_managed_network: false,
+        managed_network: None,
+        network_proxy: None,
+    })
+}
+
+async fn output(process: &dyn ExecProcess) -> Result<(Vec<u8>, Vec<u8>, i32)> {
+    timeout(Duration::from_secs(12), async {
+        let mut after = None;
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+        loop {
+            let response = process.read(after, Some(32768), Some(100)).await?;
+            anyhow::ensure!(
+                response.failure.is_none(),
+                "native process failed: {response:?}"
+            );
+            for chunk in response.chunks {
+                match chunk.stream {
+                    ExecOutputStream::Stdout => stdout.extend_from_slice(&chunk.chunk.0),
+                    ExecOutputStream::Stderr => stderr.extend_from_slice(&chunk.chunk.0),
+                    ExecOutputStream::Pty => anyhow::bail!("pipe process returned PTY output"),
+                }
+                after = Some(chunk.seq);
+            }
+            if response.closed {
+                anyhow::ensure!(response.exited, "closure must include actual exit");
+                return Ok((
+                    stdout,
+                    stderr,
+                    response.exit_code.context("actual exit code")?,
+                ));
+            }
+        }
+    })
+    .await?
