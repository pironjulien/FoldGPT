@@ -0,0 +1,528 @@
+//! Protocol adversaries using real credentialed sockets; no filesystem authority is emulated.
+
+use super::*;
+use crate::ExecutorFileSystem;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::future::Future;
+use std::os::fd::AsRawFd;
+use std::os::fd::FromRawFd;
+use std::time::Duration;
+
+fn peer_identity() -> BootstrapPeer {
+    BootstrapPeer {
+        pid: std::process::id(),
+        // SAFETY: these identity queries have no preconditions.
+        uid: unsafe { libc::geteuid() },
+        gid: unsafe { libc::getegid() },
+    }
+}
+
+fn socket_pair() -> io::Result<(OwnedFd, CredentialedSocket)> {
+    let mut descriptors = [-1; 2];
+    // SAFETY: descriptors has storage for both socketpair outputs.
+    if unsafe {
+        libc::socketpair(
+            libc::AF_UNIX,
+            libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC,
+            0,
+            descriptors.as_mut_ptr(),
+        )
+    } != 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: each successfully created descriptor is uniquely owned here.
+    let (client, server) = unsafe {
+        (
+            OwnedFd::from_raw_fd(descriptors[0]),
+            OwnedFd::from_raw_fd(descriptors[1]),
+        )
+    };
+    let enabled: libc::c_int = 1;
+    // Enable client credentials before the peer queues its handshake.
+    // SAFETY: the owned FD and integer socket-option buffer are valid.
+    if unsafe {
+        libc::setsockopt(
+            client.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PASSCRED,
+            (&raw const enabled).cast(),
+            std::mem::size_of_val(&enabled) as libc::socklen_t,
+        )
+    } != 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok((client, CredentialedSocket::new(server, peer_identity())?))
+}
+
+fn ready() -> Value {
+    json!({"type":"ready", "schema":SCHEMA, "sessionId":"protocol-test",
+        "discoveryRoot":"file:///scope", "chunkBytes":CHUNK_BYTES,
+        "maxDataBytes":MAX_DATA_BYTES, "maxPacketBytes":MAX_PACKET_BYTES,
+        "operations":["readFile", "getMetadata", "canonicalize", "readDirectory"]})
+}
+
+async fn deadline<T>(future: impl Future<Output = T>) -> T {
+    tokio::time::timeout(Duration::from_secs(10), future)
+        .await
+        .expect("bootstrap protocol operation must terminate")
+}
+
+async fn connected() -> io::Result<(Arc<BootstrapFileSystem>, CredentialedSocket)> {
+    let (client, server) = socket_pair()?;
+    server.send(&serde_json::to_vec(&ready())?).await?;
+    let filesystem = deadline(BootstrapFileSystem::connect(
+        client,
+        peer_identity(),
+        "protocol-test",
+    ))
+    .await?;
+    Ok((filesystem, server))
+}
+
+fn chunk(id: u64, index: usize, bytes: &[u8]) -> Value {
+    json!({"type":"chunk", "id":id, "index":index, "dataBase64":STANDARD.encode(bytes)})
+}
+
+fn terminal(id: u64, bytes: usize, chunks: usize) -> Value {
+    json!({"type":"result", "id":id, "result":{"bytes":bytes, "chunks":chunks}})
+}
+
+async fn assert_closed(filesystem: &BootstrapFileSystem, server: &CredentialedSocket) {
+    let path = "file:///scope/file".parse().unwrap();
+    assert_eq!(
+        deadline(filesystem.bytes(&path)).await.unwrap_err().kind(),
+        io::ErrorKind::BrokenPipe
+    );
+    assert_eq!(
+        deadline(server.receive(MAX_PACKET_BYTES))
+            .await
+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::UnexpectedEof
+    );
+}
+
+#[tokio::test]
+async fn handshake_rejects_malformed_or_unbound_authority() -> io::Result<()> {
+    let mut packets = vec![b"not-json".to_vec(), b"{}".to_vec()];
+    for (field, value) in [
+        ("type", json!("result")),
+        ("schema", json!("unknown")),
+        ("sessionId", json!("another-session")),
+        ("discoveryRoot", json!("https://example.com/scope")),
+        ("discoveryRoot", json!("file:///scope/../outside")),
+        ("chunkBytes", json!(CHUNK_BYTES + 1)),
+        ("maxDataBytes", json!(MAX_DATA_BYTES + 1)),
+        ("maxPacketBytes", json!(MAX_PACKET_BYTES + 1)),
+        ("operations", json!(["readFile", "writeFile"])),
+        ("unrecognized", json!(true)),
+    ] {
+        let mut invalid_ready = ready();
+        invalid_ready[field] = value;
+        packets.push(serde_json::to_vec(&invalid_ready)?);
+    }
+    for packet in packets {
+        let (client, server) = socket_pair()?;
+        server.send(&packet).await?;
+        let error = deadline(BootstrapFileSystem::connect(
+            client,
+            peer_identity(),
+            "protocol-test",
+        ))
+        .await
+        .err()
+        .unwrap();
+        assert_eq!(error.kind(), io::ErrorKind::InvalidData, "{packet:?}");
+        assert_eq!(
+            deadline(server.receive(MAX_PACKET_BYTES))
+                .await
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::UnexpectedEof
+        );
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn malformed_replies_poison_the_channel_without_returning_partial_bytes() -> io::Result<()> {
+    let cases = vec![
+        vec![json!({"type":"unknown", "id":1})],
+        vec![json!({"type":"result", "id":-1, "result":{"bytes":0,"chunks":0}})],
+        vec![json!({"type":"result", "id":1, "result":{"bytes":0,"chunks":0}, "extra":true})],
+        vec![terminal(2, 0, 0)],
+        vec![terminal(1, 1, 0)],
+        vec![terminal(1, 0, 1)],
+        vec![chunk(2, 0, b"a")],
+        vec![chunk(1, 1, b"a")],
+        vec![chunk(1, 0, b"")],
+        vec![chunk(1, 0, &vec![42; CHUNK_BYTES + 1])],
+        vec![json!({"type":"chunk", "id":1, "index":0, "dataBase64":"!invalid!"})],
+        vec![chunk(1, 0, b"a"), chunk(1, 0, b"b")],
+        vec![chunk(1, 0, b"a"), terminal(1, 2, 1)],
+        vec![chunk(1, 0, b"a"), terminal(1, 1, 2)],
+        vec![json!({"type":"result", "id":1, "result":{"path":"file:///scope"}})],
+        vec![json!({"type":"error", "id":2, "error":{"code":-32004,"message":"missing"}})],
+        vec![json!({"type":"error", "id":1, "error":{"code":-99999,"message":"unknown"}})],
+        vec![
+            chunk(1, 0, b"a"),
+            json!({"type":"error", "id":1, "error":{"code":-32004,"message":"partial"}}),
+        ],
+    ];
+    for frames in cases {
+        let (filesystem, server) = connected().await?;
+        let path = "file:///scope/file".parse().unwrap();
+        let (result, sent) = deadline(async {
+            tokio::join!(filesystem.bytes(&path), async {
+                let request: Value =
+                    serde_json::from_slice(&server.receive(MAX_PACKET_BYTES).await?)?;
+                assert_eq!(request, json!({"id":1, "op":"readFile", "path":path}));
+                for frame in &frames {
+                    server.send(&serde_json::to_vec(frame)?).await?;
+                }
+                io::Result::Ok(())
+            })
+        })
+        .await;
+        sent?;
+        assert_eq!(
+            result.unwrap_err().kind(),
+            io::ErrorKind::InvalidData,
+            "{frames:?}"
+        );
+        assert_closed(&filesystem, &server).await;
+    }
+    Ok(())
+}
