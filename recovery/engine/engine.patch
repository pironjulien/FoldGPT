+struct Backend {
+    inner: Arc<dyn ExecBackend>,
+    params: Mutex<Vec<ExecParams>>,
+    before_start: Option<Arc<Notify>>,
+    reject: bool,
+    fail_cleanup_status: bool,
+}
+
+impl ExecBackend for Backend {
+    fn start(&self, params: ExecParams) -> ExecBackendFuture<'_> {
+        Box::pin(async move {
+            self.params.lock().await.push(params.clone());
+            if let Some(before_start) = &self.before_start {
+                before_start.notified().await;
+            }
+            if self.reject {
+                return Err(ExecServerError::Protocol("backend admission denied".into()));
+            }
+            let mut started = self.inner.start(params).await?;
+            if self.fail_cleanup_status {
+                started.process = Arc::new(FailedCleanupStatus(started.process));
+            }
+            Ok(started)
+        })
+    }
+}
+
+fn setup(
+    command: &str,
+) -> anyhow::Result<(
+    CommandExecManager,
+    StartExecutorCommandParams,
+    mpsc::Receiver<OutgoingEnvelope>,
+    Arc<Backend>,
+)> {
+    let backend = Arc::new(Backend {
+        inner: Environment::default_for_tests().get_exec_backend(),
+        params: Mutex::new(Vec::new()),
+        before_start: None,
+        reject: false,
+        fail_cleanup_status: false,
+    });
+    let (tx, rx) = mpsc::channel(32);
+    let params = StartExecutorCommandParams {
+        outgoing: Arc::new(OutgoingMessageSender::new(
+            tx,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        )),
+        request_id: request(1),
+        process_id: Some("command".into()),
+        backend: backend.clone(),
+        exec_params: ExecParams {
+            process_id: uuid::Uuid::new_v4().to_string().into(),
+            argv: vec!["/bin/sh".into(), "-c".into(), command.into()],
+            cwd: PathUri::from_host_native_path(std::env::current_dir()?)?,
+            env_policy: None,
+            shell_snapshot: None,
+            env: HashMap::new(),
+            tty: false,
+            pipe_stdin: false,
+            arg0: None,
+            sandbox: None,
+            enforce_managed_network: false,
+            managed_network: None,
+            network_proxy: None,
+        },
+        expiration: ExecExpiration::Cancellation(CancellationToken::new()),
+        started_network_proxy: None,
+        stream_stdin: false,
+        stream_stdout_stderr: false,
+        output_bytes_cap: None,
+        size: None,
+    };
+    Ok((CommandExecManager::default(), params, rx, backend))
+}
+
+fn request(connection: u64) -> ConnectionRequestId {
+    ConnectionRequestId {
+        connection_id: ConnectionId(connection),
+        request_id: RequestId::Integer(1),
+    }
+}
+
+async fn next(rx: &mut mpsc::Receiver<OutgoingEnvelope>) -> anyhow::Result<Value> {
+    let envelope = timeout(Duration::from_secs(10), rx.recv())
+        .await
+        .context("output before deadline")?
+        .context("open output channel")?;
+    let OutgoingEnvelope::ToConnection {
+        message,
+        write_complete_tx,
+        ..
+    } = envelope
+    else {
+        panic!("connection scoped message required")
+    };
+    if let Some(write_complete_tx) = write_complete_tx {
+        let _ = write_complete_tx.send(());
+    }
+    let mut value = serde_json::to_value(message)?;
+    value
+        .as_object_mut()
+        .context("outgoing message object")?
+        .remove("emittedAtMs");
+    Ok(value)
+}
+
+async fn ready(backend: &Backend) -> anyhow::Result<()> {
+    timeout(Duration::from_secs(10), async {
+        while backend.params.lock().await.is_empty() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .context("backend receives start before deadline")?;
+    Ok(())
+}
+
+// Transport fault injection around a real process: even a delivered Closed
+// event must not turn a contradictory retained cleanup result into success.
+struct FailedCleanupStatus(Arc<dyn ExecProcess>);
+
+impl ExecProcess for FailedCleanupStatus {
+    fn process_id(&self) -> &codex_exec_server::ProcessId {
+        self.0.process_id()
+    }
+    fn subscribe_wake(&self) -> watch::Receiver<u64> {
+        self.0.subscribe_wake()
+    }
+    fn subscribe_events(&self) -> codex_exec_server::ExecProcessEventReceiver {
+        self.0.subscribe_events()
+    }
+    fn read(
+        &self,
+        after_seq: Option<u64>,
+        max_bytes: Option<usize>,
+        wait_ms: Option<u64>,
+    ) -> codex_exec_server::ExecProcessFuture<'_, codex_exec_server::ReadResponse> {
+        Box::pin(async move {
+            let mut response = self.0.read(after_seq, max_bytes, wait_ms).await?;
+            if response.closed {
+                response.failure = Some("cleanup verification failed".into());
+            }
+            Ok(response)
+        })
+    }
+    fn write(
+        &self,
+        chunk: Vec<u8>,
+    ) -> codex_exec_server::ExecProcessFuture<'_, codex_exec_server::WriteResponse> {
+        self.0.write(chunk)
+    }
+    fn signal(
+        &self,
+        signal: codex_exec_server::ProcessSignal,
+    ) -> codex_exec_server::ExecProcessFuture<'_, ()> {
+        self.0.signal(signal)
+    }
+    fn terminate(&self) -> codex_exec_server::ExecProcessFuture<'_, ()> {
+        self.0.terminate()
+    }
+}
