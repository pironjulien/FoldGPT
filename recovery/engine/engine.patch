+#[tokio::test]
+async fn project_filesystem_builder_reads_project_references_and_preserves_on_refresh()
+-> anyhow::Result<()> {
+    let fixture = Fixture::new()?;
+    let instructions = fixture.file(
+        "instructions.md",
+        "wrong controller instructions",
+        "native instructions",
+    )?;
+    let compact = fixture.file("compact.md", "wrong controller compact", "native compact")?;
+    let role = fixture.file(
+        "role.toml",
+        "description = 'wrong controller'\nmodel = 'wrong-controller-role'",
+        "description = 'native role'\nmodel = 'native-role-model'",
+    )?;
+    let mut catalog = bundled_models_response()?;
+    catalog.models.truncate(1);
+    let catalog_path = fixture.file(
+        "models.json",
+        "invalid controller catalog",
+        &serde_json::to_string(&catalog)?,
+    )?;
+    fixture.project_config(&format!("model_instructions_file = {}\nexperimental_compact_prompt_file = {}\nmodel_catalog_json = {}\n[agents.reviewer]\nconfig_file = {}\n", quoted(&instructions), quoted(&compact), quoted(&catalog_path), quoted(&role)))?;
+    let mut config = fixture.builder().build().await?;
+    assert_eq!(
+        (
+            config.base_instructions.as_deref(),
+            config.compact_prompt.as_deref(),
+            config.model_catalog.as_ref()
+        ),
+        (
+            Some("native instructions"),
+            Some("native compact"),
+            Some(&catalog)
+        )
+    );
+    assert_eq!(
+        config.agent_role_file_sources.get("reviewer"),
+        Some(&ConfigLayerSource::Project {
+            dot_codex_folder: fixture.project.join(".codex")
+        })
+    );
+    apply_role_to_config(&mut config, Some("reviewer"))
+        .await
+        .map_err(anyhow::Error::msg)?;
+    assert_eq!(config.model.as_deref(), Some("native-role-model"));
+    fixture.file(
+        "instructions.md",
+        "wrong controller instructions",
+        "refreshed native instructions",
+    )?;
+    let refreshed = fixture.builder().build().await?;
+    let mut rebuilt = config.rebuild_preserving_session_layers(&refreshed).await?;
+    assert_eq!(
+        (
+            rebuilt.project_filesystem.as_ref(),
+            rebuilt.base_instructions.as_deref(),
+            rebuilt.model.as_deref()
+        ),
+        (
+            Some(&fixture.handle),
+            Some("refreshed native instructions"),
+            Some("native-role-model")
+        )
+    );
+    fixture.file(
+        "role.toml",
+        "description = 'wrong controller'",
+        "description = 'native role'\nmodel = 'refreshed-role-model'",
+    )?;
+    apply_role_to_config(&mut rebuilt, Some("reviewer"))
+        .await
+        .map_err(anyhow::Error::msg)?;
+    assert_eq!(rebuilt.model.as_deref(), Some("refreshed-role-model"));
+    fixture.assert_bounded();
+    Ok(())
+}
