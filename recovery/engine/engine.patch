+//! Real Linux editor commands over the public, connection-owned host RPC.
+#![cfg(unix)]
+
+use std::time::Duration;
+
+use anyhow::Context;
+use anyhow::Result;
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use codex_app_server_protocol::JSONRPCMessage;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use tempfile::TempDir;
+use tokio::time::timeout;
+
+use super::connection_handling_websocket::WsClient;
+use super::connection_handling_websocket::connect_websocket;
+use super::connection_handling_websocket::read_jsonrpc_message;
+use super::injected_local_runtime::initialize;
+use super::injected_local_runtime::rpc;
+use super::injected_local_runtime::spawn;
+
+async fn output(client: &mut WsClient, handle: &str) -> Result<(Vec<u8>, Vec<u8>, Value)> {
+    timeout(Duration::from_secs(30), async {
+        let (mut stdout, mut stderr) = (Vec::new(), Vec::new());
+        loop {
+            let JSONRPCMessage::Notification(message) = read_jsonrpc_message(client).await? else { continue };
+            let params = message.params.context("process event parameters")?;
+            if params["processHandle"] != handle { continue; }
+            match message.method.as_str() {
+                "process/outputDelta" => {
+                    assert_eq!(params["capReached"], false);
+                    let bytes = STANDARD.decode(params["deltaBase64"].as_str().context("real process bytes")?)?;
+                    match params["stream"].as_str() {
+                        Some("stdout") => stdout.extend(bytes),
+                        Some("stderr") => stderr.extend(bytes),
+                        other => anyhow::bail!("unexpected process output stream: {other:?}"),
+                    }
+                }
+                "process/exited" => return Ok((stdout, stderr, params)),
+                _ => {}
+            }
+        }
+    }).await?
+}
+
+#[tokio::test]
+async fn linux_editor_reads_real_cat_and_writes_real_shell_through_injected_owner() -> Result<()> {
+    let home = TempDir::new()?;
+    let original = (0..2 * 1024 * 1024 + 17).map(|index| (index % 256) as u8).collect::<Vec<_>>();
+    let path = home.path().join("project.py");
+    std::fs::write(&path, &original)?;
+    let (mut child, address) = spawn(home.path(), "host-process").await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+
+    assert_eq!(rpc(&mut client, 2, "process/spawn", json!({
+        "command":["cat",path], "cwd":"/", "processHandle":"editor-read",
+        "streamStdin":true, "streamStdoutStderr":true, "outputBytesCap":null, "timeoutMs":null,
+        "env":{"FOLDGPT_TEST_VISIBLE":"preserved","FOLDGPT_TEST_REMOVED":null}
+    })).await?, json!({}));
+    let (stdout, stderr, exited) = output(&mut client, "editor-read").await?;
+    assert_eq!(stdout, original);
+    assert!(stderr.is_empty());
+    assert_eq!(exited, json!({"processHandle":"editor-read", "exitCode":0, "stdout":"",
+        "stdoutCapReached":false, "stderr":"", "stderrCapReached":false}));
+    let request: Value = serde_json::from_slice(&std::fs::read(home.path().join("host-process-request.json"))?)?;
+    assert_eq!(request["command"], json!(["cat",path]));
+    assert_eq!(request["cwd"], "/");
+    assert_eq!(request["environment"]["FOLDGPT_TEST_VISIBLE"], "preserved");
+    assert!(request["environment"].get("FOLDGPT_TEST_REMOVED").is_none());
+
+    let replacement = original.iter().rev().copied().collect::<Vec<_>>();
+    assert_eq!(rpc(&mut client, 3, "process/spawn", json!({
+        "command":["sh","-c","cat > \"$1\"","sh",path], "cwd":"/", "processHandle":"editor-write",
+        "streamStdin":true, "streamStdoutStderr":true, "outputBytesCap":null, "timeoutMs":null
+    })).await?, json!({}));
+    let mut id = 4;
+    for bytes in replacement.chunks(32768) {
+        assert_eq!(rpc(&mut client, id, "process/writeStdin", json!({"processHandle":"editor-write",
+            "deltaBase64":STANDARD.encode(bytes), "closeStdin":false})).await?, json!({}));
+        id += 1;
+    }
+    assert_eq!(rpc(&mut client, id, "process/writeStdin", json!({"processHandle":"editor-write", "closeStdin":true})).await?, json!({}));
+    let (stdout, stderr, exited) = output(&mut client, "editor-write").await?;
+    assert!(stdout.is_empty() && stderr.is_empty());
+    assert_eq!(exited["exitCode"], 0);
+    assert_eq!(std::fs::read(&path)?, replacement);
+    child.kill().await?;
+    child.wait().await?;
+    Ok(())
+}
