+fn fixture(home: &Path, trust: &str) -> Result<(PathBuf, PathBuf)> {
+    let project = home.join("project");
+    let cwd = project.join("child");
+    for (dir, model) in [(&project, "root-model"), (&cwd, "child-model")] {
+        std::fs::create_dir_all(dir.join(".codex"))?;
+        std::fs::write(
+            dir.join(".codex/config.toml"),
+            format!("model = {model:?}\n"),
+        )?;
+    }
+    std::fs::create_dir_all(project.join(".git"))?;
+    std::fs::write(project.join(".git/HEAD"), "ref: refs/heads/main\n")?;
+    let key = toml::Value::String(project.to_string_lossy().into_owned());
+    std::fs::write(
+        home.join("config.toml"),
+        format!("model = 'user-model'\n[projects.{key}]\ntrust_level = '{trust}'\n"),
+    )?;
+    Ok((project, cwd))
