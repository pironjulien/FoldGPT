+#[test_case::test_case("injected"; "configured_runtime")]
+#[test_case::test_case("ignore-config"; "environment_discovery_without_user_config")]
+#[tokio::test]
+async fn injected_local_runtime_serves_public_protocol_and_preserves_refusals(
+    mode: &str,
+) -> Result<()> {
+    let home = TempDir::new()?;
+    let config = if mode == "ignore-config" {
+        "default = \"none\"\ninclude_local = false\n"
+    } else {
+        "default = \"local\"\ninclude_local = true\n"
+    };
+    std::fs::write(home.path().join("environments.toml"), config)?;
+    let (mut child, address) = spawn(home.path(), mode).await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+    let info = rpc(
+        &mut client,
+        2,
+        "environment/info",
+        json!({ "environmentId": "local" }),
+    )
+    .await?;
+    assert_eq!(
+        info["cwd"],
+        json!(PathUri::from_host_native_path(
+            home.path().join("runtime-home")
+        )?)
+    );
+    let path = home.path().join("allowed.txt");
+    let read = rpc(&mut client, 3, "fs/readFile", json!({ "path": path })).await?;
+    assert_eq!(
+        STANDARD.decode(read["dataBase64"].as_str().context("missing bytes")?)?,
+        std::fs::read(&path)?
+    );
+    assert_eq!(
+        std::fs::read_to_string(home.path().join("provider-read"))?,
+        PathUri::from_host_native_path(&path)?.to_string()
+    );
+    let denied = home.path().join("denied.txt");
+    let error = rpc(&mut client, 4, "fs/readFile", json!({ "path": denied }))
+        .await
+        .expect_err("provider admission refusal must reach the client");
+    assert!(
+        error
+            .to_string()
+            .contains("bootstrap provider refused read"),
+        "{error}"
+    );
+    assert_eq!(std::fs::read(&denied)?, b"controller can read this");
+    std::fs::write(home.path().join("disconnected"), "closed")?;
+    let error = rpc(
+        &mut client,
+        5,
+        "environment/info",
+        json!({ "environmentId": "local" }),
+    )
+    .await
+    .expect_err("disconnected metadata must not fall back to the controller");
+    assert!(
+        error.to_string().contains("bootstrap runtime disconnected"),
+        "{error}"
+    );
+    let error = rpc(&mut client, 6, "fs/readFile", json!({ "path": path }))
+        .await
+        .expect_err("disconnected filesystem must not fall back to the controller");
+    assert!(
+        error
+            .to_string()
+            .contains("bootstrap provider refused read"),
+        "{error}"
+    );
+    child.kill().await?;
+    Ok(())
+}
