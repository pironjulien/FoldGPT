+use super::*;
+use codex_config::ProjectConfigFileSystem;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn bootstrap_authority_does_not_admit_untrusted_project_instructions() {
+    let temp = tempfile::tempdir().unwrap();
+    fs::write(temp.path().join("AGENTS.md"), "untrusted instructions").unwrap();
+    let mut config = make_config(&temp, /*limit*/ 4096, Some("user instructions")).await;
+    config.active_project.trust_level = Some(codex_protocol::config_types::TrustLevel::Untrusted);
+    let calls = Arc::new(MetadataCallCounts::default());
+    config.project_filesystem = Some(ProjectConfigFileSystem::bounded(
+        Arc::new(FailingFileSystem {
+            path: config.cwd.clone(),
+            failure: InjectedFailure::BootstrapOnly,
+            metadata_calls: Arc::clone(&calls),
+        }),
+        config.cwd.clone(),
+    ));
+    let loaded = load_agents_md(&config).await.unwrap();
+    assert_eq!(
+        loaded,
+        LoadedAgentsMd {
+            user_instructions: config.user_instructions.clone(),
+            entries: vec![],
+        }
+    );
+    assert!(calls.paths.lock().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn bootstrap_discovery_stops_at_root_and_preserves_instruction_provenance() {
+    let outer = tempfile::tempdir().unwrap();
+    fs::create_dir(outer.path().join(".git")).unwrap();
+    fs::write(outer.path().join("AGENTS.md"), "outside authority").unwrap();
+    let root = outer.path().join("project").abs();
+    let cwd = root.join("nested");
+    fs::create_dir_all(&cwd).unwrap();
+    fs::write(root.join("AGENTS.md"), "project root").unwrap();
+    fs::write(cwd.join("AGENTS.md"), "nested instructions").unwrap();
+    let mut config = make_config(&outer, /*limit*/ 4096, Some("user instructions")).await;
+    config.cwd = cwd.clone();
+    let calls = Arc::new(MetadataCallCounts::default());
+    config.project_filesystem = Some(ProjectConfigFileSystem::bounded(
+        Arc::new(FailingFileSystem {
+            path: root.clone(),
+            failure: InjectedFailure::BootstrapOnly,
+            metadata_calls: Arc::clone(&calls),
+        }),
+        root.clone(),
+    ));
+    let environments = resolved_local_environments([("local", cwd.clone())]);
+    let environment = environments.turn_environments().next().unwrap();
+    let model_filesystem = environment.environment.get_filesystem();
+
+    // An outer repository marker does not expand the bootstrap discovery root.
+    let loaded = load_project_instructions(
+        &config.config,
+        config.user_instructions.clone(),
+        &environments,
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(
+        loaded,
+        LoadedAgentsMd {
+            user_instructions: config.user_instructions.clone(),
+            entries: vec![InstructionEntry {
+                contents: "nested instructions".to_owned(),
+                provenance: project_provenance(cwd.join("AGENTS.md"), cwd.clone()),
+            }],
+        }
+    );
+
+    fs::create_dir(root.join(".git")).unwrap();
+    // A supplied model sandbox must not become an authority credential.
+    let sandbox = environment.sandbox_context(/*additional_permissions*/ None);
+    let loaded = read_agents_md(
+        &config.config,
+        model_filesystem.as_ref(),
+        "local",
+        &PathUri::from_abs_path(&cwd),
+        config.project_doc_max_bytes,
+        Some(&sandbox),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(
+        loaded,
+        LoadedAgentsMd {
+            user_instructions: None,
+            entries: vec![
+                InstructionEntry {
+                    contents: "project root".to_owned(),
+                    provenance: project_provenance(root.join("AGENTS.md"), cwd.clone()),
+                },
+                InstructionEntry {
+                    contents: "nested instructions".to_owned(),
+                    provenance: project_provenance(cwd.join("AGENTS.md"), cwd),
+                },
+            ],
+        }
+    );
+    let paths = calls.paths.lock().unwrap();
+    assert!(!paths.is_empty());
+    assert!(
+        paths
+            .iter()
+            .all(|path| path.to_abs_path().unwrap().starts_with(root.as_path()))
+    );
+    assert!(Arc::ptr_eq(
+        &model_filesystem,
+        &environment.environment.get_filesystem()
+    ));
+}
+
+#[tokio::test]
+async fn bootstrap_provider_refusals_abort_loading_without_model_sandbox() {
+    let temp = tempfile::tempdir().unwrap();
+    fs::create_dir(temp.path().join(".git")).unwrap();
+    fs::write(temp.path().join("AGENTS.md"), "controller can read this").unwrap();
+    let mut config = make_config(&temp, /*limit*/ 4096, /*instructions*/ None).await;
+    let environments = resolved_local_environments([("local", config.cwd.clone())]);
+    for bounded in [false, true] {
+        for kind in [io::ErrorKind::PermissionDenied, io::ErrorKind::BrokenPipe] {
+            for (name, failure) in [
+                (".git", InjectedFailure::Metadata(kind)),
+                ("AGENTS.md", InjectedFailure::Metadata(kind)),
+                ("AGENTS.md", InjectedFailure::Read(kind)),
+            ] {
+                let provider = Arc::new(FailingFileSystem {
+                    path: config.cwd.join(name),
+                    failure,
+                    metadata_calls: Arc::default(),
+                });
+                config.project_filesystem = Some(if bounded {
+                    ProjectConfigFileSystem::bounded(provider, config.cwd.clone())
+                } else {
+                    ProjectConfigFileSystem::shared(provider)
+                });
+                let error = load_project_instructions(
+                    &config.config,
+                    /*user_instructions*/ None,
+                    &environments,
+                )
+                .await
+                .expect_err("provider refusal must not become missing instructions");
+                assert_eq!(error.kind(), kind);
+                assert!(error.to_string().contains("environment `local`"));
+                assert_eq!(
+                    fs::read_to_string(temp.path().join("AGENTS.md")).unwrap(),
+                    "controller can read this"
+                );
+            }
+        }
+    }
+}
+
+#[tokio::test]
+async fn bootstrap_local_authority_is_not_used_for_another_environment() {
+    let local = tempfile::tempdir().unwrap();
+    let remote = tempfile::tempdir().unwrap();
+    fs::write(remote.path().join("AGENTS.md"), "other environment").unwrap();
+    let mut config = make_config(&local, /*limit*/ 4096, /*instructions*/ None).await;
+    let calls = Arc::new(MetadataCallCounts::default());
+    config.project_filesystem = Some(ProjectConfigFileSystem::bounded(
+        Arc::new(FailingFileSystem {
+            path: remote.abs().join("AGENTS.md"),
+            failure: InjectedFailure::Read(io::ErrorKind::PermissionDenied),
+            metadata_calls: Arc::clone(&calls),
+        }),
+        local.abs(),
+    ));
+    let environments = resolved_local_environments([("remote", remote.abs())]);
+    let loaded = load_project_instructions(
+        &config.config,
+        /*user_instructions*/ None,
+        &environments,
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(
+        loaded,
+        LoadedAgentsMd {
+            user_instructions: None,
+            entries: vec![InstructionEntry {
+                contents: "other environment".to_owned(),
+                provenance: InstructionProvenance::Project {
+                    source_path: PathUri::from_abs_path(&remote.abs().join("AGENTS.md")),
+                    environment_id: "remote".to_owned(),
+                    cwd: PathUri::from_abs_path(&remote.abs()),
+                },
+            }],
+        }
+    );
+    assert!(calls.paths.lock().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn bootstrap_rejects_outside_cwd_before_reads_even_with_empty_markers() {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.abs().join("project");
+    fs::create_dir(&root).unwrap();
+    let mut config = make_config_with_project_root_markers(
+        &temp,
+        /*limit*/ 4096,
+        /*instructions*/ None,
+        &[],
+    )
+    .await;
+    let calls = Arc::new(MetadataCallCounts::default());
+    config.project_filesystem = Some(ProjectConfigFileSystem::bounded(
+        Arc::new(FailingFileSystem {
+            path: root.clone(),
+            failure: InjectedFailure::BootstrapOnly,
+            metadata_calls: Arc::clone(&calls),
+        }),
