+    let mut service = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf());
+    service.project_config_context = ProjectConfigContext::Thread(Some(project.clone()));
+    let startup = service.load_latest_config(Some(root.to_path_buf())).await?;
+    let wrong_root = AbsolutePathBuf::try_from(home.path().join("other-project"))?;
+    service.project_config_context =
