+const WAIT: Duration = Duration::from_secs(60);
+const CREATE: &str = "*** Begin Patch\n*** Add File: app/core.py\n+def answer():\n+    return 41\n*** Add File: app/__main__.py\n+from core import answer\n+print(answer())\n*** Add File: tests/test_answer.py\n+import unittest\n+from app.core import answer\n+\n+class AnswerTests(unittest.TestCase):\n+    def test_answer(self):\n+        self.assertEqual(answer(), 42)\n+    def test_integer(self):\n+        self.assertIsInstance(answer(), int)\n+    def test_double(self):\n+        self.assertEqual(answer() + answer(), 84)\n*** End Patch\n";
+const EDIT: &str = "*** Begin Patch\n*** Update File: app/core.py\n@@\n-    return 41\n+    return 42\n*** End Patch\n";
+const DENIED_PATCH: &str =
+    "*** Begin Patch\n*** Add File: private/blocked.txt\n+must not be written\n*** End Patch\n";
