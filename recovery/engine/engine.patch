@@ -0,0 +1,258 @@
+use std::sync::Arc;
+use std::sync::Mutex;
+
+use anyhow::Result;
+use codex_exec_server::ControllerPathAccess;
+use codex_exec_server::Environment;
+use codex_exec_server::EnvironmentInfo;
+use codex_exec_server::EnvironmentManager;
+use codex_exec_server::EnvironmentObservedStatus;
+use codex_exec_server::ExecBackend;
+use codex_exec_server::ExecBackendFuture;
+use codex_exec_server::ExecParams;
+use codex_exec_server::ExecProcessFuture;
+use codex_exec_server::ExecutorFileSystem;
+use codex_exec_server::LocalRuntime;
+use codex_exec_server::LocalSandboxOwnership;
+use codex_exec_server::SandboxOwner;
+use codex_features::Feature;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use codex_protocol::models::PermissionProfile;
+use codex_utils_path_uri::PathUri;
+use core_test_support::responses;
+use core_test_support::responses::ev_apply_patch_custom_tool_call;
+use core_test_support::responses::ev_completed;
+use core_test_support::responses::ev_function_call;
+use core_test_support::responses::mount_sse_sequence;
+use core_test_support::responses::sse;
+use core_test_support::test_codex::TestEnv;
+use core_test_support::test_codex::test_codex;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+struct Runtime {
+    backend: Arc<RecordingBackend>,
+    environment: Environment,
+    info: EnvironmentInfo,
+}
+
+struct RecordingBackend {
+    inner: Arc<dyn ExecBackend>,
+    requests: Mutex<Vec<ExecParams>>,
+}
+
+impl ExecBackend for RecordingBackend {
+    fn start(&self, params: ExecParams) -> ExecBackendFuture<'_> {
+        let Ok(mut requests) = self.requests.lock() else {
+            return Box::pin(async {
+                Err(codex_exec_server::ExecServerError::Protocol(
+                    "recorded request lock poisoned".into(),
+                ))
+            });
+        };
+        requests.push(params.clone());
+        self.inner.start(params)
+    }
+}
+
+impl LocalRuntime for Runtime {
+    fn exec_backend(&self) -> Arc<dyn ExecBackend> {
+        self.backend.clone()
+    }
+    fn filesystem(&self) -> Arc<dyn ExecutorFileSystem> {
+        self.environment.get_filesystem()
+    }
+    fn sandbox_ownership(&self) -> LocalSandboxOwnership {
+        LocalSandboxOwnership {
+            process: SandboxOwner::Executor,
+            filesystem: SandboxOwner::Executor,
+        }
+    }
+    fn controller_path_access(&self) -> ControllerPathAccess {
+        ControllerPathAccess::Shared
+    }
+    fn info(&self) -> ExecProcessFuture<'_, EnvironmentInfo> {
+        Box::pin(async { Ok(self.info.clone()) })
+    }
+    fn observed_status(&self) -> EnvironmentObservedStatus {
+        EnvironmentObservedStatus::Ready
+    }
+    fn wait_until_ready(&self) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async { Ok(()) })
+    }
+}
+
+// This test specifically exercises injection into a real local host. It must not
+// switch to a foreign remote TestEnv selected by the broader test matrix.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn model_exec_and_apply_patch_use_injected_local_runtime_and_preserve_refusals() -> Result<()>
+{
+    let server = responses::start_mock_server().await;
+    let test_env = TestEnv::local().await?;
+    let cwd = test_env.cwd().clone();
+    let home = Arc::new(tempfile::tempdir()?);
+    std::fs::write(
+        home.path().join("environments.toml"),
+        "default = \"local\"\ninclude_local = true\n",
+    )?;
+    let environment = Environment::default_for_tests();
+    let mut info = EnvironmentInfo {
+        cwd: Some(PathUri::from_abs_path(&cwd)),
+        ..EnvironmentInfo::local()
+    };
+    // A real executable under a non-shell basename proves command construction
+    // uses the provider's path instead of rediscovering a controller shell.
+    #[cfg(unix)]
+    {
+        let shell_path = home.path().join("native-runtime-shell");
+        std::os::unix::fs::symlink(&info.shell.path, &shell_path)?;
+        info.shell.path = shell_path.to_string_lossy().into_owned();
+        // Exercise the Android command-classification branch while the actual
+        // process test continues to run on this POSIX host.
+        info.platform_os = Some("android".into());
+    }
+    info.capabilities.shell_snapshot_v2 = false;
+    let runtime = Arc::new(Runtime {
+        backend: Arc::new(RecordingBackend {
+            inner: environment.get_exec_backend(),
+            requests: Mutex::new(Vec::new()),
+        }),
+        environment,
+        info,
+    });
+    let manager = Arc::new(
+        EnvironmentManager::prepare_from_codex_home(home.path())
+            .await?
+            .build_with_local_runtime(
+                runtime.clone(),
+                /*local_runtime_paths*/ None,
+                HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+            )?,
+    );
+    assert!(!manager.default_environment().unwrap().is_remote());
+    let test = test_codex()
+        .with_model("gpt-5.4")
+        .with_home(home)
+        .with_environment_manager(manager)
+        .with_config(|config| {
+            config.features.enable(Feature::ShellSnapshotV2).unwrap();
+        })
+        .build_with_environment(&server, test_env)
+        .await?;
+    #[cfg(unix)]
+    let command = "printf runtime-dispatch > command.txt; printf runtime-dispatch; exit 23";
+    #[cfg(windows)]
+    let command = "Set-Content -NoNewline command.txt runtime-dispatch; Write-Output runtime-dispatch; exit 23";
+    #[cfg(unix)]
+    let explicit_command = "printf runtime-explicit";
+    #[cfg(windows)]
+    let explicit_command = "Write-Output runtime-explicit";
+    let successful = mount_sse_sequence(&server, vec![
+        sse(vec![
+            ev_function_call("exec-native", "exec_command", &json!({"cmd": command, "login": false}).to_string()),
+            ev_function_call("exec-native-explicit", "exec_command", &json!({"cmd": explicit_command, "login": true, "shell":runtime.info.shell.path}).to_string()),
+            ev_completed("exec-response"),
+        ]),
+        sse(vec![ev_apply_patch_custom_tool_call("patch-native", "*** Begin Patch\n*** Add File: patch.txt\n+runtime-filesystem\n*** End Patch\n"), ev_completed("patch-response")]),
+        sse(vec![ev_completed("complete-response")]),
+    ]).await;
+    // Full access is a test input to validate the launch route. The following
+    // turn independently verifies that a required sandbox is never removed.
+    test.submit_turn_with_permission_profile(
+        "execute and apply patch",
+        PermissionProfile::Disabled,
+    )
+    .await?;
+    assert_eq!(std::fs::read(cwd.join("command.txt"))?, b"runtime-dispatch");
+    assert_eq!(
+        std::fs::read(cwd.join("patch.txt"))?,
+        b"runtime-filesystem\n"
+    );
+    let output = successful.requests()[1]
+        .function_call_output_text("exec-native")
+        .unwrap();
+    assert!(output.contains("Process exited with code 23"), "{output}");
+    assert!(output.contains("runtime-dispatch"), "{output}");
+    let explicit_output = successful.requests()[1]
+        .function_call_output_text("exec-native-explicit")
+        .unwrap();
+    assert!(
+        explicit_output.contains("runtime-explicit"),
+        "{explicit_output}"
+    );
+    let completed = successful.requests()[2].custom_tool_call_output("patch-native");
+    assert!(
+        completed
+            .to_string()
+            .contains("Success. Updated the following files")
+    );
+
+    #[cfg(unix)]
+    let forbidden_command = "printf must-not-run > forbidden.txt";
+    #[cfg(windows)]
+    let forbidden_command = "Set-Content forbidden.txt must-not-run";
+    let refused = mount_sse_sequence(&server, vec![
+        sse(vec![ev_function_call("refused-native", "exec_command", &json!({"cmd": forbidden_command, "login": false}).to_string()), ev_completed("refused-exec-response")]),
+        sse(vec![ev_apply_patch_custom_tool_call("refused-patch", "*** Begin Patch\n*** Add File: forbidden-patch.txt\n+must-not-be-written\n*** End Patch\n"), ev_completed("refused-patch-response")]),
+        sse(vec![ev_completed("refused-complete-response")]),
+    ]).await;
+    test.submit_turn_with_permission_profile(
+        "attempt required sandbox",
+        PermissionProfile::workspace_write(),
+    )
+    .await?;
+    let refusal = refused.requests()[1]
+        .function_call_output_text("refused-native")
+        .unwrap();
+    assert!(
+        refusal.contains("sandbox runtime paths are not configured"),
+        "{refusal}"
+    );
+    assert!(!cwd.join("forbidden.txt").exists());
+    assert!(!cwd.join("forbidden-patch.txt").exists());
+    let patch_refusal = refused.requests()[2].custom_tool_call_output("refused-patch");
+    let patch_refusal = patch_refusal["output"].as_str().unwrap();
+    assert!(
+        patch_refusal.starts_with("Exit code: 1\n"),
+        "{patch_refusal}"
+    );
+    assert!(
+        patch_refusal.contains("Failed to write file"),
+        "{patch_refusal}"
+    );
+    let requests = runtime.backend.requests.lock().unwrap();
+    let successful_request = requests
+        .iter()
+        .find(|request| request.argv.iter().any(|arg| arg == command))
+        .unwrap();
+    let refused_request = requests
+        .iter()
+        .find(|request| request.argv.iter().any(|arg| arg == forbidden_command))
+        .unwrap();
+    let explicit_request = requests
+        .iter()
+        .find(|request| request.argv.iter().any(|arg| arg == explicit_command))
+        .unwrap();
+    assert_eq!(
+        (
+            &successful_request.argv[0],
+            &explicit_request.argv[0],
+            &successful_request.shell_snapshot,
+            &explicit_request.shell_snapshot
+        ),
+        (
+            &runtime.info.shell.path,
+            &runtime.info.shell.path,
+            &None,
+            &None
+        ),
+    );
+    assert_eq!(
+        (&successful_request.cwd, &successful_request.sandbox),
+        (&PathUri::from_abs_path(&cwd), &None)
+    );
+    assert!(refused_request.sandbox.is_some());
+    assert_eq!(refused_request.cwd, PathUri::from_abs_path(&cwd));
+    Ok(())
+}
