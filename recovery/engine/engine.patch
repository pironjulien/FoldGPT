+#![cfg(target_os = "linux")]
+
+use std::os::unix::fs::PermissionsExt;
+use std::time::Duration;
+
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn production_entrypoints_reject_invalid_native_authority_before_starting_rpc()
+-> anyhow::Result<()> {
+    let directory = tempfile::tempdir()?;
+    let manifest = directory.path().join("native.json");
+    std::fs::write(&manifest, b"[]")?;
+    std::fs::set_permissions(&manifest, std::fs::Permissions::from_mode(0o600))?;
+    for name in ["codex-app-server", "codex"] {
+        let binary = codex_utils_cargo_bin::cargo_bin(name)?;
+        let home = directory.path().join(name);
+        std::fs::create_dir(&home)?;
+        let mut command = tokio::process::Command::new(binary);
+        if name == "codex" {
+            command.arg("app-server");
+        }
+        command
+            .arg("--foldgpt-native-bootstrap")
+            .arg(&manifest)
+            .env("CODEX_HOME", home)
+            .kill_on_drop(true);
+        let output = tokio::time::timeout(Duration::from_secs(15), command.output()).await??;
+        assert!(
+            !output.status.success(),
+            "{name} must reject the actual invalid authority"
+        );
+        assert_eq!(
+            output.stdout,
+            Vec::<u8>::new(),
+            "no app-server RPC may start for {name}"
+        );
+        let error = String::from_utf8(output.stderr)?;
+        assert!(
+            error.contains("native startup manifest must be an object"),
+            "{name}: {error}"
+        );
+    }
+    Ok(())
+}
