@@ -0,0 +1,54 @@
+//! Explicit PC client: native host-file authority is owned by another nonroot UID.
+#[cfg(target_os = "linux")]
+#[tokio::main]
+async fn main() -> anyhow::Result<()> {
+    use codex_exec_server::{BootstrapPeer, CreateDirectoryOptions, ExecutorFileSystem, HostFileSystem};
+    use codex_utils_path_uri::PathUri;
+    use std::io::ErrorKind;
+    use std::os::fd::{FromRawFd, OwnedFd};
+    use std::path::PathBuf;
+
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    anyhow::ensure!(args.len() == 8, "expected FD, peer PID/UID/GID, session, workspace, unused home, report");
+    let fd: i32 = args[0].parse()?;
+    anyhow::ensure!(fd >= 3, "expected separately inherited descriptor");
+    let peer = BootstrapPeer { pid:args[1].parse()?, uid:args[2].parse()?, gid:args[3].parse()? };
+    // SAFETY: identity query has no preconditions.
+    let uid = unsafe { libc::geteuid() };
+    anyhow::ensure!(uid != 0 && peer.uid != 0 && uid != peer.uid, "distinct nonroot processes required");
+    let root = PathBuf::from(&args[5]);
+    let root_uri = PathUri::from_host_native_path(&root)?;
+    anyhow::ensure!(std::fs::read(root.join("binary")).expect_err("direct read must fail").kind() == ErrorKind::PermissionDenied,
+        "controller must have no filesystem route into native workspace");
+    // SAFETY: this sole descriptor is transferred by the test owner's pass_fds.
+    let files = HostFileSystem::connect(unsafe { OwnedFd::from_raw_fd(fd) }, peer, &args[4]).await?;
+    anyhow::ensure!(files.workspace_root() == &root_uri, "native workspace differs");
+    let binary = root_uri.join("binary")?;
+    let initial: Vec<_> = (0_u8..=255).cycle().take(70_000).collect();
+    anyhow::ensure!(files.read_file(&binary, Default::default(), /*sandbox*/ None).await? == initial, "initial bytes differ");
+    let payload: Vec<_> = (0_u8..=255).rev().cycle().take(16 * 1024 * 1024).collect();
+    files.write_file(&binary, payload.clone(), Default::default(), /*sandbox*/ None).await?;
+    anyhow::ensure!(files.read_file(&binary, Default::default(), /*sandbox*/ None).await? == payload, "complete maximum write/read differs");
+    let meta = files.get_metadata(&binary, Default::default(), /*sandbox*/ None).await?;
+    anyhow::ensure!(meta.is_file && !meta.is_symlink && meta.size == payload.len() as u64, "native metadata differs");
+    let directory = root_uri.join("created")?;
+    files.create_directory(&directory, CreateDirectoryOptions { recursive:false, follow_symlinks:false }, /*sandbox*/ None).await?;
+    anyhow::ensure!(files.canonicalize(&directory, /*sandbox*/ None).await? == directory, "actual canonicalization differs");
+    files.write_file(&directory.join("empty")?, Vec::new(), Default::default(), /*sandbox*/ None).await?;
+    let entries = files.read_directory(&directory, /*sandbox*/ None).await?;
+    anyhow::ensure!(entries == vec![codex_exec_server::ReadDirectoryEntry { file_name:"empty".into(), is_directory:false, is_file:true }], "actual listing differs");
+    files.write_file(&root_uri.join("private/secret")?, b"host can edit private".to_vec(), Default::default(), /*sandbox*/ None).await?;
+    for (target, kind) in [(root_uri.join("missing")?, ErrorKind::NotFound), (root_uri.parent().unwrap(), ErrorKind::PermissionDenied)] {
+        anyhow::ensure!(files.read_file(&target, Default::default(), /*sandbox*/ None).await.expect_err("must refuse").kind() == kind, "refusal changed kind");
+    }
+    files.disconnect();
+    let report = serde_json::json!({"verified":true,"controllerUid":uid,"executorUid":peer.uid,
+        "maximumBytes":payload.len(),"sixOperations":true,"privateHostWrite":true,"realNotFound":true,
+        "scope":"PC real Python native authority and Rust client; no UI/Android evidence"});
+    std::fs::write(&args[7], serde_json::to_vec_pretty(&report)?)?;
+    println!("{report}");
+    Ok(())
+}
+
+#[cfg(not(target_os = "linux"))]
+fn main() { eprintln!("The explicit host-file qualification requires Linux."); std::process::exit(2); }
