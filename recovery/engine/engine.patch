@@ -0,0 +1,310 @@
+//! Actual credentialed socketpair exchanges; these fixtures test protocol, not
+//! Android deployment or the native filesystem's separately qualified policy.
+use super::*;
+use crate::{CreateDirectoryOptions, ExecutorFileSystem, FileSystemSandboxContext, GetMetadataOptions};
+use pretty_assertions::assert_eq;
+use serde_json::{Value, json};
+use std::future::Future;
+use std::os::fd::FromRawFd;
+use std::time::Duration;
+
+fn identity() -> BootstrapPeer {
+    // SAFETY: identity queries have no preconditions.
+    BootstrapPeer { pid: std::process::id(), uid: unsafe { libc::geteuid() }, gid: unsafe { libc::getegid() } }
+}
+
+fn pair() -> io::Result<(OwnedFd, CredentialedSocket)> {
+    let mut fds = [-1; 2];
+    // SAFETY: fds holds both socketpair outputs, then ownership is unique.
+    if unsafe { libc::socketpair(libc::AF_UNIX, libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC, 0, fds.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let (client, server) = unsafe { (OwnedFd::from_raw_fd(fds[0]), OwnedFd::from_raw_fd(fds[1])) };
+    let enabled: libc::c_int = 1;
+    // SAFETY: valid owned FD and correctly-sized integer socket option.
+    if unsafe { libc::setsockopt(client.as_raw_fd(), libc::SOL_SOCKET, libc::SO_PASSCRED,
+        (&raw const enabled).cast(), std::mem::size_of_val(&enabled) as _) } != 0 { return Err(io::Error::last_os_error()); }
+    let send_bound = MAX_PACKET_BYTES as libc::c_int;
+    // Bound the real socket queue so the large-write cancellation case cannot
+    // enqueue its entire 16MiB payload before the test observes the header.
+    if unsafe { libc::setsockopt(client.as_raw_fd(), libc::SOL_SOCKET, libc::SO_SNDBUF,
+        (&raw const send_bound).cast(), std::mem::size_of_val(&send_bound) as _) } != 0 { return Err(io::Error::last_os_error()); }
+    Ok((client, CredentialedSocket::new(server, identity())?))
+}
+
+fn ready() -> Value {
+    json!({"type":"ready","schema":SCHEMA,"sessionId":"host-test","workspaceRoot":"file:///scope",
+        "chunkBytes":CHUNK_BYTES,"maxDataBytes":MAX_DATA_BYTES,"maxPacketBytes":MAX_PACKET_BYTES,"operations":OPERATIONS})
+}
+async fn deadline<T>(future: impl Future<Output = T>) -> T {
+    tokio::time::timeout(Duration::from_secs(20), future).await.expect("host protocol must terminate")
+}
+async fn send(server: &CredentialedSocket, value: Value) -> io::Result<()> { server.send(&serde_json::to_vec(&value)?).await }
+async fn receive(server: &CredentialedSocket) -> io::Result<Value> {
+    Ok(serde_json::from_slice(&deadline(server.receive(MAX_PACKET_BYTES)).await?)?)
+}
+async fn connected() -> io::Result<(Arc<HostFileSystem>, CredentialedSocket)> {
+    let (client, server) = pair()?;
+    send(&server, ready()).await?;
+    Ok((deadline(HostFileSystem::connect(client, identity(), "host-test")).await?, server))
+}
+fn path() -> PathUri { "file:///scope/file".parse().unwrap() }
+fn chunk(id: u64, index: usize, bytes: &[u8]) -> Value { json!({"type":"chunk","id":id,"index":index,"dataBase64":STANDARD.encode(bytes)}) }
+fn result(id: u64, payload: Value) -> Value { json!({"type":"result","id":id,"result":payload}) }
+async fn assert_closed(files: &HostFileSystem, server: &CredentialedSocket) {
+    assert_eq!(deadline(files.read_file(&path(), Default::default(), /*sandbox*/ None)).await.unwrap_err().kind(), io::ErrorKind::BrokenPipe);
+    assert_eq!(deadline(server.receive(MAX_PACKET_BYTES)).await.unwrap_err().kind(), io::ErrorKind::UnexpectedEof);
+}
+
+#[tokio::test]
+async fn rejects_unbound_malformed_and_wrong_credential_handshakes() -> io::Result<()> {
+    let mut packets = vec![b"[]".to_vec(), b"{}".to_vec(), b"{\"type\":\"ready\",\"type\":\"ready\"}".to_vec()];
+    for (field, value) in [("schema", json!("foldgpt.bootstrap-files.v1")), ("sessionId", json!("other")),
+        ("workspaceRoot", json!("https://example.com/scope")), ("workspaceRoot", json!("file:///scope/../elsewhere")),
+        ("chunkBytes", json!(CHUNK_BYTES + 1)), ("maxDataBytes", json!(MAX_DATA_BYTES + 1)),
+        ("operations", json!(["readFile"])), ("extra", json!(true))] {
+        let mut message = ready(); message[field] = value; packets.push(serde_json::to_vec(&message)?);
+    }
+    for packet in packets {
+        let (client, server) = pair()?;
+        server.send(&packet).await?;
+        assert_eq!(deadline(HostFileSystem::connect(client, identity(), "host-test")).await.err().unwrap().kind(), io::ErrorKind::InvalidData);
+        assert_eq!(deadline(server.receive(MAX_PACKET_BYTES)).await.unwrap_err().kind(), io::ErrorKind::UnexpectedEof);
+    }
+    let (client, server) = pair()?;
+    send(&server, ready()).await?;
+    let wrong = BootstrapPeer { pid: if std::process::id() == 1 { 2 } else { 1 }, ..identity() };
+    assert_eq!(deadline(HostFileSystem::connect(client, wrong, "host-test")).await.err().unwrap().kind(), io::ErrorKind::PermissionDenied);
+    Ok(())
+}
+
+#[tokio::test]
+async fn exact_write_chunks_and_explicit_commit_cover_empty_and_maximum_payloads() -> io::Result<()> {
+    let (files, server) = connected().await?;
+    for (index, size) in [0, 1, CHUNK_BYTES - 1, CHUNK_BYTES, CHUNK_BYTES + 1, MAX_DATA_BYTES].into_iter().enumerate() {
+        let id = index + 1;
+        let bytes: Vec<_> = (0..size).map(|value| value as u8).collect();
+        let target = path();
+        let (written, answered) = deadline(async {
+            tokio::join!(files.write_file(&target, bytes.clone(), Default::default(), /*sandbox*/ None), async {
+                assert_eq!(receive(&server).await?, json!({"id":id,"op":"writeFile","path":target,"bytes":size,"chunks":size.div_ceil(CHUNK_BYTES)}));
+                let mut actual = Vec::new();
+                for (number, block) in bytes.chunks(CHUNK_BYTES).enumerate() {
+                    let received = receive(&server).await?;
+                    assert_eq!(received, chunk(id as u64, number, block));
+                    actual.extend_from_slice(&STANDARD.decode(received["dataBase64"].as_str().unwrap()).unwrap());
+                }
+                assert_eq!(actual, bytes);
+                assert_eq!(receive(&server).await?, json!({"type":"commit","id":id}));
+                send(&server, result(id as u64, json!({}))).await
+            })
+        }).await;
+        written?; answered?;
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn six_operations_preserve_actual_protocol_types_and_order() -> io::Result<()> {
+    let (files, server) = connected().await?;
+    let target = path();
+    let requests = async {
+        assert_eq!(files.read_file(&target, Default::default(), /*sandbox*/ None).await?, b"\0\xffutf8\xc3\xa9");
+        assert_eq!(files.get_metadata(&target, GetMetadataOptions { follow_symlinks: false }, /*sandbox*/ None).await?,
+            crate::FileMetadata { is_directory:false, is_file:true, is_symlink:false, size:8, created_at_ms:-1, modified_at_ms:42 });
+        assert_eq!(files.canonicalize(&target, /*sandbox*/ None).await?, target);
+        assert_eq!(files.read_directory(&target, /*sandbox*/ None).await?, vec![crate::ReadDirectoryEntry { file_name:"private".into(), is_directory:true, is_file:false }]);
+        files.create_directory(&target, CreateDirectoryOptions { recursive:false, follow_symlinks:true }, /*sandbox*/ None).await?;
+        io::Result::Ok(())
+    };
+    let replies = async {
+        assert_eq!(receive(&server).await?, json!({"id":1,"op":"readFile","path":target}));
+        send(&server, chunk(1, 0, b"\0\xffutf8\xc3\xa9")).await?;
+        send(&server, result(1, json!({"bytes":8,"chunks":1}))).await?;
+        assert_eq!(receive(&server).await?, json!({"id":2,"op":"getMetadata","path":target,"followSymlinks":false}));
+        send(&server, result(2, json!({"isDirectory":false,"isFile":true,"isSymlink":false,"size":8,"createdAtMs":-1,"modifiedAtMs":42}))).await?;
+        assert_eq!(receive(&server).await?, json!({"id":3,"op":"canonicalize","path":target}));
+        send(&server, result(3, json!({"path":target}))).await?;
+        assert_eq!(receive(&server).await?, json!({"id":4,"op":"readDirectory","path":target}));
+        let entries = serde_json::to_vec(&json!({"entries":[{"fileName":"private","isDirectory":true,"isFile":false}]}))?;
+        send(&server, chunk(4, 0, &entries)).await?;
+        send(&server, result(4, json!({"bytes":entries.len(),"chunks":1}))).await?;
+        assert_eq!(receive(&server).await?, json!({"id":5,"op":"createDirectory","path":target,"recursive":false}));
+        send(&server, result(5, json!({}))).await
+    };
+    let (requests, replies) = deadline(async { tokio::join!(requests, replies) }).await;
+    requests?; replies?; Ok(())
+}
+
+#[tokio::test]
+async fn model_context_unsupported_outside_and_oversized_calls_send_nothing() -> io::Result<()> {
+    let (files, server) = connected().await?;
+    let target = path();
+    let sandbox = FileSystemSandboxContext::from_permission_profile(codex_protocol::models::PermissionProfile::Disabled);
+    assert_eq!(files.write_file(&target, b"model".to_vec(), Default::default(), Some(&sandbox)).await.unwrap_err().kind(), io::ErrorKind::PermissionDenied);
+    assert_eq!(files.read_file(&"file:///scope-other/file".parse().unwrap(), Default::default(), /*sandbox*/ None).await.unwrap_err().kind(), io::ErrorKind::PermissionDenied);
+    assert_eq!(files.write_file(&target, vec![0; MAX_DATA_BYTES + 1], Default::default(), /*sandbox*/ None).await.unwrap_err().kind(), io::ErrorKind::InvalidInput);
+    assert_eq!(files.read_file_stream(&target, /*sandbox*/ None).await.err().unwrap().kind(), io::ErrorKind::Unsupported);
+    let (written, answered) = deadline(async {
+        tokio::join!(files.write_file(&target, Vec::new(), Default::default(), /*sandbox*/ None), async {
+            assert_eq!(receive(&server).await?, json!({"id":1,"op":"writeFile","path":target,"bytes":0,"chunks":0}));
+            assert_eq!(receive(&server).await?, json!({"id":1,"type":"commit"}));
+            send(&server, result(1, json!({}))).await
+        })
+    }).await;
+    written?; answered?; Ok(())
+}
+
+#[tokio::test]
+async fn refused_writes_preserve_error_and_are_never_automatically_retried() -> io::Result<()> {
+    let (files, server) = connected().await?;
+    for (index, (code, kind)) in [(-32004, io::ErrorKind::NotFound), (-32000, io::ErrorKind::PermissionDenied),
+        (-32600, io::ErrorKind::PermissionDenied), (-32603, io::ErrorKind::Other)].into_iter().enumerate() {
+        let id = index + 1;
+        let target = path();
+        let (written, answered) = deadline(async {
+            tokio::join!(files.write_file(&target, Vec::new(), Default::default(), /*sandbox*/ None), async {
+                assert_eq!(receive(&server).await?, json!({"id":id,"op":"writeFile","path":target,"bytes":0,"chunks":0}));
+                assert_eq!(receive(&server).await?, json!({"type":"commit","id":id}));
+                send(&server, json!({"type":"error","id":id,"error":{"code":code,"message":"actual refusal"}})).await
+            })
+        }).await;
+        answered?; let error = written.unwrap_err();
+        assert_eq!((error.kind(), error.to_string()), (kind, "actual refusal".to_string()));
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn malformed_write_results_close_the_channel_after_one_commit() -> io::Result<()> {
+    for reply in [result(1, json!([])), result(1, Value::Null), result(2, json!({})), result(1, json!({"extra":true})),
+        json!({"type":"result","id":1,"result":{},"extra":1}), json!({"type":"error","id":1,"error":{"code":-1,"message":"unknown"}})] {
+        let (files, server) = connected().await?;
+        let target = path();
+        let (written, answered) = deadline(async {
+            tokio::join!(files.write_file(&target, Vec::new(), Default::default(), /*sandbox*/ None), async {
+                receive(&server).await?; receive(&server).await?; send(&server, reply).await
+            })
+        }).await;
+        answered?; assert_eq!(written.unwrap_err().kind(), io::ErrorKind::InvalidData);
+        assert_closed(&files, &server).await;
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn malformed_read_framing_never_returns_partial_data() -> io::Result<()> {
+    let cases = vec![
+        vec![chunk(2, 0, b"x")], vec![chunk(1, 1, b"x")], vec![chunk(1, 0, b"")],
+        vec![chunk(1, 0, b"x"), chunk(1, 1, b"y")],
+        vec![json!({"type":"chunk","id":1,"index":0,"dataBase64":"YR=="})],
+        vec![chunk(1, 0, b"x"), result(1, json!({"bytes":2,"chunks":1}))],
+        vec![chunk(1, 0, b"x"), json!({"type":"error","id":1,"error":{"code":-32004,"message":"after chunk"}})],
+        vec![result(1, json!([0, 0]))],
+    ];
+    for replies in cases {
+        let (files, server) = connected().await?;
+        let target = path();
+        let (read, answered) = deadline(async {
+            tokio::join!(files.read_file(&target, Default::default(), /*sandbox*/ None), async {
+                receive(&server).await?;
+                for reply in replies { send(&server, reply).await?; }
+                io::Result::Ok(())
+            })
+        }).await;
+        answered?; assert_eq!(read.unwrap_err().kind(), io::ErrorKind::InvalidData);
+        assert_closed(&files, &server).await;
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn invalid_typed_directory_closes_before_any_queued_call_is_admitted() -> io::Result<()> {
+    let (files, server) = connected().await?;
+    let directory_files = Arc::clone(&files);
+    let directory = tokio::spawn(async move { directory_files.read_directory(&path(), /*sandbox*/ None).await });
+    receive(&server).await?;
+    let target = path();
+    let mut queued = Box::pin(files.read_file(&target, Default::default(), /*sandbox*/ None));
+    assert!(futures::poll!(&mut queued).is_pending());
+    let entries = br#"{"entries":[{"fileName":"..","isDirectory":true,"isFile":false}]}"#;
+    send(&server, chunk(1, 0, entries)).await?;
+    send(&server, result(1, json!({"bytes":entries.len(),"chunks":1}))).await?;
+    assert_eq!(deadline(directory).await.unwrap().unwrap_err().kind(), io::ErrorKind::InvalidData);
+    assert_eq!(deadline(queued).await.unwrap_err().kind(), io::ErrorKind::BrokenPipe);
+    assert_closed(&files, &server).await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn cancelling_queued_request_preserves_the_active_exchange() -> io::Result<()> {
+    let (files, server) = connected().await?;
+    let target = path();
+    let mut active = Box::pin(files.read_file(&target, Default::default(), /*sandbox*/ None));
+    deadline(async { tokio::select! {
+        result = &mut active => panic!("premature result: {result:?}"),
+        request = receive(&server) => request,
+    }}).await?;
+    let mut waiting = Box::pin(files.write_file(&target, Vec::new(), Default::default(), /*sandbox*/ None));
+    assert!(futures::poll!(&mut waiting).is_pending()); drop(waiting);
+    send(&server, result(1, json!({"bytes":0,"chunks":0}))).await?;
+    assert_eq!(deadline(active).await?, Vec::<u8>::new());
+    let (read, answered) = deadline(async {
+        tokio::join!(files.read_file(&target, Default::default(), /*sandbox*/ None), async {
+            assert_eq!(receive(&server).await?, json!({"id":2,"op":"readFile","path":target}));
+            send(&server, result(2, json!({"bytes":0,"chunks":0}))).await
+        })
+    }).await;
+    assert_eq!(read?, Vec::<u8>::new()); answered?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn duplicate_keys_and_positional_metadata_are_not_typed_objects() -> io::Result<()> {
+    for packet in [
+        br#"{"type":"result","id":1,"result":{"isDirectory":false,"isFile":true,"isSymlink":false,"size":1,"size":1,"createdAtMs":1,"modifiedAtMs":1}}"#.as_slice(),
+        br#"{"type":"result","id":1,"result":[false,true,false,1,1,1]}"#.as_slice(),
+        br#"{"type":"result","id":1,"id":1,"result":{"isDirectory":false,"isFile":true,"isSymlink":false,"size":1,"createdAtMs":1,"modifiedAtMs":1}}"#.as_slice(),
+    ] {
+        let (files, server) = connected().await?;
+        let target = path();
+        let (metadata, answered) = deadline(async {
+            tokio::join!(files.get_metadata(&target, Default::default(), /*sandbox*/ None), async {
+                receive(&server).await?; server.send(packet).await
+            })
+        }).await;
+        answered?; assert_eq!(metadata.unwrap_err().kind(), io::ErrorKind::InvalidData);
+        assert_closed(&files, &server).await;
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn cancellation_after_commit_closes_instead_of_retrying_uncertain_write() -> io::Result<()> {
+    let (files, server) = connected().await?;
+    let writer = Arc::clone(&files);
+    let pending = tokio::spawn(async move { writer.write_file(&path(), b"content".to_vec(), Default::default(), /*sandbox*/ None).await });
+    receive(&server).await?;
+    assert_eq!(receive(&server).await?, chunk(1, 0, b"content"));
+    assert_eq!(receive(&server).await?, json!({"type":"commit","id":1}));
+    pending.abort(); assert!(deadline(pending).await.unwrap_err().is_cancelled());
+    assert_closed(&files, &server).await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn cancellation_during_large_write_never_sends_a_commit() -> io::Result<()> {
+    let (files, server) = connected().await?;
+    let writer = Arc::clone(&files);
+    let pending = tokio::spawn(async move { writer.write_file(&path(), vec![42; MAX_DATA_BYTES], Default::default(), /*sandbox*/ None).await });
+    receive(&server).await?;
+    pending.abort(); assert!(deadline(pending).await.unwrap_err().is_cancelled());
+    loop {
+        match deadline(server.receive(MAX_PACKET_BYTES)).await {
+            Ok(bytes) => assert_eq!(serde_json::from_slice::<Value>(&bytes)?["type"], "chunk"),
+            Err(error) => { assert_eq!(error.kind(), io::ErrorKind::UnexpectedEof); break; }
+        }
+    }
+    assert_closed(&files, &server).await;
+    Ok(())
+}
