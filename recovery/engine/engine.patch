+        let mut stderr = Vec::new();
+        loop {
+            let response = process.read(after, Some(32768), Some(100)).await?;
+            anyhow::ensure!(
+                response.failure.is_none(),
+                "native process failed: {response:?}"
+            );
+            for chunk in response.chunks {
