+#[tokio::test]
+async fn runtime_replacement_resumes_with_current_environments_before_first_turn(local: bool) {
+    let temp_dir = tempdir().expect("tempdir");
+    let mut config = test_config().await;
+    config.codex_home = temp_dir.path().join("codex-home").abs();
+    config.cwd = config.codex_home.abs();
+    std::fs::create_dir_all(&config.codex_home).expect("create codex home");
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+    );
+    let source = manager
+        .start_thread(StartThreadOptions::new(config.clone()))
+        .await
+        .expect("start default local thread");
+    source.thread.ensure_rollout_materialized().await;
+    source
+        .thread
+        .flush_rollout()
+        .await
+        .expect("flush source rollout");
+    let rollout_path = source.thread.rollout_path().expect("materialized rollout");
+    source
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shutdown original runtime");
+    manager.remove_thread(&source.thread_id).await;
+
+    let selected_cwd = config.cwd.join("selected");
+    std::fs::create_dir_all(&selected_cwd).expect("create selected cwd");
+    let selections = if local {
+        vec![TurnEnvironmentSelection {
+            environment_id: "local".to_string(),
+            cwd: PathUri::from_abs_path(&selected_cwd),
+            workspace_roots: Vec::new(),
+            config: EnvironmentConfigState::FromThread,
+        }]
+    } else {
+        Vec::new()
+    };
+    let initial_history = manager
+        .initial_history_from_rollout_path(rollout_path)
+        .await
+        .expect("read recorded history");
+    let resumed = manager
+        .resume_thread_with_options(
+            StartThreadOptions {
+                initial_history,
+                environments: Some(selections.clone()),
+                ..StartThreadOptions::new(config)
+            },
+            Arc::clone(&manager.state.auth_manager),
+        )
+        .await
+        .expect("replace runtime");
+    // No restore_thread_settings call precedes either observation. Runtime
+    // startup and the first prepared turn must already use the chosen selection.
+    assert_eq!(
+        (
+            resumed.thread_id,
+            resumed.thread.environment_selections().await
+        ),
+        (source.thread_id, selections.clone())
+    );
+    let (turn, _) = resumed
+        .thread
+        .session
+        .new_turn_with_sub_id(
+            "replacement-turn".to_string(),
+            SessionSettingsUpdate::default(),
+            Default::default(),
+        )
+        .await
+        .expect("prepare first replacement turn");
+    let primary_cwd = turn
+        .environments
+        .primary()
+        .map(|environment| environment.cwd().clone());
+    assert_eq!(
+        primary_cwd,
+        selections.first().map(|selection| selection.cwd.clone())
+    );
+    resumed
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shutdown replacement runtime");
+}
