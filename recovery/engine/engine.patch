+const PEER: &str = include_str!("fixtures/runtime_acquisition_peer.py");
+
+#[derive(Deserialize)]
+struct Started {
+    pid: u32,
+    uid: u32,
+    gid: u32,
+    socket: String,
+}
+
+struct Peer {
+    root: tempfile::TempDir,
+    process: tokio::process::Child,
+    output: BufReader<tokio::process::ChildStdout>,
+    started: Started,
+}
+
+impl Peer {
+    async fn spawn(mode: &str) -> anyhow::Result<Self> {
+        let root = tempfile::tempdir()?;
+        let mut process = tokio::process::Command::new("python3")
+            .args(["-I", "-S", "-B", "-u", "-c", PEER])
+            .arg(root.path())
+            .arg(mode)
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::inherit())
+            .kill_on_drop(true)
+            .spawn()?;
+        let mut output = BufReader::new(process.stdout.take().unwrap());
+        let mut line = String::new();
+        output.read_line(&mut line).await?;
+        Ok(Self {
+            root,
+            process,
+            output,
+            started: serde_json::from_str(&line)?,
+        })
+    }
+
+    fn identity(&self) -> BootstrapPeer {
+        BootstrapPeer {
+            pid: self.started.pid,
+            uid: self.started.uid,
+            gid: self.started.gid,
+        }
+    }
+
+    async fn acquire(&self) -> io::Result<NativeRuntimeChannels> {
+        NativeRuntimeChannels::acquire(
+            std::path::Path::new(&self.started.socket),
+            self.identity(),
+            PathUri::from_host_native_path(self.root.path())?,
+        )
+        .await
+    }
+
+    async fn finish(mut self) -> anyhow::Result<serde_json::Value> {
+        let mut output = String::new();
+        self.output.read_to_string(&mut output).await?;
+        assert!(self.process.wait().await?.success(), "{output}");
+        Ok(serde_json::from_str(output.trim())?)
+    }
+}
