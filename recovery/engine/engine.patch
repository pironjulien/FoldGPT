+use codex_core::config::edit::ConfigEditsBuilder;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+use std::io;
+use std::path::Path;
+
+/// Resolves a trust key with the same authority that loaded the project.
+/// Provider refusals must reach thread/start, never turn into local trust.
+pub(super) async fn trust_target(config: &Config) -> io::Result<(AbsolutePathBuf, String)> {
+    let Some(project) = config.project_filesystem.as_ref() else {
+        let target =
+            super::resolve_root_git_project_for_trust(super::LOCAL_FS.as_ref(), &config.cwd)
+                .await
+                .unwrap_or_else(|| config.cwd.clone());
+        let key = super::project_trust_key(target.as_path());
+        return Ok((target, key));
+    };
+    let target = project
+        .trust_root(&config.cwd)
+        .await?
+        .unwrap_or_else(|| config.cwd.clone());
+    let canonical = project
+        .filesystem()
+        .canonicalize(&PathUri::from_abs_path(&target), /*sandbox*/ None)
+        .await?;
+    let target = canonical.to_abs_path()?;
+    if project
+        .discovery_root()
+        .is_some_and(|root| !target.starts_with(root))
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "project trust target escapes the bootstrap root",
+        ));
+    }
+    let key = target.to_string_lossy().into_owned();
+    let key = if cfg!(windows) {
+        key.to_ascii_lowercase()
+    } else {
+        key
+    };
+    Ok((target, key))
+}
+
+/// The key is already canonical in the execution filesystem. Serializing it as
+/// a config path prevents ConfigEditsBuilder from probing the controller again.
+pub(super) fn persist_trust(codex_home: &Path, key: String) -> anyhow::Result<()> {
+    ConfigEditsBuilder::new(codex_home)
+        .with_edits([ConfigEdit::SetPath {
+            segments: vec!["projects".to_string(), key, "trust_level".to_string()],
+            value: toml_edit::value(TrustLevel::Trusted.to_string()),
+        }])
+        .apply_blocking()
+}
