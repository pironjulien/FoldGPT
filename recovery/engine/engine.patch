+#[tokio::test]
+async fn session_mismatch_revokes_lifetime_without_retry() -> anyhow::Result<()> {
+    tokio::time::timeout(Duration::from_secs(15), async {
+        let peer = Peer::spawn("wrong_session").await?;
+        let mut channels = peer.acquire().await?;
+        channels
+            .exec
+            .write_all(b"descriptor-transport-test")
