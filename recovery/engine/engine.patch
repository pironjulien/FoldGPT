+    )
+    .await
+    .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::InvalidInput);
+    assert!(calls.paths.lock().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn bootstrap_rejects_fallback_path_outside_discovery_root() {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.abs().join("project");
+    fs::create_dir(&root).unwrap();
+    fs::write(temp.path().join("outside.md"), "outside instructions").unwrap();
+    let mut config = make_config_with_fallback(
+        &temp,
+        /*limit*/ 4096,
+        /*instructions*/ None,
+        &["../outside.md"],
+    )
+    .await;
+    config.cwd = root.clone();
+    let calls = Arc::new(MetadataCallCounts::default());
+    config.project_filesystem = Some(ProjectConfigFileSystem::bounded(
+        Arc::new(FailingFileSystem {
+            path: root.clone(),
+            failure: InjectedFailure::BootstrapOnly,
+            metadata_calls: Arc::clone(&calls),
+        }),
+        root.clone(),
+    ));
+    let environments = resolved_local_environments([("local", root.clone())]);
+    let error = load_project_instructions(
+        &config.config,
+        /*user_instructions*/ None,
+        &environments,
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+    assert!(
+        calls
+            .paths
+            .lock()
+            .unwrap()
+            .iter()
+            .all(|path| { path.to_abs_path().unwrap().starts_with(root.as_path()) })
+    );
+}
