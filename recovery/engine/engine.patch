+#[tokio::test]
+async fn only_the_selected_primary_environment_can_supply_project_authority() -> Result<()> {
+    let home = TempDir::new()?;
+    let (root, project) = project_fixture(home.path())?;
+    // A real registered remote transport remains lazy. Configuration selection
+    // must not wait for it or borrow the available local runtime instead.
+    let listener = std::net::TcpListener::bind("127.0.0.1:0")?;
+    std::fs::write(
+        home.path().join("environments.toml"),
+        format!(
+            "default = 'remote'\ninclude_local = true\n[[environments]]\nid = 'remote'\nurl = 'ws://{}'\n",
+            listener.local_addr()?
+        ),
+    )?;
+    let runtime = Arc::new(Runtime {
+        environment: Environment::default_for_tests(),
+        project: project.clone(),
+        waits: AtomicUsize::new(0),
+    });
+    let environments = EnvironmentManager::prepare_from_codex_home(home.path())
+        .await?
+        .build_with_local_runtime(
+            runtime.clone(),
+            /*local_runtime_paths*/ None,
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        )?;
+    let service = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf())
+        .with_project_environments(Arc::new(environments));
+    let selection = |id: &str| TurnEnvironmentSelection {
+        environment_id: id.to_string(),
+        cwd: PathUri::from_abs_path(&root),
+        workspace_roots: Vec::new(),
+        config: EnvironmentConfigState::FromThread,
+    };
+    for selections in [
+        None,
+        Some(Vec::new()),
+        Some(vec![selection("remote"), selection("local")]),
+    ] {
+        let scoped = service
+            .for_thread_environments(selections.as_deref())
+            .await?;
+        let loaded = scoped.load_latest_config(Some(root.to_path_buf())).await?;
+        assert_eq!(
+            (
+                loaded.project_filesystem,
+                runtime.waits.load(Ordering::SeqCst)
+            ),
+            (None, 0)
+        );
+    }
+    let local = service
+        .for_thread_environments(Some(&[selection("local"), selection("remote")]))
+        .await?;
+    let loaded = local.load_latest_config(Some(root.to_path_buf())).await?;
+    assert_eq!(
+        (
+            loaded.project_filesystem,
+            runtime.waits.load(Ordering::SeqCst)
+        ),
+        (Some(project), 1)
+    );
+    let error = service
+        .for_thread_environments(Some(&[selection("missing")]))
+        .await
+        .err()
+        .expect("missing selection must not fall back to controller");
+    assert_eq!(error.kind(), std::io::ErrorKind::NotFound);
+    Ok(())
+}
