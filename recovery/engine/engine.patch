index 0000000000000000000000000000000000000000..9dc765d262f912cb1f586fed072ea4a633f2b583
--- /dev/null
+++ b/codex-rs/app-server/tests/suite/v2/native_app_server_bootstrap.rs
@@ -0,0 +1,110 @@
+use std::collections::HashSet;
+use std::fs::File;
+use std::os::fd::FromRawFd;
+use std::os::fd::OwnedFd;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use anyhow::Context;
+use anyhow::Result;
+use codex_app_server::AppServerRuntimeOptions;
+use codex_app_server::AppServerTransport;
+use codex_app_server::AppServerWebsocketAuthSettings;
+use codex_app_server::PluginStartupTasks;
+use codex_app_server::RemoteControlStartupMode;
+use codex_app_server::run_main_with_transport_options;
+use codex_arg0::Arg0DispatchPaths;
+use codex_config::LoaderOverrides;
+use codex_config::ProjectConfigFileSystem;
+use codex_exec_server::BootstrapFileSystem;
+use codex_exec_server::BootstrapPeer;
+use codex_exec_server::ControllerPathAccess;
+use codex_exec_server::ExecServerLocalRuntime;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use codex_protocol::protocol::SessionSource;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_cli::CliConfigOverrides;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::BufReader;
+
+pub(super) async fn run() -> Result<()> {
+    let fds: [i32; 4] = serde_json::from_str(&std::env::var("FOLDGPT_NATIVE_TEST_FDS")?)?;
+    anyhow::ensure!(fds.iter().all(|fd| *fd >= 3) && fds.iter().collect::<HashSet<_>>().len() == 4);
+    let peer: [u32; 3] = serde_json::from_str(&std::env::var("FOLDGPT_NATIVE_TEST_PEER")?)?;
+    anyhow::ensure!(peer[0] > 0 && peer[1] > 0);
+    let workspace =
+        AbsolutePathBuf::from_absolute_path(std::env::var("FOLDGPT_NATIVE_TEST_WORKSPACE")?)?;
+    let output = PathBuf::from(std::env::var("FOLDGPT_NATIVE_TEST_OUTPUT")?);
+    // The owner transfers four unique descriptors with pass_fds. They are never
+    // selectable through app-server requests or production environment discovery.
+    let (reader, writer, bootstrap, session) = unsafe {
+        (
+            File::from_raw_fd(fds[0]),
+            File::from_raw_fd(fds[1]),
+            OwnedFd::from_raw_fd(fds[2]),
+            File::from_raw_fd(fds[3]),
+        )
+    };
+    let runtime = ExecServerLocalRuntime::connect(
+        tokio::fs::File::from_std(reader),
+        tokio::fs::File::from_std(writer),
+        ControllerPathAccess::Shared,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    )
+    .await?;
+    let mut session_id = String::new();
+    BufReader::new(tokio::fs::File::from_std(session))
+        .read_line(&mut session_id)
+        .await?;
+    let filesystem = BootstrapFileSystem::connect(
+        bootstrap,
+        BootstrapPeer {
+            pid: peer[0],
+            uid: peer[1],
+            gid: peer[2],
+        },
+        session_id.trim_end(),
+    )
+    .await?;
+    // Shared is factual: this exact process can read the same ordinary PC path.
+    anyhow::ensure!(std::fs::read(workspace.join("shared-path-proof"))? == b"shared-native-path");
+    let runtime = runtime.with_project_filesystem(ProjectConfigFileSystem::bounded(
+        filesystem.clone(),
+        workspace,
+    ))?;
+    let options = AppServerRuntimeOptions {
+        plugin_startup_tasks: PluginStartupTasks::Skip,
+        remote_control_startup_mode: RemoteControlStartupMode::DisabledEphemeral,
+        install_shutdown_signal_handler: true,
+        ..Default::default()
+    }
+    .with_local_runtime(Arc::clone(&runtime) as _);
+    let result = run_main_with_transport_options(
+        Arg0DispatchPaths {
+            codex_self_exe: Some(std::env::current_exe()?),
+            ..Default::default()
+        },
+        CliConfigOverrides::default(),
+        LoaderOverrides::without_managed_config_for_tests(),
+        /*strict_config*/ true,
+        /*default_analytics_enabled*/ false,
+        AppServerTransport::from_listen_url(&std::env::var("FOLDGPT_NATIVE_TEST_LISTEN")?)?,
+        SessionSource::VSCode,
+        AppServerWebsocketAuthSettings::default(),
+        options,
+    )
+    .await;
+    filesystem.disconnect();
+    let disconnect = runtime.disconnect().await;
+    std::fs::write(
+        output.join("app-server-result.json"),
+        serde_json::to_vec_pretty(&serde_json::json!({
+            "result": result.as_ref().err().map(ToString::to_string),
+            "disconnect": disconnect.as_ref().err().map(ToString::to_string), "sharedPathProved": true
+        }))?,
+    )?;
+    result.context("real native app-server")?;
+    disconnect?;
+    Ok(())
+}
