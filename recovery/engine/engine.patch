+use codex_utils_pty::SpawnedProcess;
+use pretty_assertions::assert_eq;
+use tokio::sync::mpsc;
+use tokio::sync::watch;
+
+const CHILD_ARG: &str = "--owned-process-events-child";
+const FIXTURE_OUTPUT_LIMIT: usize = 2 * 1024 * 1024;
+
+// A real compiled subprocess avoids a Python/shell dependency in this transport test.
+#[ctor::ctor]
+fn run_child_fixture() {
+    if std::env::args().nth(1).as_deref() != Some(CHILD_ARG) {
+        return;
+    }
+    let result = (|| -> std::io::Result<()> {
+        let mut input = [0_u8; 6];
+        std::io::stdin().read_exact(&mut input)?;
+        let mut stdout = std::io::stdout().lock();
+        stdout.write_all(&input)?;
+        for index in 0..3000 {
+            stdout.write_all(&[(index % 251) as u8; 257])?;
+        }
+        stdout.flush()?;
+        let mut stderr = std::io::stderr().lock();
+        for index in 0..1500 {
+            stderr.write_all(&[(250 - index % 251) as u8; 257])?;
+        }
+        stderr.flush()
+    })();
+    std::process::exit(if result.is_ok() { 23 } else { 24 });
+}
+
+struct State {
+    chunks: Vec<ProcessOutputChunk>,
+    retained_bytes: usize,
+    next_seq: u64,
+    exit_code: Option<i32>,
+    closed: bool,
+}
+
+// This fixture lives outside the exec-server crate and uses its public runtime API.
+// Its retained output has a strict fixture-size cap; it is not an Android backend.
+struct PipeProcess {
+    id: ProcessId,
+    session: Arc<ProcessHandle>,
+    receiver: Mutex<Option<mpsc::Receiver<ExecProcessEvent>>>,
+    state: Arc<Mutex<State>>,
+    wake_tx: watch::Sender<u64>,
+}
+
+impl PipeProcess {
+    async fn spawn() -> Result<Self> {
+        let SpawnedProcess {
+            session,
+            mut stdout_rx,
+            mut stderr_rx,
+            mut exit_rx,
+        } = codex_utils_pty::spawn_pipe_process(
+            std::env::current_exe()?,
+            &[CHILD_ARG.to_owned()],
+            &std::env::current_dir()?,
+            &std::env::vars().collect::<HashMap<_, _>>(),
+            &None,
+            &[],
+        )
+        .await?;
+        let (events_tx, receiver) = mpsc::channel(1);
+        let (wake_tx, _) = watch::channel(0);
+        let state = Arc::new(Mutex::new(State {
+            chunks: Vec::new(),
+            retained_bytes: 0,
+            next_seq: 1,
+            exit_code: None,
+            closed: false,
+        }));
+        let retained = Arc::clone(&state);
+        let producer_wake = wake_tx.clone();
+        tokio::spawn(async move {
+            let mut stdout_open = true;
+            let mut stderr_open = true;
+            let mut exited = false;
+            loop {
+                let event = if !stdout_open && !stderr_open && exited {
+                    let mut state = retained.lock().expect("fixture state is available");
+                    state.closed = true;
+                    let seq = state.next_seq;
+                    state.next_seq += 1;
+                    ExecProcessEvent::Closed { seq }
+                } else {
+                    let mut output = None;
+                    let mut exit_code = None;
+                    tokio::select! {
+                        chunk = stdout_rx.recv(), if stdout_open => {
+                            stdout_open = chunk.is_some();
+                            output = chunk.map(|chunk| (ExecOutputStream::Stdout, chunk));
+                        }
+                        chunk = stderr_rx.recv(), if stderr_open => {
+                            stderr_open = chunk.is_some();
+                            output = chunk.map(|chunk| (ExecOutputStream::Stderr, chunk));
+                        }
+                        code = &mut exit_rx, if !exited => {
+                            exited = true;
+                            exit_code = Some(code.expect("actual child exit is available"));
+                        }
+                    };
+                    let mut state = retained.lock().expect("fixture state is available");
+                    let seq = state.next_seq;
+                    if let Some((stream, bytes)) = output {
+                        state.retained_bytes += bytes.len();
+                        assert!(state.retained_bytes <= FIXTURE_OUTPUT_LIMIT);
+                        let chunk = ProcessOutputChunk {
+                            seq,
+                            stream,
+                            chunk: bytes.into(),
+                        };
+                        state.chunks.push(chunk.clone());
+                        state.next_seq += 1;
+                        ExecProcessEvent::Output(chunk)
+                    } else if let Some(exit_code) = exit_code {
+                        state.exit_code = Some(exit_code);
+                        state.next_seq += 1;
+                        ExecProcessEvent::Exited {
+                            seq,
+                            exit_code,
+                            sandbox_denied: Some(false),
+                        }
+                    } else {
+                        continue;
+                    }
+                };
+                let closed = matches!(event, ExecProcessEvent::Closed { .. });
+                producer_wake.send_replace(
+                    retained
+                        .lock()
+                        .expect("fixture state is available")
+                        .next_seq,
+                );
+                if events_tx.send(event).await.is_err() || closed {
+                    break;
+                }
+            }
+        });
+        Ok(Self {
+            id: ProcessId::from("owned-real-child"),
+            session: Arc::new(session),
+            receiver: Mutex::new(Some(receiver)),
+            state,
+            wake_tx,
+        })
+    }
+}
+
+impl ExecProcess for PipeProcess {
+    fn process_id(&self) -> &ProcessId {
+        &self.id
+    }
+
+    fn subscribe_wake(&self) -> watch::Receiver<u64> {
+        self.wake_tx.subscribe()
+    }
+
+    fn subscribe_events(&self) -> ExecProcessEventReceiver {
+        let receiver = self
+            .receiver
+            .lock()
+            .expect("fixture receiver is available")
+            .take()
+            .expect("fixture has one output owner");
+        ExecProcessEventReceiver::from_owned_receiver(receiver)
+    }
+
+    fn read(
+        &self,
+        after_seq: Option<u64>,
+        max_bytes: Option<usize>,
+        wait_ms: Option<u64>,
+    ) -> ExecProcessFuture<'_, ReadResponse> {
+        Box::pin(async move {
+            let mut wake = self.subscribe_wake();
+            if let Some(wait_ms) = wait_ms.filter(|wait| *wait > 0) {
+                let should_wait = {
+                    let state = self.state.lock().expect("fixture state is available");
+                    !state.closed && state.next_seq <= after_seq.unwrap_or(0).saturating_add(1)
+                };
+                if should_wait {
+                    let _ =
+                        tokio::time::timeout(Duration::from_millis(wait_ms), wake.changed()).await;
+                }
+            }
+            let state = self.state.lock().expect("fixture state is available");
+            let mut chunks = Vec::new();
+            let mut bytes = 0;
+            for chunk in state
+                .chunks
+                .iter()
+                .filter(|chunk| chunk.seq > after_seq.unwrap_or(0))
+            {
+                if max_bytes.is_some_and(|limit| bytes >= limit) {
+                    break;
+                }
+                bytes += chunk.chunk.0.len();
+                chunks.push(chunk.clone());
+            }
+            let next_seq = if bytes < state.retained_bytes && max_bytes.is_some() {
+                chunks
+                    .last()
+                    .map_or(after_seq.unwrap_or(0).saturating_add(1), |chunk| {
+                        chunk.seq + 1
+                    })
+            } else {
+                state.next_seq
+            };
+            Ok(ReadResponse {
+                chunks,
+                next_seq,
+                exited: state.exit_code.is_some(),
+                exit_code: state.exit_code,
+                closed: state.closed,
+                failure: None,
+                sandbox_denied: false,
+            })
+        })
+    }
+
+    fn write(&self, chunk: Vec<u8>) -> ExecProcessFuture<'_, WriteResponse> {
+        Box::pin(async move {
+            self.session
+                .writer_sender()
+                .send(chunk)
+                .await
+                .map_err(|error| ExecServerError::Protocol(error.to_string()))?;
+            Ok(WriteResponse {
+                status: WriteStatus::Accepted,
+            })
+        })
+    }
+
+    fn signal(&self, signal: ProcessSignal) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async move {
+            match signal {
+                ProcessSignal::Interrupt => self
+                    .session
+                    .signal(codex_utils_pty::ProcessSignal::Interrupt),
+            }
+            .map_err(|error| ExecServerError::Protocol(error.to_string()))
+        })
+    }
+
+    fn terminate(&self) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async move {
+            self.session
+                .try_request_terminate()
+                .map_err(|error| ExecServerError::Protocol(error.to_string()))
+        })
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn owned_events_preserve_real_process_bytes_under_backpressure() -> Result<()> {
+    let process = PipeProcess::spawn().await?;
+    let input = vec![0, 255, 13, 10, 0, 128];
+    assert_eq!(
+        process.write(input.clone()).await?,
+        WriteResponse {
+            status: WriteStatus::Accepted
+        }
+    );
+    let mut events = process.subscribe_events();
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    // With a one-event queue, the producer cannot run ahead into unbounded storage.
+    assert!(process.state.lock().unwrap().next_seq <= 3);
+    let mut stdout = Vec::new();
+    let mut stderr = Vec::new();
+    let mut last_seq = 0;
+    let mut exit_code = None;
+    tokio::time::timeout(Duration::from_secs(15), async {
+        loop {
+            match events.recv().await.unwrap() {
+                ExecProcessEvent::Output(chunk) => {
+                    assert_eq!(chunk.seq, last_seq + 1);
+                    last_seq = chunk.seq;
+                    match chunk.stream {
+                        ExecOutputStream::Stdout => stdout.extend(chunk.chunk.0),
+                        ExecOutputStream::Stderr => stderr.extend(chunk.chunk.0),
+                        ExecOutputStream::Pty => panic!("pipe fixture emitted PTY bytes"),
+                    }
+                }
+                ExecProcessEvent::Exited {
+                    seq,
+                    exit_code: code,
+                    sandbox_denied,
+                } => {
+                    assert_eq!((seq, sandbox_denied), (last_seq + 1, Some(false)));
+                    last_seq = seq;
+                    exit_code = Some(code);
+                }
+                ExecProcessEvent::Closed { seq } => {
+                    assert_eq!(seq, last_seq + 1);
+                    break;
+                }
+                ExecProcessEvent::Failed(error) => panic!("real fixture failed: {error}"),
+            }
+        }
+    })
+    .await?;
+    let mut expected_stdout = input;
+    for index in 0..3000 {
+        expected_stdout.extend([(index % 251) as u8; 257]);
+    }
+    let mut expected_stderr = Vec::new();
+    for index in 0..1500 {
+        expected_stderr.extend([(250 - index % 251) as u8; 257]);
+    }
+    assert_eq!(
+        (stdout, stderr, exit_code),
+        (expected_stdout, expected_stderr, Some(23))
+    );
+    let retained = process.read(None, None, Some(0)).await?;
+    assert_eq!(
+        (retained.exited, retained.exit_code, retained.closed),
+        (true, Some(23), true)
+    );
+    assert_eq!(
+        retained
+            .chunks
+            .iter()
+            .map(|chunk| chunk.chunk.0.len())
+            .sum::<usize>(),
+        1_156_506
+    );
+    assert!(process.session.has_exited());
+    Ok(())
+}
+
+#[tokio::test]
+async fn owned_event_transport_failure_is_not_an_exit_status() {
+    let (sender, receiver) = mpsc::channel(1);
+    let mut events = ExecProcessEventReceiver::from_owned_receiver(receiver);
+    sender
+        .send(ExecProcessEvent::Failed("native connection lost".into()))
+        .await
+        .unwrap();
+    drop(sender);
+    assert_eq!(
+        events.recv().await.unwrap(),
+        ExecProcessEvent::Failed("native connection lost".into())
+    );
+    assert!(matches!(
+        events.recv().await,
+        Err(tokio::sync::broadcast::error::RecvError::Closed)
+    ));
+}
