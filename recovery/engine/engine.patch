+    let path = cwd.join(".codex/config.toml");
+    std::fs::write(&path, "project_doc_max_bytes = 'invalid-number'\n")?;
+    let controller = Environment::default_for_tests().get_filesystem();
+    let provider = Runtime {
+        home: home.path().to_path_buf(),
+        path_access: ControllerPathAccess::Shared,
+        environment: Environment::default_for_tests(),
+    }
+    .filesystem();
+    let stack = load_config_layers_state_with_project_fs(
+        controller.as_ref(),
+        provider.as_ref(),
+        home.path(),
+        Some(AbsolutePathBuf::from_absolute_path(cwd)?),
+        &[],
+        ConfigLoadOptions {
+            loader_overrides: LoaderOverrides::without_managed_config_for_tests(),
+            ..Default::default()
+        },
+        &NoopThreadConfigLoader,
+    )
+    .await?;
+    // A later controller read would now see valid text. Diagnostics must retain
+    // the bytes that the provider actually supplied to this loaded stack.
+    std::fs::write(&path, "project_doc_max_bytes = 1234\n")?;
+    let error = codex_config::first_layer_config_error::<codex_config::config_toml::ConfigToml>(
+        &stack,
+        "config.toml",
+    )
+    .await;
+    let error = error.context("invalid provider bytes were replaced by a controller reread")?;
+    assert_eq!(error.path, path);
+    Ok(())
+}
