index 0000000000000000000000000000000000000000..eb0487ab68df6720b0c85ecbe598770e7d8487dd
--- /dev/null
+++ b/codex-rs/exec-server/src/host_v2.rs
@@ -0,0 +1,209 @@
+//! Explicit version-2 human transport. Never selected by a model RPC or v1 retry.
+use std::collections::HashMap;
+use std::io;
+use std::os::fd::{AsRawFd, OwnedFd};
+use std::sync::{Arc, Mutex as StdMutex};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use codex_utils_path_uri::PathUri;
+use tokio::sync::{Mutex, Semaphore, oneshot};
+
+use crate::bootstrap_files_socket::{BootstrapPeer, CredentialedSocket};
+#[path = "host_v2_protocol.rs"]
+mod protocol;
+use protocol::*;
+#[path = "host_v2_files.rs"]
+mod files;
+#[path = "host_v2_processes.rs"]
+mod processes;
+pub use files::HostFileSystemV2;
+pub use processes::HostProcessCommandV2;
+
+/// Authenticated host FD multiplexing independent file and process requests.
+/// Files hold one bounded upload/read slot; process reads return one event each.
+/// No filesystem lease wait blocks cancellation or stdin on this connection.
+pub struct HostConnectionV2 {
+    socket: Arc<CredentialedSocket>,
+    workspace_root: PathUri,
+    session_id: String,
+    send_gate: Mutex<()>,
+    pending: StdMutex<HashMap<u64, Pending>>,
+    request_slots: Semaphore,
+    admission_slots: Semaphore,
+    file_slot: Semaphore,
+    next_id: AtomicU64,
+    closed: AtomicBool,
+}
+
+struct Pending {
+    response: oneshot::Sender<io::Result<Response>>,
+    allows_chunks: bool,
+    bytes: Vec<u8>,
+    chunks: usize,
+    short_chunk: bool,
+}
+
+struct Response { result: WireResult, bytes: Vec<u8>, chunks: usize }
+
+impl HostConnectionV2 {
+    pub async fn connect(descriptor: OwnedFd, peer: BootstrapPeer, expected_session: &str) -> io::Result<Arc<Self>> {
+        if expected_session.is_empty() || expected_session.len() > 128 { return Err(invalid("invalid host session identity")); }
+        for query in [libc::getsockname, libc::getpeername] {
+            let mut address: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+            let mut length = std::mem::size_of_val(&address) as libc::socklen_t;
+            // SAFETY: the live owned FD and bounded writable sockaddr are valid.
+            if unsafe { query(descriptor.as_raw_fd(), (&raw mut address).cast(), &raw mut length) } != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            if address.sun_family != libc::AF_UNIX as libc::sa_family_t || length as usize != std::mem::size_of::<libc::sa_family_t>() {
+                return Err(invalid("host v2 requires an anonymous socketpair"));
+            }
+        }
+        let socket = Arc::new(CredentialedSocket::new(descriptor, peer)?);
+        let ready: Ready = decode(&socket.receive(MAX_PACKET_BYTES).await?)?;
+        if ready.kind != "ready" || ready.schema != SCHEMA || ready.session_id != expected_session
+            || ready.chunk_bytes != CHUNK_BYTES || ready.max_data_bytes != MAX_DATA_BYTES
+            || ready.max_packet_bytes != MAX_PACKET_BYTES || ready.max_pending_requests != MAX_PENDING
+            || ready.operations != OPERATIONS {
+            return Err(invalid("host v2 handshake differs from its fixed session contract"));
+        }
+        let connection = Arc::new(Self { socket: Arc::clone(&socket), workspace_root: canonical_uri(&ready.workspace_root)?,
+            session_id: ready.session_id, send_gate: Mutex::new(()), pending: StdMutex::new(HashMap::new()),
+            request_slots: Semaphore::new(MAX_PENDING), admission_slots: Semaphore::new(MAX_PENDING / 2), file_slot: Semaphore::new(1),
+            next_id: AtomicU64::new(1), closed: AtomicBool::new(false) });
+        let weak = Arc::downgrade(&connection);
+        tokio::spawn(async move {
+            loop {
+                let packet = socket.receive(MAX_PACKET_BYTES).await;
+                let Some(connection) = weak.upgrade() else { break };
+                let outcome = packet.and_then(|packet| decode(&packet)).and_then(|reply| connection.receive(reply));
+                if let Err(error) = outcome {
+                    tracing::warn!(%error, "human host transport ended");
+                    connection.disconnect();
+                    break;
+                }
+            }
+        });
+        Ok(connection)
+    }
+
+    pub fn workspace_root(&self) -> &PathUri { &self.workspace_root }
+    pub fn session_id(&self) -> &str { &self.session_id }
+    pub fn filesystem(self: &Arc<Self>) -> Arc<HostFileSystemV2> { Arc::new(HostFileSystemV2 { connection: Arc::clone(self) }) }
+
+    pub fn disconnect(&self) {
+        self.closed.store(true, Ordering::Release);
+        self.request_slots.close();
+        self.admission_slots.close();
+        self.file_slot.close();
+        self.socket.shutdown();
+        if let Ok(mut pending) = self.pending.lock() {
+            for (_, request) in pending.drain() { let _ = request.response.send(Err(closed())); }
+        }
+    }
+
+    async fn send_packet(&self, value: serde_json::Value) -> io::Result<()> {
+        let _send = self.send_gate.lock().await;
+        if self.closed.load(Ordering::Acquire) { return Err(closed()); }
+        self.send_locked(value).await
+    }
+
+    async fn send_locked(&self, value: serde_json::Value) -> io::Result<()> {
+        let bytes = serde_json::to_vec(&value).map_err(invalid)?;
+        if bytes.len() > MAX_PACKET_BYTES { return Err(invalid("host request exceeds packet bound")); }
+        self.socket.send(&bytes).await
+    }
+
+    async fn request(&self, mut request: serde_json::Value, upload: Option<&[u8]>) -> io::Result<Response> {
+        // Starts can wait for the native file lease. Reserve half of the peer's
+        // in-flight budget so those waits cannot starve live I/O/cancellation.
+        let _admission = if !matches!(request["op"].as_str(), Some("processRead" | "processWrite" | "processTerminate")) {
+            Some(self.admission_slots.acquire().await.map_err(|_| closed())?)
+        } else { None };
+        let _slot = self.request_slots.acquire().await.map_err(|_| closed())?;
+        let send = self.send_gate.lock().await;
+        if self.closed.load(Ordering::Acquire) { return Err(closed()); }
+        let mut guard = RequestGuard { connection: self, complete: false };
+        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+        if id >= 1_u64 << 53 { return Err(invalid("host request identifiers exhausted")); }
+        request["id"] = id.into();
+        let allows_chunks = matches!(request["op"].as_str(), Some("readFile" | "readDirectory"));
+        let (response, receiver) = oneshot::channel();
+        self.pending.lock().map_err(invalid)?.insert(id, Pending { response, allows_chunks,
+            bytes: Vec::new(), chunks: 0, short_chunk: false });
+        self.send_locked(request).await?;
+        drop(send);
+        if let Some(bytes) = upload {
+            for (index, chunk) in bytes.chunks(CHUNK_BYTES).enumerate() {
+                self.send_packet(serde_json::json!({"type":"chunk","id":id,"index":index,"dataBase64":STANDARD.encode(chunk)})).await?;
+            }
+            self.send_packet(serde_json::json!({"type":"commit","id":id})).await?;
+        }
+        let response = receiver.await.map_err(|_| closed())?;
+        guard.complete = true;
+        response
+    }
+
+    fn receive(&self, reply: Reply) -> io::Result<()> {
+        let mut pending = self.pending.lock().map_err(invalid)?;
+        match reply {
+            Reply::Chunk { id, index, data_base64 } => {
+                let request = pending.get_mut(&id).ok_or_else(|| invalid("host chunk has no pending owner"))?;
+                let bytes = STANDARD.decode(&data_base64).map_err(invalid)?;
+                if !request.allows_chunks || request.short_chunk || request.chunks != index
+                    || bytes.is_empty() || bytes.len() > CHUNK_BYTES || request.bytes.len() + bytes.len() > MAX_DATA_BYTES
+                    || STANDARD.encode(&bytes) != data_base64 {
+                    return Err(invalid("invalid multiplexed host file chunk"));
+                }
+                request.short_chunk = bytes.len() < CHUNK_BYTES;
+                request.chunks += 1;
+                request.bytes.extend(bytes);
+            }
+            Reply::Result { id, result } => {
+                let request = pending.remove(&id).ok_or_else(|| invalid("host result has no pending owner"))?;
+                let _ = request.response.send(Ok(Response { result, bytes: request.bytes, chunks: request.chunks }));
+            }
+            Reply::Error { id, error } => {
+                let request = pending.remove(&id).ok_or_else(|| invalid("host error has no pending owner"))?;
+                if request.chunks != 0 { return Err(invalid("host error followed partial successful data")); }
+                let kind = match error.code {
+                    -32004 => io::ErrorKind::NotFound,
+                    -32000 | -32600 | -32602 => io::ErrorKind::PermissionDenied,
+                    -32603 => io::ErrorKind::Other,
+                    _ => return Err(invalid("unknown host authority error")),
+                };
+                let _ = request.response.send(Err(io::Error::new(kind, error.message)));
+            }
+        }
+        Ok(())
+    }
+
+    fn invalid_response<T>(&self, message: &str) -> io::Result<T> { self.disconnect(); Err(invalid(message)) }
+}
+
+impl Drop for HostConnectionV2 { fn drop(&mut self) { self.disconnect(); } }
+struct RequestGuard<'a> { connection: &'a HostConnectionV2, complete: bool }
+impl Drop for RequestGuard<'_> { fn drop(&mut self) { if !self.complete { self.connection.disconnect(); } } }
+fn invalid(error: impl std::fmt::Display) -> io::Error { io::Error::new(io::ErrorKind::InvalidData, error.to_string()) }
+fn closed() -> io::Error { io::Error::new(io::ErrorKind::BrokenPipe, "human host connection is closed") }
+fn canonical_uri(value: &str) -> io::Result<PathUri> {
+    let path: PathUri = value.parse().map_err(invalid)?;
+    if path.to_string() != value || PathUri::from_abs_path(&path.to_abs_path()?) != path { return Err(invalid("host path is not a canonical native URI")); }
+    Ok(path)
+}
+fn decode<T: serde::de::DeserializeOwned>(data: &[u8]) -> io::Result<T> {
+    let shape: serde_json::Value = serde_json::from_slice(data).map_err(invalid)?;
+    if !shape.is_object()
+        || ["result", "error"].iter().any(|key| shape.get(key).is_some_and(|value| !value.is_object()))
+        || shape.get("result").and_then(|result| result.get("event")).is_some_and(|event| !event.is_object())
+        || shape.get("entries").is_some_and(|entries| entries.as_array().is_none_or(|entries| entries.iter().any(|entry| !entry.is_object()))) {
+        return Err(invalid("host v2 protocol requires typed JSON objects"));
+    }
+    serde_json::from_slice(data).map_err(invalid)
+}
+
+#[cfg(test)]
+#[path = "host_v2_tests.rs"]
+mod tests;
