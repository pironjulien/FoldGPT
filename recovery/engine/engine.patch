@@ -0,0 +1,221 @@
+//! Linux message transport owned by the trusted native-runtime bootstrap.
+
+use std::io;
+use std::mem;
+use std::os::fd::AsRawFd;
+use std::os::fd::FromRawFd;
+use std::os::fd::OwnedFd;
+
+use tokio::io::Interest;
+use tokio::io::unix::AsyncFd;
+
+/// Kernel identity supplied by the owner, never read from a request payload.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct BootstrapPeer {
+    pub pid: u32,
+    pub uid: u32,
+    pub gid: u32,
+}
+
+pub(crate) struct CredentialedSocket {
+    descriptor: AsyncFd<OwnedFd>,
+    peer: BootstrapPeer,
+}
+
+impl CredentialedSocket {
+    /// Take an already connected private socket. No pathname can be selected.
+    pub(crate) fn new(descriptor: OwnedFd, peer: BootstrapPeer) -> io::Result<Self> {
+        if peer.pid == 0 || peer.pid > i32::MAX as u32 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "invalid bootstrap peer PID",
+            ));
+        }
+        let fd = descriptor.as_raw_fd();
+        if socket_option(fd, libc::SO_DOMAIN)? != libc::AF_UNIX
+            || socket_option(fd, libc::SO_TYPE)? != libc::SOCK_SEQPACKET
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "bootstrap requires AF_UNIX SOCK_SEQPACKET",
+            ));
+        }
+        let mut address: libc::sockaddr_un = unsafe { mem::zeroed() };
+        let mut length = mem::size_of_val(&address) as libc::socklen_t;
+        // SAFETY: address and length point to writable storage of the indicated size.
+        checked(unsafe { libc::getpeername(fd, (&raw mut address).cast(), &raw mut length) })?;
+        let enabled: libc::c_int = 1;
+        // SAFETY: enabled is a correctly sized SOL_SOCKET integer option.
+        checked(unsafe {
+            libc::setsockopt(
+                fd,
+                libc::SOL_SOCKET,
+                libc::SO_PASSCRED,
+                (&raw const enabled).cast(),
+                mem::size_of_val(&enabled) as libc::socklen_t,
+            )
+        })?;
+        // SAFETY: fcntl operates on the owned live descriptor; flags preserve existing bits.
+        let status = checked(unsafe { libc::fcntl(fd, libc::F_GETFL) })?;
+        checked(unsafe { libc::fcntl(fd, libc::F_SETFL, status | libc::O_NONBLOCK) })?;
+        let flags = checked(unsafe { libc::fcntl(fd, libc::F_GETFD) })?;
+        checked(unsafe { libc::fcntl(fd, libc::F_SETFD, flags | libc::FD_CLOEXEC) })?;
+        Ok(Self {
+            descriptor: AsyncFd::new(descriptor)?,
+            peer,
+        })
+    }
+
+    pub(crate) async fn send(&self, data: &[u8]) -> io::Result<()> {
+        let count = self
+            .descriptor
+            .async_io(Interest::WRITABLE, |fd| {
+                // SAFETY: data is readable for its length; MSG_NOSIGNAL prevents process-wide SIGPIPE.
+                let count = unsafe {
+                    libc::send(
+                        fd.as_raw_fd(),
+                        data.as_ptr().cast(),
+                        data.len(),
+                        libc::MSG_NOSIGNAL,
+                    )
+                };
+                if count < 0 {
+                    Err(io::Error::last_os_error())
+                } else {
+                    Ok(count as usize)
+                }
+            })
+            .await?;
+        if count != data.len() {
+            return Err(io::Error::new(
+                io::ErrorKind::WriteZero,
+                "incomplete bootstrap packet",
+            ));
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn receive(&self, maximum: usize) -> io::Result<Vec<u8>> {
+        self.descriptor
+            .async_io(Interest::READABLE, |fd| {
+                receive_packet(fd.as_raw_fd(), self.peer, maximum)
+            })
+            .await
+    }
+
+    pub(crate) fn shutdown(&self) {
+        // SAFETY: shutdown does not transfer ownership or close a reused descriptor.
+        unsafe {
+            libc::shutdown(self.descriptor.as_raw_fd(), libc::SHUT_RDWR);
+        }
+    }
+}
+
+fn checked(result: libc::c_int) -> io::Result<libc::c_int> {
+    if result < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(result)
+    }
+}
+
+fn socket_option(fd: libc::c_int, option: libc::c_int) -> io::Result<libc::c_int> {
+    let mut value: libc::c_int = 0;
+    let mut length = mem::size_of_val(&value) as libc::socklen_t;
+    // SAFETY: value and length are valid output buffers for an integer socket option.
+    checked(unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_SOCKET,
+            option,
+            (&raw mut value).cast(),
+            &raw mut length,
+        )
+    })?;
+    if length as usize != mem::size_of_val(&value) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "invalid socket option length",
+        ));
+    }
+    Ok(value)
+}
+
+fn receive_packet(fd: libc::c_int, expected: BootstrapPeer, maximum: usize) -> io::Result<Vec<u8>> {
+    let mut data = vec![0_u8; maximum];
+    // usize storage provides cmsghdr alignment. Any received rights are closed below.
+    let mut control = [0_usize; 64];
+    let mut vector = libc::iovec {
+        iov_base: data.as_mut_ptr().cast(),
+        iov_len: data.len(),
+    };
+    let mut message: libc::msghdr = unsafe { mem::zeroed() };
+    message.msg_iov = &raw mut vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.as_mut_ptr().cast();
+    message.msg_controllen = mem::size_of_val(&control);
+    // SAFETY: all buffers remain alive and writable for the whole syscall.
+    let count = unsafe { libc::recvmsg(fd, &raw mut message, libc::MSG_CMSG_CLOEXEC) };
+    if count < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut identity = None;
+    let mut invalid = false;
+    // SAFETY: the kernel populated this bounded, aligned ancillary buffer. CMSG_NXTHDR
+    // checks each next header against msg_controllen before returning it.
+    unsafe {
+        let mut header = libc::CMSG_FIRSTHDR(&raw const message);
+        while !header.is_null() {
+            let payload = (*header)
+                .cmsg_len
+                .saturating_sub(libc::CMSG_LEN(0) as usize);
+            if (*header).cmsg_level == libc::SOL_SOCKET && (*header).cmsg_type == libc::SCM_RIGHTS {
+                invalid = true;
+                for index in 0..payload / mem::size_of::<libc::c_int>() {
+                    let received = libc::CMSG_DATA(header)
+                        .cast::<libc::c_int>()
+                        .add(index)
+                        .read_unaligned();
+                    drop(OwnedFd::from_raw_fd(received));
+                }
+            } else if (*header).cmsg_level == libc::SOL_SOCKET
+                && (*header).cmsg_type == libc::SCM_CREDENTIALS
+                && payload == mem::size_of::<libc::ucred>()
+                && identity.is_none()
+            {
+                let cred = libc::CMSG_DATA(header)
+                    .cast::<libc::ucred>()
+                    .read_unaligned();
+                identity = Some(BootstrapPeer {
+                    pid: cred.pid as u32,
+                    uid: cred.uid,
+                    gid: cred.gid,
+                });
+            } else {
+                invalid = true;
+            }
+            header = libc::CMSG_NXTHDR(&raw const message, header);
+        }
+    }
+    if count == 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::UnexpectedEof,
+            "bootstrap channel closed",
+        ));
+    }
+    if invalid
+        || identity != Some(expected)
+        || message.msg_flags & (libc::MSG_TRUNC | libc::MSG_CTRUNC) != 0
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "bootstrap packet credentials or ancillary data rejected",
+        ));
+    }
+    data.truncate(count as usize);
+    Ok(data)
+}
+
