+#[tokio::test]
+async fn injected_local_runtime_absent_keeps_official_local_filesystem() -> Result<()> {
+    let home = TempDir::new()?;
+    let (mut child, address) = spawn(home.path(), "official").await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+    let read = rpc(
+        &mut client,
