+use codex_tools::ZshForkConfig;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+use pretty_assertions::assert_eq;
+
+use super::ResolvedEnvironment;
+use super::ThreadEnvironments;
+use crate::shell::Shell;
+use crate::shell::ShellType;
+use crate::shell_snapshot::ShellSnapshot;
+
+struct Runtime {
+    environment: Environment,
+    info: Result<EnvironmentInfo, String>,
+}
+
+impl LocalRuntime for Runtime {
+    fn exec_backend(&self) -> Arc<dyn ExecBackend> {
+        self.environment.get_exec_backend()
+    }
+    fn filesystem(&self) -> Arc<dyn ExecutorFileSystem> {
+        self.environment.get_filesystem()
+    }
+    fn sandbox_ownership(&self) -> LocalSandboxOwnership {
+        LocalSandboxOwnership {
+            process: SandboxOwner::Executor,
+            filesystem: SandboxOwner::Executor,
+        }
+    }
+    fn controller_path_access(&self) -> ControllerPathAccess {
+        ControllerPathAccess::Shared
+    }
+    fn info(&self) -> ExecProcessFuture<'_, EnvironmentInfo> {
+        Box::pin(async { self.info.clone().map_err(ExecServerError::Protocol) })
+    }
+    fn observed_status(&self) -> EnvironmentObservedStatus {
+        EnvironmentObservedStatus::Ready
+    }
+    fn wait_until_ready(&self) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async { Ok(()) })
+    }
+}
+
+fn runtime_info() -> EnvironmentInfo {
+    EnvironmentInfo {
+        shell: ShellInfo {
+            name: "bash".into(),
+            path: "/runtime/native/libfoldgpt_bash.so".into(),
+        },
+        cwd: Some(PathUri::parse("file:///executor/project").unwrap()),
+        user_home_dir: Some(PathUri::parse("file:///executor/home").unwrap()),
+        platform_os: Some("android".into()),
+        temporary_directories: Some(vec![PathUri::parse("file:///executor/tmp").unwrap()]),
+        temp_dir: Some(PathUri::parse("file:///executor/tmp").unwrap()),
+        capabilities: EnvironmentCapabilities::default(),
+    }
+}
+
+async fn resolve(
+    info: Result<EnvironmentInfo, String>,
+    snapshot: ShellSnapshot,
+) -> Result<ResolvedEnvironment, Arc<ExecServerError>> {
+    let home = tempfile::tempdir().unwrap();
+    std::fs::write(
+        home.path().join("environments.toml"),
+        "default = \"local\"\ninclude_local = true\n",
+    )
+    .unwrap();
+    let cwd = info
+        .as_ref()
+        .ok()
+        .and_then(|info| info.cwd.clone())
+        .unwrap_or_else(|| PathUri::parse("file:///executor/project").unwrap());
+    let runtime = Arc::new(Runtime {
+        environment: Environment::default_for_tests(),
+        info,
+    });
+    let manager = EnvironmentManager::prepare_from_codex_home(home.path())
+        .await
+        .unwrap()
+        .build_with_local_runtime(
+            runtime,
+            /*local_runtime_paths*/ None,
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        )
+        .unwrap();
+    let environment = manager.default_environment().unwrap();
+    ThreadEnvironments::resolve_environment(
+        TurnEnvironmentSelection {
+            environment_id: "local".into(),
+            cwd,
+            workspace_roots: vec![],
+            config: EnvironmentConfigState::FromThread,
+        },
+        environment,
+        Shell {
+            shell_type: ShellType::Zsh,
+            shell_path: PathBuf::from("/controller/zsh"),
+        },
+        snapshot,
+        /*configuration_ready*/ None,
+    )
+    .await
+}
+
+#[tokio::test]
+async fn injected_local_runtime_metadata_reaches_turn_without_controller_defaults() {
+    let expected = runtime_info();
+    let resolved = resolve(Ok(expected.clone()), ShellSnapshot::disabled())
+        .await
+        .unwrap();
+    assert!(!resolved.environment.is_remote());
+    assert_eq!(
+        (
+            resolved.shell,
+            resolved.user_home_dir,
+            resolved.executor_platform_os,
+            resolved.temporary_directories,
+            resolved.shell_snapshot_v2_supported
+        ),
+        (
+            Some(Shell {
+                shell_type: ShellType::Bash,
+                shell_path: PathBuf::from(expected.shell.path)
+            }),
+            expected.user_home_dir,
+            expected.platform_os,
+            expected.temporary_directories,
+            expected.capabilities.shell_snapshot_v2
+        ),
+    );
+}
+
+#[tokio::test]
+async fn injected_local_runtime_absent_metadata_stays_absent_and_capability_is_honored() {
+    let mut info = runtime_info();
+    info.user_home_dir = None;
+    info.platform_os = None;
+    info.temporary_directories = None;
+    info.capabilities.shell_snapshot_v2 = true;
+    let resolved = resolve(Ok(info), ShellSnapshot::disabled()).await.unwrap();
+    assert_eq!(
+        (
+            resolved.user_home_dir,
+            resolved.executor_platform_os,
+            resolved.temporary_directories,
+            resolved.shell_snapshot_v2_supported
+        ),
+        (None, None, None, true),
+    );
+}
+
+#[tokio::test]
+async fn injected_local_runtime_info_failure_prevents_ready_turn() {
+    let error = match resolve(
+        Err("runtime metadata disconnected".into()),
+        ShellSnapshot::disabled(),
+    )
+    .await
+    {
+        Ok(_) => panic!("metadata failure must not produce a ready local environment"),
+        Err(error) => error,
+    };
+    assert!(error.to_string().contains("runtime metadata disconnected"));
+}
+
+#[tokio::test]
+async fn injected_local_runtime_unknown_shell_prevents_controller_fallback() {
+    let mut info = runtime_info();
+    info.shell.name = "unknown-native-shell".into();
+    let error = match resolve(Ok(info), ShellSnapshot::disabled()).await {
+        Ok(_) => panic!("invalid runtime shell must not produce a ready local environment"),
+        Err(error) => error,
+    };
+    assert!(
+        error
+            .to_string()
+            .contains("invalid shell reported by local runtime")
+    );
+}
+
+#[tokio::test]
+async fn injected_local_runtime_uses_direct_shell_instead_of_controller_zsh_fork() {
+    let resolved = resolve(Ok(runtime_info()), ShellSnapshot::disabled())
+        .await
+        .unwrap();
+    let home = tempfile::tempdir().unwrap();
+    let mode = UnifiedExecShellMode::ZshFork(ZshForkConfig {
+        shell_zsh_path: AbsolutePathBuf::from_absolute_path(home.path().join("controller-zsh"))
+            .unwrap(),
+        main_execve_wrapper_exe: AbsolutePathBuf::from_absolute_path(
+            home.path().join("controller-wrapper"),
+        )
+        .unwrap(),
+    });
+    assert_eq!(
+        crate::tools::handlers::unified_exec::shell_mode_for_environment(
+            &mode,
+            &resolved.environment
+        ),
+        UnifiedExecShellMode::Direct,
+    );
+}
+
+#[tokio::test]
+#[cfg(unix)]
+async fn injected_local_runtime_never_launches_controller_v1_snapshot() {
+    use std::os::unix::fs::PermissionsExt;
+
+    let home = tempfile::tempdir().unwrap();
+    let marker = home.path().join("controller-shell-was-launched");
+    let executable = home.path().join("runtime-shell");
+    let marker_arg = shlex::try_quote(marker.to_str().unwrap()).unwrap();
+    std::fs::write(
+        &executable,
+        format!("#!/bin/sh\nprintf called > {marker_arg}\nexit 1\n"),
+    )
+    .unwrap();
+    std::fs::set_permissions(&executable, std::fs::Permissions::from_mode(0o755)).unwrap();
+    let mut info = runtime_info();
+    info.shell.path = executable.to_string_lossy().into_owned();
+    let cwd = PathUri::from_host_native_path(home.path()).unwrap();
+    info.cwd = Some(cwd.clone());
+    let shell = Shell::from_environment_shell_info(info.shell.clone()).unwrap();
+    let thread = ThreadId::new();
+    let telemetry = SessionTelemetry::new(
+        thread,
+        "test",
+        "test",
+        /*account_id*/ None,
+        /*account_email*/ None,
+        /*auth_mode*/ None,
+        "test-originator".into(),
+        /*log_user_prompts*/ false,
+        "test-terminal".into(),
+        SessionSource::Cli,
+    );
+    let snapshot = ShellSnapshot::new(
+        AbsolutePathBuf::from_absolute_path(home.path()).unwrap(),
+        thread,
+        telemetry,
+        /*state_db*/ None,
+    );
+    let resolved = resolve(Ok(info), snapshot.clone()).await.unwrap();
+    assert!(resolved.shell_snapshot.await.is_none());
+    assert!(
+        !marker.exists(),
+        "controller executed the runtime's shell during V1 capture"
+    );
+    assert!(!home.path().join("shell_snapshots").exists());
+    // Positive control: with an ordinary local environment this enabled V1
+    // capture reaches the executable and writes the marker before refusing its
+    // deliberate exit 1. The runtime assertion above cannot pass due to a broken
+    // test shell or an inaccessible cwd.
+    assert!(
+        snapshot
+            .build(Arc::new(Environment::default_for_tests()), cwd, Some(shell))
+            .await
+            .is_none()
+    );
+    assert!(
+        marker.exists(),
+        "ordinary local V1 capture did not reach the control executable"
+    );
+}
