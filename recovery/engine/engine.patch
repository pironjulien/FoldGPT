index 0000000000000000000000000000000000000000..2bcba09857d2ec2655726ce0de1ac251d9e7af9a
--- /dev/null
+++ b/codex-rs/exec-server/src/bootstrap_files.rs
@@ -0,0 +1,275 @@
+//! Separate read authority for trusted project bootstrap, never a model backend.
+
+use std::collections::HashSet;
+use std::io;
+use std::os::fd::OwnedFd;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use codex_utils_path_uri::PathUri;
+use tokio::sync::Semaphore;
+use tokio::sync::SemaphorePermit;
+
+use crate::bootstrap_files_socket::BootstrapPeer;
+use crate::bootstrap_files_socket::CredentialedSocket;
+
+#[path = "bootstrap_files_protocol.rs"]
+mod protocol;
+use protocol::*;
+
+/// Read-only project authority created from a private bootstrap-owned channel.
+///
+/// Keep this object distinct from the runtime's model filesystem. It carries no
+/// managed model context and is never selected by request fields or environment
+/// variables. Disconnecting closes this channel; it does not attest worker cleanup.
+pub struct BootstrapFileSystem {
+    socket: CredentialedSocket,
+    discovery_root: PathUri,
+    session_id: String,
+    next_id: AtomicU64,
+    request_slot: Semaphore,
+    closed: AtomicBool,
+}
+
+impl BootstrapFileSystem {
+    /// Authenticate the actual peer and bind to the existing native session.
+    /// The owner must enable SO_PASSCRED on both endpoints before handing them off.
+    pub async fn connect(
+        descriptor: OwnedFd,
+        peer: BootstrapPeer,
+        expected_session: &str,
+    ) -> io::Result<Arc<Self>> {
+        if expected_session.is_empty() || expected_session.len() > 128 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "invalid bootstrap session identity",
+            ));
+        }
+        let socket = CredentialedSocket::new(descriptor, peer)?;
+        let ready: Ready =
+            serde_json::from_slice(&socket.receive(MAX_PACKET_BYTES).await?).map_err(invalid)?;
+        if ready.kind != "ready"
+            || ready.schema != SCHEMA
+            || ready.session_id != expected_session
+            || ready.chunk_bytes != CHUNK_BYTES
+            || ready.max_data_bytes != MAX_DATA_BYTES
+            || ready.max_packet_bytes != MAX_PACKET_BYTES
+            || ready.operations != ["readFile", "getMetadata", "canonicalize", "readDirectory"]
+        {
+            return Err(invalid(
+                "bootstrap handshake does not match the owned session and protocol",
+            ));
+        }
+        let discovery_root = canonical_uri(&ready.discovery_root)?;
+        Ok(Arc::new(Self {
+            socket,
+            discovery_root,
+            session_id: ready.session_id,
+            next_id: AtomicU64::new(1),
+            request_slot: Semaphore::new(1),
+            closed: AtomicBool::new(false),
+        }))
+    }
+
+    pub fn discovery_root(&self) -> &PathUri {
+        &self.discovery_root
+    }
+    pub fn session_id(&self) -> &str {
+        &self.session_id
+    }
+
+    pub fn disconnect(&self) {
+        self.closed.store(true, Ordering::Release);
+        self.socket.shutdown();
+    }
+
+    async fn request(
+        &self,
+        op: &str,
+        path: &PathUri,
+        follow_symlinks: Option<bool>,
+    ) -> io::Result<(WireResult, Vec<u8>, SemaphorePermit<'_>)> {
+        if !path.starts_with(&self.discovery_root) {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "bootstrap path is outside its discovery root",
+            ));
+        }
+        // The permit serializes wire exchanges; no mutable state guard crosses I/O.
+        let request_slot = self.request_slot.acquire().await.map_err(|_| {
+            io::Error::new(io::ErrorKind::BrokenPipe, "bootstrap channel is closed")
+        })?;
+        if self.closed.load(Ordering::Acquire) {
+            return Err(io::Error::new(
+                io::ErrorKind::BrokenPipe,
+                "bootstrap channel is closed",
+            ));
+        }
+        let mut lease = RequestLease {
+            filesystem: self,
+            complete: false,
+        };
+        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+        if id > (1_u64 << 53) - 1 {
+            return Err(invalid("bootstrap request identifiers exhausted"));
+        }
+        let mut request = serde_json::json!({"id":id,"op":op,"path":path});
+        if let Some(follow) = follow_symlinks {
+            request["followSymlinks"] = follow.into();
+        }
+        let encoded = serde_json::to_vec(&request).map_err(invalid)?;
+        if encoded.len() > MAX_PACKET_BYTES {
+            return Err(invalid("bootstrap request is too large"));
+        }
+        self.socket.send(&encoded).await?;
+        let streamed = matches!(op, "readFile" | "readDirectory");
+        let mut bytes = Vec::new();
+        let mut chunks = 0;
+        loop {
+            let reply: Reply =
+                serde_json::from_slice(&self.socket.receive(MAX_PACKET_BYTES).await?)
+                    .map_err(invalid)?;
+            match reply {
+                Reply::Chunk {
+                    id: received_id,
+                    index,
+                    data_base64,
+                } => {
+                    let chunk = STANDARD.decode(data_base64).map_err(invalid)?;
+                    if !streamed
+                        || received_id != id
+                        || index != chunks
+                        || chunk.is_empty()
+                        || chunk.len() > CHUNK_BYTES
+                        || bytes.len() + chunk.len() > MAX_DATA_BYTES
+                    {
+                        return Err(invalid("invalid bootstrap read chunk"));
+                    }
+                    bytes.extend_from_slice(&chunk);
+                    chunks += 1;
+                }
+                Reply::Result {
+                    id: received_id,
+                    result,
+                } => {
+                    let valid_result = match (&result, op) {
+                        (WireResult::Counters(count), "readFile" | "readDirectory") => {
+                            count.bytes == bytes.len() && count.chunks == chunks
+                        }
+                        (WireResult::Metadata(meta), "getMetadata") => {
+                            meta.is_directory != meta.is_file && !meta.is_symlink
+                        }
+                        (WireResult::Canonical(value), "canonicalize") => {
+                            canonical_uri(&value.path)?.starts_with(&self.discovery_root)
+                        }
+                        _ => false,
+                    };
+                    if received_id != id || !valid_result {
+                        return Err(invalid("invalid bootstrap terminal result"));
+                    }
+                    lease.complete = true;
+                    return Ok((result, bytes, request_slot));
+                }
+                Reply::Error {
+                    id: received_id,
+                    error,
+                } => {
+                    if received_id != id
+                        || chunks != 0
+                        || !matches!(error.code, -32004 | -32000 | -32600 | -32603)
+                    {
+                        return Err(invalid("invalid bootstrap error result"));
+                    }
+                    lease.complete = true;
+                    let kind = match error.code {
+                        -32004 => io::ErrorKind::NotFound,
+                        -32000 | -32600 => io::ErrorKind::PermissionDenied,
+                        -32603 => io::ErrorKind::Other,
+                        _ => unreachable!("validated bootstrap error code"),
+                    };
+                    return Err(io::Error::new(kind, error.message));
+                }
+            }
+        }
+    }
+
+    async fn bytes(&self, path: &PathUri) -> io::Result<Vec<u8>> {
+        self.request("readFile", path, None)
+            .await
+            .map(|(_, bytes, _request_slot)| bytes)
+    }
+
+    async fn directory(&self, path: &PathUri) -> io::Result<Vec<crate::ReadDirectoryEntry>> {
+        // Retain admission until semantic validation completes: another caller
+        // must not use a channel whose directory response may still be invalid.
+        let (_, bytes, _request_slot) = self.request("readDirectory", path, None).await?;
+        let mut lease = RequestLease {
+            filesystem: self,
+            complete: false,
+        };
+        let parsed: Directory = serde_json::from_slice(&bytes).map_err(invalid)?;
+        let mut names = HashSet::new();
+        let entries = parsed
+            .entries
+            .into_iter()
+            .map(|entry| {
+                if entry.file_name.is_empty()
+                    || matches!(entry.file_name.as_str(), "." | "..")
+                    || entry.file_name.contains(['/', '\0'])
+                    || entry.is_directory == entry.is_file
+                    || !names.insert(entry.file_name.clone())
+                {
+                    return Err(invalid("invalid bootstrap directory entry"));
+                }
+                Ok(crate::ReadDirectoryEntry {
+                    file_name: entry.file_name,
+                    is_directory: entry.is_directory,
+                    is_file: entry.is_file,
+                })
+            })
+            .collect::<io::Result<Vec<_>>>()?;
+        lease.complete = true;
+        Ok(entries)
+    }
+}
+
+impl Drop for BootstrapFileSystem {
+    fn drop(&mut self) {
+        self.disconnect();
+    }
+}
+
+struct RequestLease<'a> {
+    filesystem: &'a BootstrapFileSystem,
+    complete: bool,
+}
+impl Drop for RequestLease<'_> {
+    fn drop(&mut self) {
+        if !self.complete {
+            self.filesystem.disconnect();
+        }
+    }
+}
+
+fn invalid(error: impl std::fmt::Display) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, error.to_string())
+}
+
+fn canonical_uri(value: &str) -> io::Result<PathUri> {
+    let path: PathUri = value.parse().map_err(invalid)?;
+    if path.to_string() != value || PathUri::from_abs_path(&path.to_abs_path()?) != path {
+        return Err(invalid("bootstrap returned a noncanonical native file URI"));
+    }
+    Ok(path)
+}
+
