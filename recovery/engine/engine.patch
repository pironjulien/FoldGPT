+    pub async fn get_active_project_with_fs(
+        &self,
+        fs: &dyn codex_file_system::ExecutorFileSystem,
+        resolved_cwd: &Path,
+        repo_root: Option<&Path>,
+    ) -> std::io::Result<Option<ProjectConfig>> {
+        let Some(projects) = self.projects.as_ref() else {
+            return Ok(None);
+        };
+        for path in std::iter::once(resolved_cwd).chain(repo_root) {
+            let native = codex_utils_path_uri::PathUri::from_host_native_path(path)?;
+            let canonical = match fs.canonicalize(&native, /*sandbox*/ None).await {
+                Ok(path) => path.to_abs_path()?.to_path_buf(),
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => path.to_path_buf(),
+                Err(error) => return Err(error),
+            };
+            for key in [canonical.as_path(), path]
+                .map(|path| normalize_project_lookup_key(path.to_string_lossy().into_owned()))
+            {
+                if let Some(project) = project_config_for_lookup_key(projects, &key) {
+                    return Ok(Some(project));
+                }
+            }
+        }
+        Ok(None)
+    }
 }
 
