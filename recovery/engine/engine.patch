+#[tokio::test]
+async fn injected_project_config_public_read_keeps_sources_precedence_and_trust() -> Result<()> {
+    let home = TempDir::new()?;
+    let (project, cwd) = fixture(home.path(), "trusted")?;
+    // The provider refuses the user config file. Only the controller may read it.
+    std::fs::write(
+        home.path().join("deny-read"),
+        PathUri::from_host_native_path(home.path().join("config.toml"))?.to_string(),
+    )?;
+    let (mut child, address) = spawn(home.path(), "injected").await?;
+    let mut client = connect_websocket(address).await?;
+    initialize(&mut client).await?;
+    let response: ConfigReadResponse = serde_json::from_value(
+        rpc(
+            &mut client,
+            2,
+            "config/read",
+            json!({ "cwd": cwd, "includeLayers": true }),
+        )
+        .await?,
+    )?;
+    assert_eq!(response.config.model, Some("child-model".into()));
+    assert_eq!(
+        response.origins.get("model").context("model origin")?.name,
+        ConfigLayerSource::Project {
+            dot_codex_folder: AbsolutePathBuf::from_absolute_path(cwd.join(".codex"))?
+        }
+    );
+    let project_layers: Vec<_> = response
+        .layers
+        .context("layers")?
+        .into_iter()
+        .filter_map(|layer| {
+            if let ConfigLayerSource::Project { dot_codex_folder } = layer.name {
+                Some(dot_codex_folder)
+            } else {
+                None
+            }
+        })
+        .collect();
+    assert_eq!(
+        project_layers,
+        vec![
+            AbsolutePathBuf::from_absolute_path(cwd.join(".codex"))?,
+            AbsolutePathBuf::from_absolute_path(project.join(".codex"))?
+        ]
+    );
+    assert_eq!(
+        std::fs::read_to_string(home.path().join("provider-read"))?,
+        PathUri::from_host_native_path(cwd.join(".codex/config.toml"))?.to_string()
+    );
+    let controller: ConfigReadResponse = serde_json::from_value(
+        rpc(
+            &mut client,
+            3,
+            "config/read",
+            json!({ "includeLayers": true }),
+        )
+        .await?,
+    )?;
+    assert_eq!(controller.config.model, Some("user-model".into()));
+    fixture(home.path(), "untrusted")?;
+    let untrusted: ConfigReadResponse = serde_json::from_value(
+        rpc(
+            &mut client,
+            4,
+            "config/read",
