+//! A real PC process owner to qualify host routing, not Android enforcement.
+use std::io;
+use std::path::PathBuf;
+
+use codex_app_server::HostProcessBackend;
+use codex_app_server::HostProcessCommand;
+use codex_app_server::HostProcessFuture;
+
+pub(super) struct Processes {
+    pub home: PathBuf,
+}
+
+impl HostProcessBackend for Processes {
+    fn spawn(&self, params: HostProcessCommand) -> HostProcessFuture<'_> {
+        Box::pin(async move {
+            let receipt = serde_json::json!({
+                "command": params.command,
+                "cwd": params.cwd,
+                "environment": params.environment,
+                "tty": params.tty,
+                "streamStdin": params.stream_stdin,
+                "size": params.size.map(|size| [size.rows, size.cols]),
+            });
+            std::fs::write(self.home.join("host-process-request.json"), serde_json::to_vec(&receipt)?)?;
+            if params.environment.contains_key("FOLDGPT_TEST_HOST_PROCESS_REFUSAL") {
+                return Err(io::Error::new(io::ErrorKind::PermissionDenied, "native host process owner refused launch"));
+            }
+            let (program, arguments) = params.command.split_first().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "empty host command"))?;
+            let arg0 = None;
+            let result = if params.tty {
+                codex_utils_pty::spawn_pty_process(program, arguments, params.cwd.as_path(), &params.environment,
+                    &arg0, params.size.unwrap_or_default(), &[]).await
+            } else if params.stream_stdin {
+                codex_utils_pty::spawn_pipe_process(program, arguments, params.cwd.as_path(), &params.environment, &arg0, &[]).await
+            } else {
+                codex_utils_pty::spawn_pipe_process_no_stdin(program, arguments, params.cwd.as_path(), &params.environment, &arg0, &[]).await
+            };
+            result.map_err(io::Error::other)
+        })
+    }
+}
