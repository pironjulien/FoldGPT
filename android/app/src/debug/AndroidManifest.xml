<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service android:name="app.foldgpt.install.InactivePreparationProbeService" android:process=":inactiveProbe"
            android:exported="true" android:permission="android.permission.DUMP" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ADB-only inactive guest account, encrypted keyring and real collection recovery check" />
        </service>
        <service android:name="app.foldgpt.install.GuestAccountProbeService" android:process=":accountProbe"
            android:exported="true" android:permission="android.permission.DUMP" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ADB-only inactive Debian account provisioning and actual guest identity check" />
        </service>
        <service android:name="app.foldgpt.install.ProotStorageProbeService" android:process=":storageProbe"
            android:exported="true" android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ADB-only fixed PRoot storage semantics in a disposable fixture" />
        </service>
        <!-- ADB-only diagnostics; absent from release builds. No arbitrary command input. -->
        <receiver android:name="app.foldgpt.LandlockProbeReceiver"
            android:exported="true" android:permission="android.permission.DUMP" />
        <service android:name="app.foldgpt.CodexProbeService" android:process=":offlineProbe"
            android:exported="true" android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ADB-only fixed offline Codex confinement diagnostic" />
        </service>
        <service android:name="app.foldgpt.NativeRunnerProbeService" android:process=":nativeRunnerProbe"
            android:exported="true" android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ADB-only fixed native runner confinement diagnostic" />
        </service>
        <service android:name="app.foldgpt.install.RootfsProbeService" android:process=":rootfsProbe"
            android:exported="true" android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ADB-only fixed inactive Debian extraction diagnostic" />
        </service>
    </application>
</manifest>
