@@ -1706,7 +1706,17 @@ static int
 kgsl_device_get_gpu_timestamp(struct tu_device *dev, uint64_t *ts)
 {
-   UNREACHABLE("");
-   return 0;
+   /* This ioctl reads the same persistent hardware counter as timestamp
+    * queries, without requiring privileged performance-counter access.
