+   struct kgsl_read_calibrated_timestamps req = {
+      .sources = (uintptr_t) &domain,
+      .ts = (uintptr_t) ts,
+      .count = 1,
+   };
+
+   return safe_ioctl(dev->fd, IOCTL_KGSL_READ_CALIBRATED_TIMESTAMPS, &req);
