+/* A new child domain preserves all inherited filesystem/network policy and
+ * puts the immutable PRoot tracer above its guests in Landlock's hierarchy.
+ * The kernel then refuses guest ptrace/process_vm/proc-memory access to the
+ * tracer, while its real parent-to-child tracing remains permitted. Scope-only
+ * rulesets do not add a filesystem layer or change cross-directory REFER.
+ * This is deliberately installed before PTRACE_TRACEME and any guest code. */
+static int restrict_guest_tracer_scope(void)
+{
+	struct { uint64_t fs, net, scoped; } ruleset = { .scoped = 3 };
+	long abi = syscall(SYS_landlock_create_ruleset, NULL, 0, 1U);
+	int fd, status, saved;
+	if (abi < 0)
+		return -1;
+	if (abi < 6) {
+		errno = EOPNOTSUPP;
+		return -1;
+	}
+	fd = syscall(SYS_landlock_create_ruleset, &ruleset, sizeof(ruleset), 0U);
+	if (fd < 0)
+		return -1;
+	status = prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
+	if (status == 0)
+		status = syscall(SYS_landlock_restrict_self, fd, 0U);
+	saved = errno;
+	close(fd);
+	errno = saved;
+	return status;
+}
